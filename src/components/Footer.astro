---
import { mainSitePath, audioPath } from "~/lib/host-routing";
import PersonalName from "~/components/PersonalName.astro";

interface Props {
	variant?: "invitation" | "quiet";
	buttonLabel?: string;
	buttonPath?: string;
	id?: string;
}

const {
	variant = "invitation",
	buttonLabel = "Get in touch",
	buttonPath = "/#contact",
	id,
} = Astro.props;

const host = Astro.isPrerendered
	? Astro.url.host
	: (Astro.request.headers.get("host") ?? Astro.url.host);

const mainHref = (path: string) =>
	Astro.isPrerendered
		? new URL(path, Astro.site).href
		: mainSitePath(host, path);

const audioHref = Astro.isPrerendered
	? new URL("/audio/", Astro.site).href
	: audioPath(host, "/");

const hireHref = mainHref("/services");
const privacyHref = mainHref("/privacy");
const homeHref = mainHref("/");
const year = new Date().getFullYear();
---
{variant === 'invitation' && <div class="pinned-contact" data-pinned-contact hidden><a class="site-button site-button-large" href={mainHref(buttonPath)}>{buttonLabel}</a></div>}
<footer class="compact-footer site-shell">
  <div class:list={['closing-panel', { 'closing-panel--quiet': variant === 'quiet' }]} id={id}>
    {variant === 'quiet' && <a class="footer-name" href={homeHref}><PersonalName variant="full" /></a>}
    {variant === 'invitation' && <a class="site-button site-button-large" href={mainHref(buttonPath)} data-closing-button>{buttonLabel} <span aria-hidden="true">→</span></a>}
    <nav aria-label="Elsewhere"><a href="https://github.com/kwilson21">GitHub</a><a href="https://www.linkedin.com/in/kazonwilson/">LinkedIn</a><a href={audioHref}>Audio</a><a href={hireHref}>Work with me</a><a href="https://ko-fi.com/kazonwilson">Support my work</a><a href={privacyHref}>Privacy</a></nav>
    <p class="closing-legal">The Superhuman Group LLC · {year}</p>
  </div>
</footer>
<script>
  import { setupPinnedContact } from '~/scripts/pinned-contact';

  setupPinnedContact();
</script>
<style>
  /* The side gutter is rem-based, so it doubles with enlarged text and squeezes the closing panel at phone widths. Capped by the viewport it equals the site gutter from 320px up at the default size. */
  .compact-footer { margin-top: var(--site-section-space); padding-inline: min(var(--site-gutter), max(24px, 7.5vw)); padding-bottom: var(--space-8); }
  .closing-panel { display: grid; justify-items: center; text-align: center; padding: 3rem 2rem 2.25rem; background: var(--panel); border-radius: var(--radius-panel); }
  /* Each link gets a 44px-tall tap area from a pseudo-element, so the text and layout keep their look.
     Wrapped rows sit 44px apart (row gap = 44px minus one line), so neighbouring areas never overlap. */
  .compact-footer nav a, .compact-footer .footer-name { position: relative; border: 0; }
  .compact-footer nav a::after, .compact-footer .footer-name::after { content: ''; position: absolute; inset-inline: calc(var(--space-3) * -1); top: 50%; height: 44px; transform: translateY(-50%); }
  /* The same 24px as the header wordmark (SiteNav .site-name). */
  .footer-name { font-size: 1.5rem; letter-spacing: -.03em; color: var(--ink); margin-bottom: 1.6rem; }
  .closing-panel--quiet .footer-name { margin-bottom: 1.25rem; }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: calc(44px - 1lh) var(--space-6); margin-top: 3.25rem; color: var(--muted); font-size: .875rem; }
  .closing-panel--quiet nav { margin-top: 0; }
  /* Accent on the panel is below 4.5:1 for small text, so footer links use muted and ink. */
  .compact-footer nav a { color: var(--muted); }
  @media (hover: hover) and (pointer: fine) { .compact-footer nav a:hover { color: var(--ink); } }
  /* The Get in touch button may wrap its label at any width, so enlarged text reflows inside the panel. */
  .closing-panel .site-button-large { white-space: normal; text-align: center; }
  .closing-legal { margin: 1rem 0 0; color: var(--muted); font-size: .875rem; text-wrap: balance; }
  @media (max-width: 600px) { .closing-panel { border-radius: 28px; padding: 3rem min(1.25rem, 6.25vw) 1.75rem; } }
  .pinned-contact { display: none; }
  @media (max-width: 600px) {
    .pinned-contact:not([hidden]) { display: flex; position: fixed; inset: auto 0 0 0; z-index: 4; padding: var(--space-3) var(--site-gutter) calc(var(--space-4) + env(safe-area-inset-bottom)); background: linear-gradient(to top, color-mix(in srgb, var(--paper) 96%, transparent) 55%, transparent); pointer-events: none; }
    .pinned-contact .site-button { pointer-events: auto; width: 100%; }
    .pinned-contact[data-at-end] { display: none; }
    :global(body:has(.mobile-menu[open])) .pinned-contact { display: none; }
    :global(body:has(main :is(input, textarea, select):focus)) .pinned-contact { display: none; }
    :global(html:has([data-pinned-contact]:not([hidden]))) { scroll-padding-bottom: 5.5rem; }
  }
  @media print { .pinned-contact { display: none !important; } }
</style>
