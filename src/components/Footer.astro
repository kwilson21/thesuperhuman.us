---
import { mainSitePath, audioPath } from '~/lib/host-routing';
import PersonalName from '~/components/PersonalName.astro';
interface Props {
  variant?: 'invitation' | 'quiet';
  heading?: string;
  line?: string;
  buttonLabel?: string;
  buttonPath?: string;
  id?: string;
}
const {
  variant = 'invitation',
  heading = 'Let’s work together.',
  line = 'Every project is fixed price and agreed in writing before work begins.',
  buttonLabel = 'Work with me',
  buttonPath = '/services',
  id,
} = Astro.props;
const host = Astro.isPrerendered ? Astro.url.host : Astro.request.headers.get('host') ?? Astro.url.host;
const mainHref = (path: string) => Astro.isPrerendered ? new URL(path, Astro.site).href : mainSitePath(host, path);
const audioHref = Astro.isPrerendered ? new URL('/audio/', Astro.site).href : audioPath(host, '/');
const hireHref = mainHref('/services');
const privacyHref = mainHref('/privacy');
const homeHref = mainHref('/');
const year = new Date().getFullYear();
---
<footer class="compact-footer site-shell">
  <div class:list={['closing-panel', { 'closing-panel--quiet': variant === 'quiet' }]} id={id}>
    <a class="footer-name" href={homeHref}><PersonalName variant="full" /></a>
    {variant === 'invitation' && <>
      <h2 class="closing-heading">{heading}</h2>
      <p class="closing-line">{line}</p>
      <a class="site-button site-button-large" href={mainHref(buttonPath)}>{buttonLabel} <span aria-hidden="true">→</span></a>
    </>}
    <nav aria-label="Elsewhere"><a href="https://github.com/kwilson21">GitHub</a><a href="https://www.linkedin.com/in/kazonwilson/">LinkedIn</a><a href={audioHref}>Audio</a>{variant === 'quiet' && <a href={hireHref}>Work with me</a>}<a href="https://ko-fi.com/kazonwilson">Support my work</a><a href={privacyHref}>Privacy</a></nav>
    <p class="closing-legal">The Superhuman Group LLC · {year}</p>
  </div>
</footer>
<style>
  .compact-footer { margin-top: var(--site-section-space); padding-bottom: var(--space-8); }
  .closing-panel { display: grid; justify-items: center; text-align: center; padding: 4.5rem 2rem 2.25rem; background: var(--panel); border-radius: var(--radius-panel); }
  .closing-panel--quiet { padding-top: 3rem; }
  /* Each link gets a 44px-tall tap area from a pseudo-element, so the text and layout keep their look.
     Wrapped rows sit 44px apart (row gap = 44px minus one line), so neighbouring areas never overlap. */
  .compact-footer nav a, .compact-footer .footer-name { position: relative; border: 0; }
  .compact-footer nav a::after, .compact-footer .footer-name::after { content: ''; position: absolute; inset-inline: calc(var(--space-3) * -1); top: 50%; height: 44px; transform: translateY(-50%); }
  /* The same 24px as the header wordmark (SiteNav .site-name). */
  .footer-name { font-size: 1.5rem; letter-spacing: -.03em; color: var(--ink); margin-bottom: 1.6rem; }
  .closing-panel--quiet .footer-name { margin-bottom: 1.25rem; }
  .closing-heading { margin: 0 0 .9rem; font-size: clamp(2rem, 3.6vw, 2.9rem); line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
  .closing-line { margin: 0 0 1.9rem; font-size: 1.125rem; color: var(--muted); max-width: 28rem; }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: calc(44px - 1lh) var(--space-6); margin-top: 3.25rem; color: var(--muted); font-size: .875rem; }
  .closing-panel--quiet nav { margin-top: 0; }
  /* Accent on the panel is below 4.5:1 for small text, so footer links use muted and ink. */
  .compact-footer nav a { color: var(--muted); }
  @media (hover: hover) and (pointer: fine) { .compact-footer nav a:hover { color: var(--ink); } }
  .closing-legal { margin: 1rem 0 0; color: var(--muted); font-size: .875rem; }
  @media (max-width: 600px) { .closing-panel { border-radius: 28px; padding: 3rem 1.25rem 1.75rem; } }
</style>
