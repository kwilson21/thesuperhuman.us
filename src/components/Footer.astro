---
import { mainSitePath, audioPath } from '~/lib/host-routing';
import PersonalName from '~/components/PersonalName.astro';
const host = Astro.isPrerendered ? Astro.url.host : Astro.request.headers.get('host') ?? Astro.url.host;
const mainHref = (path: string) => Astro.isPrerendered ? new URL(path, Astro.site).href : mainSitePath(host, path);
const audioHref = Astro.isPrerendered ? new URL('/audio/', Astro.site).href : audioPath(host, '/');
const hireHref = mainHref('/services');
const privacyHref = mainHref('/privacy');
const homeHref = mainHref('/');
const year = new Date().getFullYear();
// Every caller currently passes `compact`; kept accepted (but unused) for one release
// rather than changing every call site in the same pull request.
interface Props { compact?: boolean; }
---
<footer class="compact-footer site-shell">
  <div class="compact-footer-inner">
    <a class="footer-name" href={homeHref}><PersonalName variant="full" /></a>
    <nav aria-label="Elsewhere"><a href="https://github.com/kwilson21">GitHub</a><a href="https://www.linkedin.com/in/kazonwilson/">LinkedIn</a><a href={audioHref}>Audio</a><a href={hireHref}>Work with me</a><a href="https://ko-fi.com/kazonwilson">Support my work</a><a href={privacyHref}>Privacy</a></nav>

    <p>The Superhuman Group LLC · {year}</p>
  </div>
</footer>
<style>
  .compact-footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 2rem 3rem; border-top: 1px solid var(--rule); color: var(--muted); font-size: .9rem; }
  .compact-footer a { border: 0; }
  .footer-name { font-size: 1.25rem; letter-spacing: -.03em; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .compact-footer p { margin: 0; }
  @media (max-width: 600px) { .compact-footer-inner { gap: 1rem; } .compact-footer p { width: 100%; } }
</style>
