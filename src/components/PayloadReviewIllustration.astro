<figure class="demo" data-review-illustration><div class="bar"><strong data-phase>Before: the editor is blocked</strong><span>Drawn editor · Illustrative steps</span></div><div class="stage" data-stage data-step="0"><div class="tab">Recap payload review · Markdown</div><div class="document"><span class="dim">Illustrative review document</span><br><span class="selection">Review the recap information
before choosing to share it.</span><br><span class="dim">Example text; no project data shown.</span></div><div class="veil"><div class="dialog"><strong>Generate this recap?</strong><div>The modal decision blocks interaction with the document behind it.</div><div class="actions" aria-hidden="true"><span class="fake-button">Generate Recap</span><span class="fake-button secondary">Cancel</span></div></div></div><div class="notification"><strong>Nothing has been sent yet.</strong><br>Inspect the document, then decide.<div class="actions" aria-hidden="true"><span class="fake-button">Generate Recap</span><span class="fake-button secondary">Cancel</span></div></div></div><figcaption class="caption" data-caption aria-live="polite">Before the fix, the decision covers the document and blocks editor interaction.</figcaption><div class="controls"><button data-play type="button">Play change</button><button data-next type="button">Next step</button><button data-reset type="button">Reset</button><span data-count>1 / 3</span></div></figure>
<p class="label">Illustration, not a Threadline screenshot. Example document, simplified dialog. Animation timing is illustrative.</p>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-illustration]').forEach(root => {
    const phases = ['Before: the editor is blocked', 'Change: use a nonblocking notification', 'After: inspect, then decide'];
    const captions = ['Before the fix, the decision covers the document and blocks editor interaction.', 'Removing the modal option moves the decision out of the document’s way.', 'The document stays usable. The notification still waits for an explicit decision before sending.'];
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function stop() { clearTimeout(timer); timer = undefined; play.textContent = 'Play change'; }
    function show(n: number) {
      step = n; stage.dataset.step = String(n);
      root.querySelector('[data-phase]')!.textContent = phases[n];
      root.querySelector('[data-caption]')!.textContent = captions[n];
      root.querySelector('[data-count]')!.textContent = `${n + 1} / 3`;
    }
    root.querySelector('[data-next]')!.addEventListener('click', () => { stop(); show((step + 1) % 3); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); show(0); });
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { show((step + 1) % 3); return; }
      show(0); play.textContent = 'Pause';
      function advance() {
        if (!root.isConnected || document.hidden || root.closest<HTMLElement>('[data-panel]')?.hidden) { stop(); return; }
        show(step + 1);
        if (step < 2) timer = setTimeout(advance, 1800); else stop();
      }
      timer = setTimeout(advance, 1800);
    });
  });
</script>

