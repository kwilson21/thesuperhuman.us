<figure class="demo" data-review-illustration><p class="phase" data-phase>Before: the editor is blocked</p><div class="stage" data-stage data-step="0"><div class="document"><span class="dim">Illustrative review document</span><br><span class="selection">Review the recap information
before choosing to share it.</span><br><span class="dim">Example text; no project data shown.</span></div><div class="veil"><div class="card dialog"><strong>Generate this recap?</strong><div>The modal decision blocks interaction with the document behind it.</div><div class="actions" aria-hidden="true"><span class="fake-button">Generate Recap</span><span class="fake-button secondary">Cancel</span></div></div></div><div class="card notification"><strong>Nothing has been sent yet.</strong><br>Inspect the document, then decide.<div class="actions" aria-hidden="true"><span class="fake-button">Generate Recap</span><span class="fake-button secondary">Cancel</span></div></div></div><figcaption class="caption" data-caption aria-live="polite">Before the fix, the decision covers the document and blocks editor interaction.</figcaption><div class="controls"><button data-play type="button">Play change</button><button data-review-next type="button">Next step</button><button data-reset type="button">Reset</button><span data-count>1 / 3</span></div></figure>
<p class="label">Illustration, not a Threadline screenshot. Example document, simplified dialog. Animation timing is illustrative.</p>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-illustration]').forEach(root => {
    const phases = ['Before: the editor is blocked', 'Change: use a nonblocking notification', 'After: inspect, then decide'];
    const captions = ['Before the fix, the decision covers the document and blocks editor interaction.', 'Removing the modal option moves the decision out of the document’s way.', 'The document stays usable. The notification still waits for an explicit decision before sending.'];
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    let step = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function stop() { clearTimeout(timer); timer = undefined; play.textContent = 'Play change'; }
    function show(n: number) {
      step = n; stage.dataset.step = String(n);
      root.querySelector('[data-phase]')!.textContent = phases[n];
      root.querySelector('[data-caption]')!.textContent = captions[n];
      root.querySelector('[data-count]')!.textContent = `${n + 1} / 3`;
    }
    root.querySelector('[data-review-next]')!.addEventListener('click', () => { stop(); show((step + 1) % 3); });
    root.querySelector('[data-reset]')!.addEventListener('click', () => { stop(); show(0); });
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { show((step + 1) % 3); return; }
      show(0); play.textContent = 'Pause';
      function advance() {
        if (!root.isConnected || document.hidden || root.closest<HTMLElement>('[data-panel]')?.hidden) { stop(); return; }
        show(step + 1);
        if (step < 2) timer = setTimeout(advance, 1800); else stop();
      }
      timer = setTimeout(advance, 1800);
    });
  });
</script>

<style>
/* Drawn on paper with the site's tokens, like the Building drawings: no editor chrome, tab or dark theme.
   All text is Libron at 14px or more. The panel edge is a quiet line mixed from the site tokens. */
.demo{--demo-line:color-mix(in srgb,var(--muted) 30%,var(--paper));max-width:640px;margin:22px 0 10px;font:15px/1.55 var(--font-serif);color:var(--ink)}
.phase{margin:0 0 8px;font-size:16px;line-height:1.4}
.stage{position:relative;min-height:270px;padding:16px 14px;border:1px solid var(--demo-line);border-radius:3px;background:var(--paper);overflow:hidden}
.document{font-size:15px;line-height:1.7;white-space:pre-wrap}.document .dim{color:var(--muted)}.document .selection{transition:background .4s var(--ease-site)}.stage[data-step="2"] .selection{background:color-mix(in srgb,var(--accent) 18%,var(--paper))}
.veil{position:absolute;inset:0;display:grid;place-items:center;background:color-mix(in srgb,var(--paper) 74%,transparent);transition:opacity .4s var(--ease-site);pointer-events:none}
.card{background:var(--paper);border:1.5px solid var(--ink);border-radius:3px}
.dialog{max-width:340px;margin:16px;padding:16px 18px;font-size:14px}.dialog strong{font-size:16px;font-weight:700}.dialog > div:not(.actions){color:var(--muted)}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.fake-button{padding:2px 10px;border:1px solid var(--accent);border-radius:2px;background:var(--accent);color:var(--paper);font-size:14px;line-height:1.5}.fake-button.secondary{border-color:var(--field-border);background:transparent;color:var(--ink)}
.notification{position:absolute;bottom:12px;right:12px;left:28%;padding:10px 12px;font-size:14px;opacity:0;transform:translateY(10px);transition:opacity .4s var(--ease-site),transform .4s var(--ease-site)}.notification strong{font-weight:700}.notification .actions{margin-top:8px}
.stage[data-step="1"] .veil,.stage[data-step="2"] .veil{opacity:0}.stage[data-step="1"] .notification,.stage[data-step="2"] .notification{opacity:1;transform:none}
.caption{min-height:72px;margin:0;padding:12px 0;font-size:15px}
.controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.controls button{min-height:44px;padding:8px 12px;border:1px solid var(--field-border);border-radius:3px;background:var(--paper);color:var(--ink);font:15px/1.2 var(--font-serif);white-space:nowrap;cursor:pointer}.controls button:first-child{border-color:var(--accent);background:var(--accent);color:var(--paper)}
.controls span{margin-left:auto;color:var(--muted);font-size:14px;white-space:nowrap}
.label{max-width:640px;font:14px/1.6 var(--font-serif);color:var(--muted)}
button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
@media(hover:hover) and (pointer:fine){.controls button:hover{border-color:var(--accent)}.controls button:first-child:hover{background:var(--ink);border-color:var(--ink)}}
@media(max-width:540px){.stage{min-height:300px}.document{font-size:14px}.notification{left:15px}.dialog{padding:14px}.caption{min-height:96px}.controls{gap:6px}.controls button{padding:8px 9px;font-size:14px}}
/* The longest phase wraps on the smallest phones; reserve its second line so the stage doesn't jump. */
@media(max-width:380px){.phase{min-height:2.8em}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
