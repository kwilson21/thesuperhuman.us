---
interface Props { kind: 'bonus' | 'analyst' }
const { kind } = Astro.props;
---
<figure class="work-diagram">
  {kind === 'bonus' ? <div class="responsibility">
    <div><p><strong>Before</strong> · A handoff to engineering</p><div class="diagram-flow"><span>Support</span><span aria-hidden="true">→</span><span>On-call engineer</span></div></div>
    <div><p><strong>After</strong> · Support can run the work</p><div class="diagram-flow"><span>Support</span><span aria-hidden="true">→</span><span class="self-serve">Self-service</span></div></div>
  </div> : <div class="analyst">
    <p class="diagram-step">Python troubleshooting scripts</p>
    <p class="diagram-connector" aria-hidden="true">↓</p>
    <p class="diagram-step"><strong>Flask application</strong><br /><span>Huey background tasks - MySQL on AWS</span></p>
    <p class="diagram-connector" aria-hidden="true">↓</p>
    <div class="workflow-interfaces">
      <p class="diagram-step"><strong>Google Sheets</strong><br /><span>Automated updates to the shared source of truth</span></p>
      <p class="diagram-step"><strong>Existing React page</strong><br /><span>Extended for data operators to use the tools</span></p>
    </div>
  </div>}
  <figcaption>{kind === 'bonus' ? 'Illustrated change in responsibility' : 'Illustration of the workflow change'}</figcaption>
</figure>
<style>
  .responsibility, .analyst { padding: 1.75rem; background: #f3eee5; border-radius: 3px; }
  .responsibility > div + div { border-top: 1px solid #d9d0c2; margin-top: 1.5rem; padding-top: 1.5rem; }
  .responsibility p { font-size: .9rem; color: var(--muted); }
  .responsibility strong { font-weight: 500; color: var(--ink); }
  .diagram-flow { display: grid; grid-template-columns: 1fr auto 1.2fr; gap: .75rem; align-items: center; margin-top: 1rem; font-size: 1.125rem; }
  .diagram-flow > span:not([aria-hidden]) { border: 1px solid #c5b9a7; border-radius: 3px; min-height: 64px; display: grid; place-items: center; text-align: center; padding: .5rem; }
  .diagram-flow > .self-serve { border-color: var(--accent) !important; color: var(--accent); }
  .diagram-flow [aria-hidden] { color: var(--accent); }
  .diagram-step { border: 1px solid #c5b9a7; border-radius: 3px; padding: .85rem; text-align: center; line-height: 1.45; }
  .diagram-step span { font-size: .85rem; color: var(--muted); }
  .diagram-connector { color: var(--accent); text-align: center; margin-block: .35rem; }
  .workflow-interfaces { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  @media(max-width: 400px) { .workflow-interfaces { grid-template-columns: 1fr; } }
  figcaption { font-size: .75rem; color: var(--muted); margin-top: .65rem; }
  @media(max-width: 400px) { .responsibility, .analyst { padding: 1.1rem; }.diagram-flow { font-size: .95rem; gap: .5rem; } }
</style>
