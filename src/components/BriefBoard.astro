---
// The outline's three lane screens (docs/plans/2026-11-living-brief.md): steps 10 to 12 of the brief, one for each lane, in
// lane order (step 9 was the purpose screen, which the outline no longer has). src/scripts/brief-board.ts fills them, from src/scripts/software-inquiry.ts, which also sets the heading
// and the Add labels for the chosen path; the defaults here are the website's. The component sits inside the brief's form.
import { LANES, LANE_STEPS, addLabels, laneQuestions } from "~/lib/brief-board";
---
{/* Said to screen readers when a card is kept, set aside, brought back, removed or undone. */}
<p class="sr-only" data-board-live role="status"></p>
{LANES.map((lane, index) => (
  <section data-step={LANE_STEPS[index]} data-lane-screen={lane} hidden>
    <h1 tabindex="-1" id={`lane-title-${lane}`} data-lane-title>{laneQuestions.website[lane]}</h1>
    <p class="intake-intro" data-lane-hint></p>
    <p class="board-status" role="status" data-lane-status></p>
    {/* The cards scroll inside this box, so however many arrive the screen never grows and Next stays where it is. */}
    <div class="board-scroll" role="region" tabindex="0" aria-labelledby={`lane-title-${lane}`} data-lane-region hidden>
      <ul class="board-cards" role="list" data-lane-cards></ul>
    </div>
    <button type="button" class="board-add" data-lane-add>{addLabels.website[lane]}</button>
    <div class="board-editor" data-lane-editor hidden>
      <label class="intake-field"><span data-lane-editor-label>{addLabels.website[lane]}</span><input type="text" data-lane-input autocomplete="off" /></label>
      <div class="board-editor-actions"><button type="button" data-lane-save>Add</button><button type="button" data-lane-cancel>Cancel</button></div>
    </div>
    {/* Last after Add, so the reason never moves Add or the open editor the visitor just used. */}
    <p class="board-empty board-full" data-lane-full hidden></p>
    <details class="board-aside" data-lane-aside hidden>
      <summary data-lane-aside-summary>Set aside</summary>
      <ul role="list" data-lane-aside-list></ul>
    </details>
    <div class="board-controls">
      <button type="button" data-board-undo disabled>Undo</button>
      <button type="button" data-board-skip>Skip these, no AI outline</button>
    </div>
  </section>
))}
<template data-card-template>
  <li class="board-card">
    <p class="board-card-origin" data-card-origin></p>
    <p class="board-card-text" data-card-text></p>
    <p class="board-card-quote" data-card-quote hidden></p>
    <p class="board-card-reason" data-card-reason hidden></p>
    <p class="board-card-answer" data-card-answer hidden></p>
    <div class="board-card-actions" data-card-actions></div>
    <div class="board-editor" data-card-editor hidden>
      <label class="intake-field"><span data-card-editor-label></span><input type="text" data-card-input autocomplete="off" /></label>
      <div class="board-editor-actions"><button type="button" data-card-save>Save</button><button type="button" data-card-cancel>Cancel</button></div>
    </div>
  </li>
</template>
