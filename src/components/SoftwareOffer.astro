---
import PersonalName from './PersonalName.astro';
import { formatUSD, offerTotal, paymentSchedules, type ClientOffer } from '~/lib/software-offers';
import '~/styles/global.css';
interface Props { offer?: ClientOffer | null; preview?: boolean }
const { offer, preview = false } = Astro.props;
const terms = offer?.terms;
---
<!doctype html><html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" />
  <title>{terms?.outcome ?? 'Offer unavailable'} · Kazon Wilson</title>
  <link rel="preload" href="/fonts/kazon-name-text.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
</head><body>
  <main class:list={["offer-shell", { dense: terms && JSON.stringify(terms).length > 5000 }]}>
    {preview && <p class="preview-banner">Preview. This is what the client sees.</p>}
    <header class="offer-header"><PersonalName /><span class="page-kicker">Private offer</span></header>
    {offer && terms ? <>
      <div class="offer-intro"><p class="page-kicker">Prepared for {[offer.name, offer.company].filter(Boolean).join(' · ') || 'you'}</p>
        <h1>{terms.outcome}</h1><p class="offer-lead">{terms.summary}</p>
        <p class="offer-meta">Software · {offer.path} · Offer v{offer.version}{offer.version > 1 && ` · replaces v${offer.version - 1}`}</p>
      </div>
      <div class="offer-columns"><div>
        {terms.milestones.map(milestone => <section class="offer-milestone">
          <h2>{milestone.name} <small>{formatUSD(milestone.feeCents)}</small></h2>
          <h3>What you’ll receive</h3><ol>{milestone.deliverables.map(line => <li>{line}</li>)}</ol>
          <h3>How we’ll know it’s ready</h3><ul>{milestone.acceptance.map(line => <li>{line}</li>)}</ul>
        </section>)}
        {[['What I’ll need from you', terms.clientInputs], ['Outside this offer', terms.exclusions], ['Timing', terms.timing]].filter(([, content]) => content).map(([heading, content]) => <section><h2>{heading}</h2><p class="offer-lines">{content}</p></section>)}
      </div><aside>
        <section><h2 class="fee-heading">Fixed project fee</h2><p class="offer-total">{formatUSD(offerTotal(terms))}</p>
          <dl>{terms.milestones.map(milestone => <div><dt>{milestone.name}</dt><dd>{formatUSD(milestone.feeCents)}</dd></div>)}</dl>
          <h3>{terms.paymentMode === 'standard' ? 'Standard' : 'Invoice terms'}</h3><p>{paymentSchedules[terms.paymentMode]}</p>
          {terms.milestones.filter(milestone => milestone.checkpoint).map(milestone => <p>{milestone.name}: if stopped after {milestone.checkpoint!.label}, {milestone.checkpoint!.cancellationPercent}% of this milestone is due.</p>)}
          {terms.projectRange && <p>If the project continues: roughly {formatUSD(terms.projectRange.lowCents)} to {formatUSD(terms.projectRange.highCents)} overall. An estimate, not a quote.</p>}
        </section>
        <section><h2>Where things stand</h2><ul class="offer-status"><li>Agreement · Not sent yet</li><li>Invoice · Not issued</li><li>Start date · Not confirmed</li></ul>
          <a href={`mailto:kazon.wilson@thesuperhuman.us?subject=${encodeURIComponent(`Question about offer v${offer.version}`)}`}>Ask a question</a>
          <button class="site-button" type="button" data-print-offer>Print or save</button>
        </section>
      </aside></div>
      <section class="offer-beginning"><h2>A clear beginning.</h2><ol>
        <li><h3>Review and sign</h3><p>Confirm the scope and terms.</p></li>
        <li><h3>{terms.paymentMode === 'standard' ? 'Initial invoice' : 'First invoice'}</h3><p>{terms.paymentMode === 'standard' ? 'Pay the agreed first installment.' : 'Due within 30 days.'}</p></li>
        <li><h3>Confirm the start</h3><p>We agree when work begins.</p></li>
      </ol></section>
      <footer>Kazon Wilson · The Superhuman Group LLC <a href="/privacy">Privacy</a></footer>
    </> : <section class="offer-unavailable"><h1>This offer isn’t available.</h1><p>Ask Kazon for a current link: <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>.</p></section>}
  </main>
  <script>document.querySelector('[data-print-offer]')?.addEventListener('click', () => window.print());</script>
</body></html>
<style>
  .offer-shell { max-width: 72rem; margin: auto; padding: 2rem clamp(1rem, 5vw, 3rem); color: var(--ink); overflow-wrap: anywhere; }
  .offer-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 1.5rem; }
  .offer-intro { padding: 2.5rem 0 1.5rem; }
  h1,h2,h3,.offer-total,.offer-lead { font-family: Newsreader, Georgia, serif; font-weight: 400; }
  h1 { font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1.05; margin: 1rem 0; }
  h2 { font-size: 2rem; line-height: 1.2; margin-bottom: .7rem; }
  h3 { font-size: 1.35rem; margin: 1rem 0 .5rem; }
  p,li,dt,dd { font-size: .95rem; line-height: 1.6; }
  p { margin: .6rem 0; }
  .offer-lead { font-size: 1.6rem; line-height: 1.3; }
  .offer-meta { color: var(--muted); }
  .offer-columns { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 2.5rem; }
  .offer-columns aside { padding-left: 2rem; border-left: 1px solid var(--rule); }
  section { margin-bottom: 1.7rem; }
  .offer-milestone { padding-bottom: 1rem; border-bottom: 1px solid var(--rule); }
  h2 small { display: block; color: var(--muted); font-size: 1rem; }
  ol,ul { padding-left: 1.5rem; }
  li { padding-left: .2rem; margin-bottom: .4rem; }
  ol li::marker { color: var(--accent); }
  .offer-lines { white-space: pre-line; }
  .offer-total { font-size: 3.7rem; line-height: 1; margin: 1rem 0 1.5rem; }
  .fee-heading { font-size: 1.4rem; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--rule); padding: .7rem 0; }
  dd { margin: 0; white-space: nowrap; }
  .offer-status { list-style: none; padding: 0; color: var(--muted); }
  a { color: var(--accent); text-decoration: underline; }
  button { display: block; margin-top: 1rem; background: none; border: 1px solid var(--rule); color: var(--ink); padding: .6rem 1rem; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .offer-beginning { border-top: 1px solid var(--rule); padding-top: 1rem; }
  .offer-beginning ol { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2rem; }
  footer { border-top: 1px solid var(--rule); padding-top: 1rem; color: var(--muted); font-size: .8rem; }
  footer a { float: right; }
  .preview-banner { border-bottom: 1px solid var(--rule); padding-bottom: 1rem; font-weight: 500; }
  .offer-unavailable { margin-top: 3rem; }
  @media(max-width:700px) { .offer-columns,.offer-beginning ol { grid-template-columns: 1fr; gap: 1rem; } .offer-columns aside { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); padding-top: 1.5rem; } .offer-beginning ol { gap: .5rem; } }
  @media print { @page { size: Letter; margin: .5in; } .offer-shell { padding: 0; max-width: none; } .preview-banner,button,a { display: none; } .offer-columns { grid-template-columns: minmax(0,1.8fr) minmax(0,1fr); gap: 1rem; } .offer-columns aside { border-left: 1px solid var(--rule); border-top: 0; padding: 0 0 0 1rem; } .offer-intro { padding: 1rem 0; } h1 { font-size: 26pt; } h2 { font-size: 17pt; } h3 { font-size: 12pt; } p,li,dt,dd { font-size: 9pt; line-height: 1.3; } section { margin-bottom: .8rem; } .offer-total { font-size: 30pt; } .offer-beginning ol { grid-template-columns: repeat(3,1fr); } li { break-inside: avoid; } .dense p,.dense li,.dense dt,.dense dd { font-size: 7pt; line-height: 1.2; } .dense h2 { font-size: 14pt; } .dense h3 { font-size: 10pt; margin-top: .5rem; } .dense section { margin-bottom: .5rem; } }
</style>
