---
import ProjectTimeline from './ProjectTimeline.astro';
import { journalMilestones, type Milestone } from '~/lib/project-story';
import type { ProjectFeed } from '~/lib/publication/read';
interface Props { feed: ProjectFeed | null; projectId: string; title?: string; milestones?: Milestone[]; selectedId?: string; }
const { feed, projectId, title = 'Development journal', milestones = [], selectedId } = Astro.props;
---
<div data-project-updates data-project={projectId} data-snapshot={JSON.stringify(feed)}>
  {!feed && milestones.length > 0 && <p class="update-notice">Recent updates are temporarily unavailable. Earlier milestones are shown below.</p>}
  <p class="update-notice" data-notice aria-live="polite" hidden><span></span> <a href={Astro.url.pathname}>Load latest updates</a></p>
  <div data-update-content><ProjectTimeline selectedId={feed?.current?.entryId ?? selectedId} id={`${projectId}-updates`} title={title} entries={journalMilestones(feed, milestones)} unavailable={!feed} /></div>
  {milestones.length > 0 && <template data-curated-fallback><ProjectTimeline id={`${projectId}-updates`} title={title} entries={milestones} /></template>}
</div>
<script>
  import { feedChange } from '~/lib/project-story';
  import type { ProjectFeed } from '~/lib/publication/read';
  document.querySelectorAll<HTMLElement>('[data-project-updates]').forEach(root => {
    let previous = JSON.parse(root.dataset.snapshot || 'null') as ProjectFeed | null;
    let cleared = false;
    const notice = root.querySelector<HTMLElement>('[data-notice]')!;
    function clearPublished() {
      if (cleared) return;
      const content = root.querySelector('[data-update-content]')!;
      const curated = root.querySelector<HTMLTemplateElement>('[data-curated-fallback]');
      // The fallback is an expanded, script-free reading view of repository-owned work.
      content.replaceChildren(...(curated ? [curated.content.cloneNode(true)] : []));
      delete root.dataset.snapshot; cleared = true;
    }
    async function poll() {
      try {
        const response = await fetch(`/api/work-feed?project=${encodeURIComponent(root.dataset.project!)}`, { cache: 'no-store', signal: AbortSignal.timeout(10000) });
        if (response.status === 404) { clearPublished(); previous = null; notice.hidden = false; notice.querySelector('span')!.textContent = 'This project’s published updates have been removed.'; return; }
        if (!response.ok) throw new Error('Feed unavailable');
        const next = await response.json() as ProjectFeed;
        if(next.projectId !== root.dataset.project || !Array.isArray(next.history) || !Number.isSafeInteger(next.revision)) return;
        const change = previous ? feedChange(previous,next) : 'new';
        if(change === 'replace') { clearPublished(); }
        if(change === 'new' || change === 'replace') { notice.hidden = false; notice.querySelector('span')!.textContent = change === 'replace' ? 'Published work has been corrected or withdrawn. The earlier version has been cleared.' : 'New project updates are ready when you are.'; }
      } catch { notice.hidden = false; notice.querySelector('span')!.textContent = cleared || !previous ? 'Live updates are temporarily unavailable.' : 'Live updates are unavailable. Showing the last loaded version.'; }
      finally { setTimeout(poll,15000); }
    }
    setTimeout(poll,15000);
  });
</script>
<style>.update-notice { padding: 16px; border: 1px solid var(--rule); font-size: 14px; line-height: 1.6; } .update-notice[hidden] { display: none; } a { color: var(--accent); }</style>
