---
interface Props { title: string; description: string; steps: { label: string; visual: string; caption: string }[]; }
const { title, description, steps } = Astro.props;
---
<section class="story-flow" data-story-flow>
  <p class="kind">Intended experience · illustration</p><h2>{title}</h2><p class="description">{description}</p>
  <ol>{steps.map((step, i) => <li data-flow-step><span class="number">0{i + 1}</span><div class="visual" aria-hidden="true">{step.visual}</div><h3>{step.label}</h3><p>{step.caption}</p></li>)}</ol>
  <div class="flow-controls" hidden><button type="button" data-play>Play the flow</button><button type="button" data-step>Next step →</button><span aria-live="polite" data-flow-status></span></div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-story-flow]').forEach(root => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-flow-step]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    let index = -1; let timer: ReturnType<typeof setTimeout> | undefined;
    const stop = () => { clearTimeout(timer); timer = undefined; play.textContent = index === steps.length - 1 ? 'Replay' : 'Play the flow'; };
    const show = () => { steps.forEach((step,i) => step.classList.toggle('active',i === index)); root.querySelector('[data-flow-status]')!.textContent = `Step ${index + 1} of ${steps.length}: ${steps[index].querySelector('h3')!.textContent}`; };
    const advance = () => { index++; show(); if(index < steps.length - 1) timer = setTimeout(advance,2000); else stop(); };
    play.addEventListener('click', () => { if(timer) return stop(); if(index >= steps.length - 1) index = -1; if(matchMedia('(prefers-reduced-motion: reduce)').matches) { index++; show(); stop(); return; } play.textContent = 'Pause'; advance(); });
    root.querySelector('[data-step]')!.addEventListener('click', () => { stop(); index = (index + 1) % steps.length; show(); });
    root.querySelector<HTMLElement>('.flow-controls')!.hidden = false;
    document.addEventListener('visibilitychange', () => { if(document.hidden) stop(); });
  });
</script>
<style>
  .story-flow { padding: 38px 0; margin: 32px 0; border-block: 1px solid var(--rule); } .kind { font-size: 12px; color: var(--muted); margin-bottom: 12px; } h2 { font-size: clamp(30px,4vw,42px); } .description { max-width: 65ch; line-height: 1.6; margin-top: 12px; } ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; margin: 30px 0; } li { border-top: 2px solid var(--rule); padding: 20px 0 10px; transition: border-color .3s,background .3s; } li.active { border-color: var(--accent); background: #f3ece1; } .number { font-size: 12px; color: var(--muted); } .visual { white-space: nowrap; font: 24px/1.5 'JetBrains Mono',monospace; color: var(--accent); height: 76px; display: flex; align-items: center; } h3 { font-size: 25px; } li p { font-size: 14px; line-height: 1.6; color: var(--muted); margin-top: 10px; max-width: 30ch; } .flow-controls { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; font-size: 12px; } .flow-controls[hidden] { display: none; } button { background: transparent; border: 1px solid var(--rule); border-radius: 4px; padding: 9px 14px; cursor: pointer; } button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; } @media(max-width:600px) { ol { grid-template-columns: 1fr; gap: 12px; } li { display: grid; grid-template-columns: 80px 1fr; column-gap: 15px; } .number { grid-column: 1/-1; } .visual { grid-row: span 2; font-size: 14px; } li p { max-width: none; } } @media(prefers-reduced-motion:reduce) { li { transition: none; } }
</style>
