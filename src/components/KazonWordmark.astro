---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<img class:list={['kazon-wordmark', className]} src="/kazon-wordmark.svg" alt="Kazon" width="720" height="200" decoding="async" />

<style>
  .kazon-wordmark {
    display: inline-block;
    height: var(--wordmark-height, 1em);
    width: auto;
  }
</style>
