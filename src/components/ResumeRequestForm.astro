---
const turnstileSiteKey = Astro.locals.runtime.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<form id="resume-request-form" class="site-form" data-available={Boolean(turnstileSiteKey)} novalidate>
  <noscript>
    <p class="text-sm" style="color: var(--accent);">
      This form requires JavaScript. Email
      <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>
      directly to request a copy.
    </p>
  </noscript>

  <input type="hidden" name="audience" value="general" />

  <div class="form-pair">
    <div>
      <label for="rr-name">Name</label>
      <input id="rr-name" name="name" autocomplete="name" type="text" required maxlength="100" />
      <p hidden data-form-error="name"></p>
    </div>
    <div>
      <label for="rr-email">Email</label>
      <input id="rr-email" name="email" autocomplete="email" type="email" required maxlength="120" />
      <p hidden data-form-error="email"></p>
    </div>
  </div>

  <div>
    <label for="rr-company">Company <span>(optional)</span></label>
    <input id="rr-company" name="company" autocomplete="organization" type="text" maxlength="120" /><p hidden data-form-error="company"></p>
  </div>

  <div>
    <label for="rr-note">A short note <span>(optional)</span></label>
    <textarea id="rr-note" name="note" maxlength="1000" rows="3" placeholder="What kind of role or project? (Helps me prioritize.)"></textarea><p hidden data-form-error="note"></p>
  </div>

  {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="text-sm text-muted">The form is unavailable right now. <a href="mailto:kazon.wilson@thesuperhuman.us?subject=Resume%20request">Email me instead.</a></p>}

  <div>
    <button type="submit" disabled class="site-button">Request resume</button>
    <p id="rr-status" data-form-status role="status" tabindex="-1"></p>
  </div>

  <p class="text-xs text-muted">
    My resume includes personal contact details. Each request needs my approval before delivery.
    {turnstileSiteKey && <span> You can also <a href="mailto:kazon.wilson@thesuperhuman.us?subject=Resume%20request">request it by email</a>.</span>}
  </p>
<p class="form-hint">Read how your information is handled in the <a href="https://thesuperhuman.us/privacy">privacy notice</a>.</p>
</form>

<div id="resume-request-success" class="form-success" tabindex="-1" role="status" hidden>
  <p class="lede">Request received.</p>
  <p class="text-base text-muted mt-3 max-w-measure">
    I’ll review your request. If approved, the resume will arrive by email.
  </p>
</div>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}

<script>
  import { setupFormSubmission } from '~/scripts/form-submission';
  const form = document.getElementById('resume-request-form') as HTMLFormElement;
  setupFormSubmission({ form, endpoint: '/api/resume-request', success: document.getElementById('resume-request-success')!, payload: data => ({
    name: String(data.get('name') ?? ''), email: String(data.get('email') ?? ''), company: String(data.get('company') ?? ''), audience: 'general', note: String(data.get('note') ?? ''),
  }) });
</script>
