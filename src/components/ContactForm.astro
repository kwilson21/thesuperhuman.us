---
const turnstileSiteKey = Astro.locals.runtime.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<form id="contact-form" class="site-form" data-available={Boolean(turnstileSiteKey)} novalidate>
  <p class="form-hint">All fields required unless marked optional.</p>
  <noscript><p>This form requires JavaScript. Please use the email link below.</p></noscript>
  <div class="form-pair">
    <div><label for="cf-name">Name</label><input id="cf-name" name="name" autocomplete="name" required maxlength="100" /><p data-form-error="name" hidden></p></div>
    <div><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="120" /><p data-form-error="email" hidden></p></div>
  </div>
  <div><label for="cf-company">Company <span>(optional)</span></label><input id="cf-company" name="company" autocomplete="organization" maxlength="120" /><p data-form-error="company" hidden></p></div>
  <div><label for="cf-description">Your message</label><textarea id="cf-description" name="description" required maxlength="4000" rows="6" placeholder="What would you like to talk about?"></textarea><p data-form-error="description" hidden></p></div>
  {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-hint">The form is unavailable right now. You can email me below.</p>}
  <p data-form-error="turnstileToken" hidden></p>
  <div><button type="submit" disabled class="site-button">Send message</button><p id="cf-status" data-form-status role="status" tabindex="-1"></p></div>
  <p class="form-hint">Prefer email? <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a></p>
  <p class="form-hint">Looking for my resume? <a href="/about#resumes">Request a copy.</a></p>
</form>
<div id="contact-success" class="form-success" role="status" tabindex="-1" hidden><h3>Message received.</h3><p>Thanks for getting in touch.</p></div>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
<script>
  import { setupFormSubmission } from '~/scripts/form-submission';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  setupFormSubmission({ form, endpoint: '/api/contact', success: document.getElementById('contact-success')!, payload: data => ({
    name: String(data.get('name') ?? ''), email: String(data.get('email') ?? ''), company: String(data.get('company') ?? ''), description: String(data.get('description') ?? ''),
  }) });
</script>
