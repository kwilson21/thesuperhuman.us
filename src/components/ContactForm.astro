---
const turnstileSiteKey =
	Astro.locals.runtime.env.PUBLIC_TURNSTILE_SITE_KEY ??
	import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ??
	"";
---
<form id="contact-form" class="site-form" data-available={Boolean(turnstileSiteKey)} novalidate>
  <p class="form-hint">All fields required unless marked optional.</p>
  <noscript><p>This form requires JavaScript. Please use the email link below.</p></noscript>
  <div class="form-pair">
    <div><label for="cf-name">Name</label><input id="cf-name" name="name" autocomplete="name" required maxlength="100" /><p data-form-error="name" hidden></p></div>
    <div><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="120" /><p data-form-error="email" hidden></p></div>
  </div>
  <div><label for="cf-company">Company <span>(optional)</span></label><input id="cf-company" name="company" autocomplete="organization" maxlength="120" /><p data-form-error="company" hidden></p></div>
  <div><label for="cf-description">Your message</label><textarea id="cf-description" name="description" required maxlength="4000" rows="6" placeholder="What would you like to talk about?"></textarea><p data-form-error="description" hidden></p></div>
  {turnstileSiteKey ? <div data-contact-turnstile data-sitekey={turnstileSiteKey}></div> : <p class="form-hint">The form is unavailable right now. You can email me below.</p>}
  <p data-form-error="turnstileToken" hidden></p>
  <div><button type="submit" disabled class="site-button">Send message</button><p id="cf-status" data-form-status role="status" tabindex="-1"></p></div>
  <p class="form-hint">Prefer email? <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a></p>
  <p class="form-hint">Looking for my resume? <a href="/about#resumes">Request a copy.</a></p>
<p class="form-hint">Read how your information is handled in the <a href="https://thesuperhuman.us/privacy">privacy notice</a>.</p>
</form>
<div id="contact-hold" class="form-hold" role="group" aria-labelledby="contact-hold-title" aria-describedby="contact-hold-count contact-hold-about" tabindex="-1" hidden>
  <h3 id="contact-hold-title">Check it before it sends.</h3>
  <p id="contact-hold-count" class="contact-hold-count" role="timer" tabindex="-1" data-hold-count>Sending in 15 seconds.</p>
  <p id="contact-hold-about" class="mt-3 max-w-measure wrap-anywhere">I’ll reply to <span data-hold-email></span>. If anything needs fixing, undo and edit it. Leaving or switching away from this page sends it right away.</p>
  <div class="mt-4 flex flex-wrap gap-3"><button type="button" class="site-button" data-hold-undo>Undo and edit</button><button type="button" class="site-button site-button-outline" data-hold-send>Send now</button></div>
  <p class="text-sm text-muted mt-6">From</p>
  <p class="mt-1 max-w-measure wrap-anywhere" data-hold-from></p>
  <p class="text-sm text-muted mt-4">Your message</p>
  <p class="mt-1 max-w-measure whitespace-pre-wrap wrap-anywhere" data-hold-message></p>
</div>
<div id="contact-success" class="form-success" role="status" tabindex="-1" hidden>
  <h3>Message received.</h3>
  <p class="max-w-measure wrap-anywhere" data-contact-reply>Thanks for getting in touch. I’ll read it myself and reply by email.</p>
  <p class="text-sm text-muted mt-3 max-w-measure">A short confirmation email should arrive soon. If it doesn’t, check your spam folder. Your message reached me either way.</p>
</div>
<script>
  import { setupContactForm } from '~/scripts/contact-form';

  setupContactForm();
</script>
