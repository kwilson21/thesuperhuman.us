  .capacity-label small { font-size: .6875rem; font-weight: 400; color: var(--muted); }
  .capacity-track { height: .75rem; margin-top: .375rem; background: var(--rule); }
  .capacity-bar { display: block; height: 100%; }
  .before-bar { width: 5%; background: var(--ink); }
  .after-bar { width: 100%; background: var(--accent); }
  .scale-note, .evidence-note { color: var(--muted); font-family: 'Inter', system-ui, sans-serif; font-size: .6875rem; line-height: 1.65; }
  .scale-note { margin-top: .75rem; }
  .workflow-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .75rem; margin-bottom: 1rem; }
  .workflow-controls { display: flex; border: 1px solid var(--rule); border-radius: 4px; padding: 3px; }
  .workflow-controls[hidden], [data-workflow-panel][hidden] { display: none; }
  button { padding: .5rem .875rem; min-height: 44px; font-family: 'Inter', system-ui, sans-serif; font-size: .75rem; cursor: pointer; border-radius: 2px; }
  button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  button:hover { text-decoration: underline; text-underline-offset: 3px; }
  .workflows figure + figure { margin-top: 1.25rem; }
  .lyft-story[data-ready] .workflows figure { margin-top: 0; }
  .workflows figcaption { font-size: 1.125rem; margin-bottom: .75rem; }
  .workflow-path { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; }
  .workflow-path li { position: relative; padding: .75rem 1rem .75rem 0; border-top: 2px solid var(--rule); font-family: 'Inter', system-ui, sans-serif; font-size: .6875rem; line-height: 1.5; }
  .workflow-path li + li { padding-left: .75rem; }
  .workflow-path li + li::before { content: '→'; position: absolute; left: -.5rem; top: -1rem; background: var(--paper); color: var(--accent); font-size: 1.125rem; }
  .step-label { display: block; font-weight: 600; margin-bottom: .25rem; font-size: .75rem; }
  .evidence-note { border-top: 1px solid var(--rule); padding-top: 1rem; margin-top: 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .lyft-story[data-ready] .workflow-path li { animation: reveal-step .3s ease-out both; }
    .lyft-story[data-ready] .workflow-path li:nth-child(2) { animation-delay: .12s; }
    .lyft-story[data-ready] .workflow-path li:nth-child(3) { animation-delay: .24s; }
    @keyframes reveal-step { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  }
  @media (max-width: 420px) {
    .capacity-label small { display: block; text-align: right; }
    .workflow-path { grid-template-columns: 1fr; }
    .workflow-path li, .workflow-path li + li { border-top: none; border-left: 2px solid var(--rule); padding: .5rem 0 .75rem 1rem; }
    .workflow-path li + li::before { content: '↓'; top: -.5rem; left: -.45rem; }
  }
</style>
