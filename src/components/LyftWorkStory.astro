<section class="lyft-story" aria-labelledby="lyft-bonus-title" data-lyft-story>
  <p class="eyebrow">A closer look · Bulk bonus refactor</p>
  <h4 id="lyft-bonus-title">More rows. More independence for support.</h4>
  <p class="intro">I refactored the tool used to issue driver bonuses and added Grafana observability so support could monitor and self-serve runs.</p>

  <figure class="capacity" aria-labelledby="lyft-capacity-caption">
    <figcaption id="lyft-capacity-caption" class="eyebrow">Rows handled per batch</figcaption>
    <div class="capacity-row">
      <div class="capacity-label"><span>Before</span><strong>5,000 <small>row limit</small></strong></div>
      <div class="capacity-track" aria-hidden="true"><span class="capacity-bar before-bar"></span></div>
    </div>
    <div class="capacity-row">
      <div class="capacity-label"><span>After</span><strong>100,000+ <small>rows handled</small></strong></div>
      <div class="capacity-track" aria-hidden="true"><span class="capacity-bar after-bar"></span></div>
    </div>
    <p class="scale-note">Same scale; the after bar shows the 100,000-row lower bound.</p>
  </figure>

  <div class="workflow-heading">
    <p class="eyebrow" id="lyft-workflow-label">Who can run the work?</p>
    <div class="workflow-controls" role="group" aria-labelledby="lyft-workflow-label" hidden>
      <button type="button" data-workflow="before" aria-pressed="false" aria-controls="lyft-workflow-before">Before</button>
      <button type="button" data-workflow="after" aria-pressed="true" aria-controls="lyft-workflow-after">After</button>
    </div>
  </div>
  <div class="workflows" aria-live="polite">
    <figure id="lyft-workflow-before" data-workflow-panel="before">
      <figcaption>Before · Runs escalated to engineering</figcaption>
      <ol class="workflow-path">
        <li><span class="step-label">Support</span><span>Needs a bonus run</span></li>
        <li><span class="step-label">Escalation</span><span>Hands off to on-call</span></li>
        <li><span class="step-label">On-call engineer</span><span>Handles the run</span></li>
      </ol>
    </figure>
    <figure id="lyft-workflow-after" data-workflow-panel="after">
      <figcaption>After · Support can self-serve</figcaption>
      <ol class="workflow-path">
        <li><span class="step-label">Support</span><span>Starts a bonus run</span></li>
        <li><span class="step-label">Grafana visibility</span><span>Support monitors the run</span></li>
        <li><span class="step-label">Self-service</span><span>No on-call handoff needed</span></li>
      </ol>
    </figure>
  </div>
  <p class="evidence-note">Illustrations based on my <a href="/about#lyft--software-engineer">career account</a>. Capacity figures are owner-reported, not newly benchmarked. The workflow shows the change in responsibility, not elapsed time.</p>
</section>

<script>
  function initLyftStories() {
    document.querySelectorAll<HTMLElement>('[data-lyft-story]').forEach((story) => {
      if (story.dataset.ready) return;
      const controls = story.querySelector<HTMLElement>('.workflow-controls');
      const buttons = story.querySelectorAll<HTMLButtonElement>('[data-workflow]');
      const panels = story.querySelectorAll<HTMLElement>('[data-workflow-panel]');
      if (!controls) return;
      const select = (state: string) => {
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.workflow === state)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.workflowPanel !== state; });
      };
      buttons.forEach((button) => button.addEventListener('click', () => select(button.dataset.workflow!)));
      select('after');
      controls.hidden = false;
      story.dataset.ready = 'true';
    });
  }
  initLyftStories();
  document.addEventListener('astro:page-load', initLyftStories);
</script>

<style>
