---
// Drawn over studio-v1.webp in the image's own pixel coordinates (1536 × 1024), so it
// stays registered at every size. Three short scenes, one per part of the tagline:
// the monitor re-types its last lines of code, the headphones give off a few rings of
// sound, and a path is sketched on the notebook. The sketch is part of the resting
// frame; the typing masks and rings only exist while a scene plays (home-worlds.ts adds
// `is-playing`), so reduced motion and no-JS show the untouched artwork plus the sketch.

// The last four code rows on the monitor, measured on the artwork: where each row
// starts, its centre line, how far it runs, and when its typing begins (seconds).
const rows = [
  { x: 908, y: 385, run: 84, at: 0.9, steps: 9 },
  { x: 908, y: 397.5, run: 134, at: 1.5, steps: 13 },
  { x: 899, y: 426.5, run: 40, at: 2.35, steps: 4 },
  { x: 893, y: 438.5, run: 82, at: 2.75, steps: 8 },
];
// The screen recedes to the right; its rows slope down by about this much per pixel.
const slope = 0.105;
---
<svg class="studio-life" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g class="life-typing" transform={`matrix(1 ${slope} 0 1 0 ${-slope * 900})`}>
    {rows.map(row => {
      const top = row.y + slope * 900 - slope * row.x - 5.5;
      return (
        <g class="type-row" style={`--at:${row.at}s;--run:${row.run + 8}px;--steps:${row.steps}`}>
          <rect x={row.x - 3} y={top} width={row.run + 14} height="11" />
          <rect class="caret" x={row.x - 3} y={top + 1.5} width="1.6" height="8" />
        </g>
      );
    })}
  </g>
  <g class="life-sound" transform="translate(1230 735)">
    <ellipse rx="96" ry="84" style="--at:1s" />
    <ellipse rx="96" ry="84" style="--at:1.55s" />
    <ellipse rx="96" ry="84" style="--at:2.1s" />
  </g>
  <g class="life-sketch" transform="matrix(2.2 -0.88 2.75 0.95 815 840)">
    <path class="sketch-path" pathLength="1" d="M18 55 C 25 50, 22 44, 30 41 S 43 43, 48 36 S 55 27, 64 28 S 76 25, 80 17" vector-effect="non-scaling-stroke" />
    <ellipse class="sketch-sun" cx="84" cy="36" rx="4.6" ry="4.6" />
  </g>
</svg>
<style>
  .studio-life { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  /* Resting frame: nothing covers the code, no rings, the sketch drawn. */
  .type-row, .life-sound ellipse { display: none; }
  .type-row rect { fill: #1d1f20; }
  .type-row .caret { fill: #d8d2c6; }
  .life-sound ellipse { fill: none; stroke: var(--accent); stroke-width: 2.4; vector-effect: non-scaling-stroke; }
  .life-sketch path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .sketch-path { stroke: var(--accent); stroke-width: 1.8; }
  .sketch-sun { fill: var(--accent); fill-opacity: .85; stroke: none; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.is-playing) .type-row { display: inline; animation: type-row calc(var(--steps) * 70ms) steps(var(--steps), end) var(--at) both; }
    :global(.is-playing) .type-row .caret { animation: caret-off 1ms linear both; animation-delay: calc(var(--at) + var(--steps) * 70ms); }
    /* The last row keeps its caret a moment and blinks twice before the scene rests. */
    :global(.is-playing) .type-row:last-child .caret { animation: caret-blink 1.2s steps(1, end) both; animation-delay: calc(var(--at) + var(--steps) * 70ms); }
    :global(.is-playing) .life-sound ellipse { display: inline; transform-box: fill-box; transform-origin: center; animation: sound-ring 2.2s cubic-bezier(.2, .6, .3, 1) var(--at) both; }
    :global(.is-playing) .sketch-path { animation: sketch-draw 1.8s cubic-bezier(.45, .05, .3, 1) 1.5s both; }
    :global(.is-playing) .sketch-sun { transform-box: fill-box; transform-origin: center; animation: sketch-sun .7s cubic-bezier(.3, 1.5, .5, 1) 3.3s both; }
  }
  @keyframes type-row { from { transform: translateX(0); } to { transform: translateX(var(--run)); } }
  @keyframes caret-off { to { opacity: 0; } }
  @keyframes caret-blink { 0%, 50% { opacity: 1; } 25%, 75%, 100% { opacity: 0; } }
  @keyframes sound-ring {
    from { transform: scale(1); opacity: .55; }
    to { transform: scale(1.75); opacity: 0; }
  }
  @keyframes sketch-draw { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @keyframes sketch-sun { from { transform: scale(0); } to { transform: scale(1); } }
</style>
