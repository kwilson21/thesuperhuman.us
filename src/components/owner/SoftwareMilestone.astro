---
import type { OfferTerms } from '~/lib/software-offers';
interface Props { milestone?: OfferTerms['milestones'][number] }
const { milestone } = Astro.props;
---
<fieldset data-milestone class="software-milestone"><legend>Milestone</legend>
  <label>Name<input class="studio-input" name="milestoneName" maxlength="80" required value={milestone?.name ?? ''} /></label>
  <label>Deliverables, one per line<textarea class="studio-textarea" name="deliverables" rows="3" required>{milestone?.deliverables.join('\n') ?? ''}</textarea></label>
  <label>Acceptance examples, one per line<textarea class="studio-textarea" name="acceptance" rows="3" required>{milestone?.acceptance.join('\n') ?? ''}</textarea></label>
  <label>Fixed fee (USD)<input class="studio-input" name="fee" type="number" min="1" max="1000000" step="0.01" required value={milestone ? milestone.feeCents / 100 : ''} /></label>
  <p class="rail-muted rail-caption">Price only milestones whose scope is clear. If it depends on what an earlier milestone finds, save it for the next statement of work.</p>
  <label><input type="checkbox" name="hasCheckpoint" checked={Boolean(milestone?.checkpoint)} /> Add a checkpoint</label>
  <p class="rail-muted rail-caption">Add a checkpoint only if this milestone is large enough that 50% would under-cover a late cancellation.</p>
  <div data-checkpoint hidden={!milestone?.checkpoint}>
    <label>Checkpoint label<input class="studio-input" name="checkpointLabel" maxlength="120" value={milestone?.checkpoint?.label ?? ''} /></label>
    <label>Cancellation amount (%)<input class="studio-input" name="checkpointPercent" type="number" min="51" max="95" step="1" value={milestone?.checkpoint?.cancellationPercent ?? 75} /></label>
  </div>
  <button type="button" class="studio-quiet" data-remove-milestone>Remove milestone</button>
</fieldset>
