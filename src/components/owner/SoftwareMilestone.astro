---
import type { OfferTerms } from '~/lib/software-offers';
interface Props { number?: number; milestone?: OfferTerms['milestones'][number] }
const { milestone, number = 1 } = Astro.props;
---
<fieldset data-milestone class="software-milestone"><legend>Milestone {number}</legend>
  <label>Name<input class="studio-input" name="milestoneName" placeholder="Client onboarding tracker" maxlength="80" required value={milestone?.name ?? ''} /><span class="rail-muted rail-caption">Up to 80 characters.</span></label>
  <label>Deliverables, one per line<textarea class="studio-textarea" name="deliverables" placeholder="Shared tracker with status, next action and owner" maxlength="1607" rows="3" required>{milestone?.deliverables.join('\n') ?? ''}</textarea><span class="rail-muted rail-caption">One per line, 1 to 8 lines.</span></label>
  <label>Acceptance examples, one per line<textarea class="studio-textarea" name="acceptance" placeholder="Add a client and see them in the list" maxlength="1504" rows="3" required>{milestone?.acceptance.join('\n') ?? ''}</textarea><span class="rail-muted rail-caption">One per line, 1 to 5. Write checks the client can see pass.</span></label>
  <label>Fixed fee (USD)<input class="studio-input" name="fee" placeholder="2400" type="number" min="1" max="1000000" step="1" required value={milestone ? milestone.feeCents / 100 : ''} /><span class="rail-muted rail-caption">Whole dollars, $1 to $1,000,000.</span></label>
  <p class="rail-muted rail-caption">Price only milestones whose scope is clear. If it depends on what an earlier milestone finds, save it for the next statement of work.</p>
  <label><input type="checkbox" name="hasCheckpoint" checked={Boolean(milestone?.checkpoint)} /> Add a checkpoint</label>
  <p class="rail-muted rail-caption">Add a checkpoint only if this milestone is large enough that 50% would under-cover a late cancellation.</p>
  <div data-checkpoint hidden={!milestone?.checkpoint}>
    <label>Checkpoint label<input class="studio-input" name="checkpointLabel" placeholder="Direction approved" maxlength="120" value={milestone?.checkpoint?.label ?? ''} /><span class="rail-muted rail-caption">What’s been reached, e.g. Direction approved.</span></label>
    <label>Cancellation amount (%)<input class="studio-input" name="checkpointPercent" placeholder="75" type="number" min="51" max="95" step="1" value={milestone?.checkpoint?.cancellationPercent ?? 75} /><span class="rail-muted rail-caption">51 to 95% of this milestone.</span></label>
  </div>
  <button type="button" class="studio-quiet" data-remove-milestone>Remove milestone</button>
</fieldset>
