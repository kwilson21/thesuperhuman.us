---
import type { OfferTerms } from '~/lib/software-offers';
interface Props { number?: number; milestone?: OfferTerms['milestones'][number] }
const { milestone, number = 1 } = Astro.props;
---
<fieldset data-milestone class="software-milestone"><legend>Milestone {number}</legend>
  <label>Name<input class="studio-input" name="milestoneName" id={`milestone-${number}-milestoneName`} aria-describedby={`milestone-${number}-milestoneName-hint`} placeholder="Client onboarding tracker" maxlength="80" required value={milestone?.name ?? ''} /></label><p id={`milestone-${number}-milestoneName-hint`} data-hint="milestoneName" class="rail-muted rail-caption">Up to 80 characters.</p>
  <label>Deliverables, one per line<textarea class="studio-textarea" name="deliverables" id={`milestone-${number}-deliverables`} aria-describedby={`milestone-${number}-deliverables-hint`} placeholder="Shared tracker with status, next action and owner" maxlength="1607" rows="3" required>{milestone?.deliverables.join('\n') ?? ''}</textarea></label><p id={`milestone-${number}-deliverables-hint`} data-hint="deliverables" class="rail-muted rail-caption">One per line, 1 to 8 lines.</p>
  <label>Acceptance examples, one per line<textarea class="studio-textarea" name="acceptance" id={`milestone-${number}-acceptance`} aria-describedby={`milestone-${number}-acceptance-hint`} placeholder="Add a client and see them in the list" maxlength="1504" rows="3" required>{milestone?.acceptance.join('\n') ?? ''}</textarea></label><p id={`milestone-${number}-acceptance-hint`} data-hint="acceptance" class="rail-muted rail-caption">One per line, 1 to 5. Write checks the client can see pass.</p>
  <label>Fixed fee (USD)<input class="studio-input" name="fee" id={`milestone-${number}-fee`} aria-describedby={`milestone-${number}-fee-hint`} placeholder="2400" type="number" min="1" max="1000000" step="1" required value={milestone ? milestone.feeCents / 100 : ''} /></label><p id={`milestone-${number}-fee-hint`} data-hint="fee" class="rail-muted rail-caption">Whole dollars, $1 to $1,000,000.</p>
  <p class="rail-muted rail-caption">Price only milestones whose scope is clear. If it depends on what an earlier milestone finds, save it for the next statement of work.</p>
  <label><input type="checkbox" name="hasCheckpoint" id={`milestone-${number}-hasCheckpoint`} aria-describedby={`milestone-${number}-hasCheckpoint-hint`} checked={Boolean(milestone?.checkpoint)} /> Add a checkpoint</label>
  <p id={`milestone-${number}-hasCheckpoint-hint`} data-hint="hasCheckpoint" class="rail-muted rail-caption">Add a checkpoint only if this milestone is large enough that 50% would under-cover a late cancellation.</p>
  <div data-checkpoint hidden={!milestone?.checkpoint}>
    <label>Checkpoint label<input class="studio-input" name="checkpointLabel" id={`milestone-${number}-checkpointLabel`} aria-describedby={`milestone-${number}-checkpointLabel-hint`} placeholder="Direction approved" maxlength="120" value={milestone?.checkpoint?.label ?? ''} /></label><p id={`milestone-${number}-checkpointLabel-hint`} data-hint="checkpointLabel" class="rail-muted rail-caption">What’s been reached, e.g. Direction approved.</p>
    <label>Cancellation amount (%)<input class="studio-input" name="checkpointPercent" id={`milestone-${number}-checkpointPercent`} aria-describedby={`milestone-${number}-checkpointPercent-hint`} placeholder="75" type="number" min="51" max="95" step="1" value={milestone?.checkpoint?.cancellationPercent ?? 75} /></label><p id={`milestone-${number}-checkpointPercent-hint`} data-hint="checkpointPercent" class="rail-muted rail-caption">51 to 95% of this milestone.</p>
  </div>
  <button type="button" class="studio-quiet" data-remove-milestone>Remove milestone</button>
</fieldset>
