---
import { projectTerms, projectStates, projectSteps, softwareDate, sharedSoftwareUpdates, milestonePayments, updateKinds } from '~/lib/software-projects';
import SoftwareAgreementPanel from './SoftwareAgreementPanel.astro';
import { executedOfferAgreement, offerAgreements } from '~/lib/software-agreements';
import SoftwareInvoiceLine from './SoftwareInvoiceLine.astro';
import { listSoftwareInvoices, invoiceAvailable, paidFirstDeposit, payableSoftwareInvoice, manualPaymentReminder } from '~/lib/software-invoices';
import { addBusinessDays } from '~/lib/business-days';
import type { SoftwareProject, SoftwareUpdate } from '~/lib/software-projects';
import type { SoftwareOffer } from '~/lib/software-offers';
type Props = { requestId: string; requestUpdatedAt: string; project: SoftwareProject | null; sentOffer?: SoftwareOffer; updates: SoftwareUpdate[]; closed: boolean };
const { requestId, requestUpdatedAt, project, sentOffer, updates, closed } = Astro.props;
const terms = project?.content_deleted_at ? null : project ? projectTerms(project) : sentOffer ? projectTerms(sentOffer) : null;
const executed=sentOffer ? await executedOfferAgreement(Astro.locals.runtime.env.MUSIC_DB!,sentOffer.id) : null;
const websiteSigned=sentOffer&&(await offerAgreements(Astro.locals.runtime.env.MUSIC_DB!,sentOffer.id)).some(d=>d.status==='client_signed'||d.status==='executed');
const retryCutoff = Date.now() - 60_000;
const retryReady = (attemptedAt: string | null) => Boolean(attemptedAt && Date.parse(attemptedAt) <= retryCutoff);
const draft = updates.find(update => update.status === 'draft');
const shared = project && terms ? await sharedSoftwareUpdates(Astro.locals.runtime.env.MUSIC_DB!,requestId) : [];
const payments = project && terms ? await milestonePayments(Astro.locals.runtime.env.MUSIC_DB!,requestId) : [];
const deposits=project && terms ? (await Astro.locals.runtime.env.MUSIC_DB!.prepare('SELECT milestone_index,paid_recorded_at FROM software_milestone_deposits WHERE request_id=?').bind(requestId).all<{milestone_index:number;paid_recorded_at:string}>()).results : [];
const offerId=project?.offer_id ?? sentOffer?.id;
const invoices=offerId && terms ? await listSoftwareInvoices(Astro.locals.runtime.env.MUSIC_DB!,requestId,offerId) : [];
const depositBlocked=payableSoftwareInvoice(invoices,0,['deposit']);
const deposit=offerId ? paidFirstDeposit(invoices,offerId) : undefined;
const unmatched=(await Astro.locals.runtime.env.MUSIC_DB!.prepare('SELECT event_id,event_type,status FROM software_stripe_unmatched_events WHERE request_id=? AND resolved_at IS NULL ORDER BY received_at DESC').bind(requestId).all<{event_id:string;event_type:string;status:string}>()).results;
const lastDelivery=terms && shared.find(update=>update.kind==='delivery_review' && update.status==='shared' && update.milestone_index===terms.milestones.length-1);
const canComplete = lastDelivery?.decision==='milestone_accepted' && shared.some(update=>update.kind==='handoff' && update.status==='shared' && update.milestone_index===lastDelivery.milestone_index && update.shared_at!>=lastDelivery.decided_at!);
---
<SoftwareAgreementPanel requestId={requestId} offerId={sentOffer?.id} />
{project?.content_deleted_at && <section class="rail-section"><h2>Project</h2><p class="rail-muted">Project content was removed by reviewed retention cleanup.</p></section>}
{terms && <section class="rail-section software-rail" aria-labelledby="software-project-heading" data-software-project data-endpoint={`/api/owner/requests/${requestId}/project`} data-invoice-endpoint={`/api/owner/requests/${requestId}/invoices`}>
  <h2 id="software-project-heading">{project ? 'Project' : 'Start the project'}</h2>
  {unmatched.length>0 && <p class="rail-muted">Stripe events need reconciliation: {unmatched.map(event=>`${event.event_id} · ${event.event_type} · ${event.status}`).join('; ')}. Check the invoice in Stripe; no payment has been recorded from these events.</p>}
  {!project && terms.paymentMode==='standard' && <SoftwareInvoiceLine offerId={offerId!} milestone={0} kind="deposit" invoices={invoices} available={!deposit} closed={closed} />}
  {!project ? <form data-software-start data-request-updated-at={requestUpdatedAt} data-deposit-invoice-id={deposit?.id}>
    <input type="hidden" name="signature_source" value={websiteSigned?'website':'external'} />
    {websiteSigned&&!executed&&<p class="rail-muted">Finish countersigning, prepare the PDF and deliver both complete copies before starting.</p>}
    {!websiteSigned && <><label>Signed date<input class="studio-input" type="date" name="external_signed_on" required /></label><label>Typed parties<input class="studio-input" name="external_parties" required maxlength="500" /></label><label>Kept copy reference<input class="studio-input" name="external_copy_reference" required maxlength="200" /></label><label><input type="checkbox" name="external_kept_copy" required />I kept the complete signed copy.</label></>}
    <label>Purchase order number (if required)<input class="studio-input" name="po_number" maxlength="100" /></label><label>Client agreement date for an earlier start<input class="studio-input" type="date" name="earlier_start_on" /></label><label>Dated client agreement for an earlier start (if applicable)<textarea class="studio-textarea" name="earlier_start_agreement" maxlength="500"></textarea></label>
    <label><input type="checkbox" name="inputs_ready" required />Required client inputs are ready.</label>
    <input type="hidden" name="offer_id" value={sentOffer!.id} />
    <input type="hidden" name="offer_version" value={sentOffer!.version} />
    <p class="rail-muted rail-caption">Record these only after checking them yourself. The client sees them as complete.</p>
    <label class="confirmation"><input type="checkbox" name="signatures" required checked={Boolean(executed)} disabled={closed || Boolean(websiteSigned)} />{websiteSigned?'Website signatures and retained copies are complete':'All signatures are complete (signed outside the website)'}</label>
    {terms.paymentMode==='standard' && depositBlocked && <p class="rail-muted">{manualPaymentReminder}</p>}
    <label class="confirmation" hidden={terms.paymentMode==='standard' && depositBlocked}><input type="checkbox" name="payment" required checked={Boolean(deposit)} disabled={closed} />{terms.paymentMode === 'standard' ? 'First installment received (checked in Stripe or the bank)' : 'Purchase order in place, or the client doesn’t use one'}</label>
    <div class="software-field"><label>Next update to the client<input aria-describedby="project-field-1-hint" class="studio-input" type="date" name="next_update_on" /></label><p id="project-field-1-hint" class="rail-muted rail-caption">Only promise a date you can keep.</p></div>
    <button class="studio-button" disabled type="submit">Confirm start</button>
  </form> : <>
    <form data-software-state data-updated-at={project.updated_at}>
      <fieldset disabled={closed || Boolean(project.revoked_at) || Boolean(project.completed_at)}>
        <label>State<select class="studio-select" name="state">{Object.entries(projectStates).filter(([value])=>value!=='complete' || project.state==='complete').map(([value,label]) => <option value={value} selected={project.state === value}>{label}</option>)}</select></label>
        <div class="software-field"><label>Waiting for<input aria-describedby="project-field-2-hint" class="studio-input" name="waiting_for" maxlength="200" value={project.waiting_for} required={project.state === 'waiting_for_input'} /></label><p id="project-field-2-hint" class="rail-muted rail-caption">Name the one thing you need, e.g. Access to the sample export.</p></div>
        <label>Milestone<select class="studio-select" name="milestone_index">{terms.milestones.map((item,index) => <option value={index} selected={index === project.milestone_index}>Milestone {index+1} · {item.name}</option>)}</select></label>
        <label>Step<select class="studio-select" name="step">{projectSteps.map(step => <option value={step} selected={step === project.step}>{step[0].toUpperCase()+step.slice(1)}</option>)}</select></label>
        <div class="software-field"><label>Next update to the client<input aria-describedby="project-field-3-hint" class="studio-input" type="date" name="next_update_on" value={project.next_update_on} /></label><p id="project-field-3-hint" class="rail-muted rail-caption">Only promise a date you can keep.</p></div>
        <button class="studio-button" type="submit">Save</button>
      </fieldset>
    </form>
    <h3>Milestones</h3>
    <ul class="software-update-list">{terms.milestones.map((item,index)=>{
      const reviews=shared.filter(update=>update.milestone_index===index && update.status==='shared' && update.kind?.endsWith('_review')).reverse();
      const depositBlocked=payableSoftwareInvoice(invoices,index,['deposit']);
      const manualDeposit=deposits.find(payment=>payment.milestone_index===index);
      const depositPaid=Boolean(manualDeposit) || invoices.some(invoice=>invoice.milestone_index===index && invoice.kind==='deposit' && invoice.status==='paid' && !invoice.refunded_at);
      const delivery=shared.find(update=>update.kind==='delivery_review' && update.status==='shared' && update.milestone_index===index);
      const paymentBlocked=payableSoftwareInvoice(invoices,index,['balance','milestone']);
      const paid=payments.find(payment=>payment.milestone_index===index),handoff=shared.find(update=>update.milestone_index===index && update.status==='shared' && update.kind==='handoff');
      return <li><strong>Milestone {index+1} · {item.name}</strong>{reviews.map(review=><span>{review.decision==='direction_confirmed' ? 'Direction confirmed' : review.decision==='changes_requested' ? 'Changes requested' : review.decision==='milestone_accepted' ? `Accepted ${softwareDate(review.decided_at!)}` : `Ready for review${review.kind==='delivery_review' ? `, review by ${softwareDate(addBusinessDays(review.shared_at!,review.review_window_days ?? 5))}` : ''}`}</span>)}{manualDeposit && <span>Deposit recorded {softwareDate(manualDeposit.paid_recorded_at)}</span>}{paid && <span>Paid in full {softwareDate(paid.paid_recorded_at)}</span>}{handoff && <span>Handoff shared {softwareDate(handoff.shared_at!)}</span>}
        {(terms.paymentMode==='standard' ? ['deposit','balance'] as const : ['milestone'] as const).map(kind=><SoftwareInvoiceLine offerId={offerId!} milestone={index} kind={kind} invoices={invoices}
          available={(kind!=='deposit' || !depositPaid) && invoiceAvailable(terms,index,kind,project,Boolean(delivery && delivery.decision!=='changes_requested'),Boolean(paid))}
          closed={closed || Boolean(project.revoked_at) || Boolean(project.completed_at)}
          redeliveryAt={shared.some(update=>update.kind==='delivery_review' && update.milestone_index===index && update.status==='superseded' && update.decision==='changes_requested') ? shared.find(update=>update.kind==='delivery_review' && update.status==='shared' && update.milestone_index===index)?.shared_at ?? undefined : undefined} />)}
        {terms.paymentMode==='standard' && index>project.milestone_index && !depositPaid && !closed && !project.revoked_at && !project.completed_at && (depositBlocked ? <p class="rail-muted">{manualPaymentReminder}</p> : <form data-software-deposit data-milestone={index}><label class="confirmation"><input type="checkbox" name="confirmed" required />Deposit received outside Stripe (checked in the bank)</label><button class="studio-quiet" type="submit">Record deposit</button></form>)}
        {!paid && paymentBlocked && <p class="rail-muted">{manualPaymentReminder}</p>}
        {!paid && !paymentBlocked && !closed && !project.revoked_at && project.state!=='complete' && <form data-software-payment data-milestone={index}><label class="confirmation"><input type="checkbox" name="confirmed" required />This milestone is paid in full (checked in Stripe or the bank)</label><button class="studio-quiet" type="submit">Record full payment</button></form>}
      </li>;
    })}</ul>
    {canComplete && !closed && !project.revoked_at && !project.completed_at && <button class="studio-button" type="button" data-software-complete>Mark project complete</button>}
    <h3>Updates</h3>
    <ul class="software-update-list">{updates.map(update => <li><strong>{update.title || 'Untitled draft'}</strong><span>{updateKinds[update.kind]} · {{ draft: 'Draft', shared: 'Shared', superseded: 'Superseded' }[update.status]}{update.shared_at ? ` · ${softwareDate(update.shared_at)}` : ''}</span>
      {update.status === 'shared' && ['pending','failed','sending'].includes(update.notification_status) && <><p class="rail-muted">{update.notification_status === 'sending' ? retryReady(update.notification_attempted_at) ? 'Email unconfirmed. Check Resend before retrying.' : 'Checking delivery. Retry is available after a minute.' : update.notification_status === 'failed' ? 'Update email failed.' : 'Update email pending.'}</p>{(update.notification_status !== 'sending' || retryReady(update.notification_attempted_at)) && <button class="studio-quiet" type="button" data-software-notice={update.id} data-uncertain={update.notification_status === 'sending' ? 'true' : undefined}>{update.notification_status === 'sending' ? 'I checked Resend; retry' : 'Retry notice'}</button>}</>}
    </li>)}</ul>
    {!closed && !project.revoked_at && project.state!=='complete' && <a href={`/owner/requests/${requestId}/update`}>{draft ? 'Continue draft' : 'New update'} →</a>}
    <h3>Client access</h3><p class="rail-state"><span class:list={['state-dot', project.revoked_at ? 'closed' : project.invitation_status]} aria-hidden="true"></span>{project.revoked_at ? 'Access closed. Sign-in and private files are unavailable.' : project.invitation_status === 'sent' ? 'Sign-in link sent' : project.invitation_status === 'sending' ? retryReady(project.invitation_attempted_at) ? 'Sign-in email unconfirmed. Check Resend before retrying.' : 'Checking delivery. Retry is available after a minute.' : project.invitation_status === 'failed' ? 'Sign-in email failed. The project is saved.' : 'Sign-in email not sent yet'}</p>
    {!closed && !project.revoked_at && <>{project.invitation_status !== 'sent' && (project.invitation_status !== 'sending' || retryReady(project.invitation_attempted_at)) && <button class:list={[project.invitation_status === 'sending' ? 'studio-quiet' : 'studio-button']} type="button" data-software-notice="" data-uncertain={project.invitation_status === 'sending' ? 'true' : undefined}>{project.invitation_status === 'sending' ? 'I checked Resend; retry' : project.invitation_status === 'failed' ? 'Retry invitation' : 'Send invitation'}</button>}
      <details class="rail-close"><summary>Close client access</summary><p class="rail-caption">Signs the client out and hides the project immediately.</p><button class="studio-quiet danger" type="button" data-software-revoke>Close client access</button></details>
    </>}
  </>}
  <p class="studio-status" data-software-status role="status" aria-live="polite"></p>
</section>}
<style>
  fieldset { display: grid; gap: .8rem; }
  h3 { font: 400 1.2rem/1.3 Newsreader,Georgia,serif; margin-top: 1rem; }
  .software-update-list { list-style: none; padding: 0; }
  li { display: grid; gap: .4rem; border-top: 1px solid var(--rule); padding: .8rem 0; overflow-wrap: anywhere; }
  li strong { font: 500 .9rem/1.5 Inter,sans-serif; } li span { font: .75rem/1.5 Inter,sans-serif; color: var(--muted); }
  summary { cursor: pointer; margin-top: .8rem; }
</style>
<script>import { setupSoftwareProject } from '~/scripts/software-project'; setupSoftwareProject();</script>
