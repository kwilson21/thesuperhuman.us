---
import { projectTerms, projectStates, projectSteps, softwareDate } from '~/lib/software-projects';
import type { SoftwareProject, SoftwareUpdate } from '~/lib/software-projects';
import type { SoftwareOffer } from '~/lib/software-offers';
type Props = { requestId: string; project: SoftwareProject | null; sentOffer?: SoftwareOffer; updates: SoftwareUpdate[]; closed: boolean };
const { requestId, project, sentOffer, updates, closed } = Astro.props;
const terms = project?.content_deleted_at ? null : project ? projectTerms(project) : sentOffer ? projectTerms(sentOffer) : null;
const draft = updates.find(update => update.status === 'draft');
---
{project?.content_deleted_at && <section class="rail-section"><h2>Project</h2><p class="rail-muted">Project content was removed by reviewed retention cleanup.</p></section>}
{terms && <section class="rail-section software-rail" data-software-project data-endpoint={`/api/owner/requests/${requestId}/project`}>
  <h2>{project ? 'Project' : 'Start the project'}</h2>
  {!project ? <form data-software-start>
    <p class="rail-muted rail-caption">Record these only after checking them yourself. The client sees them as complete.</p>
    <label class="confirmation"><input type="checkbox" name="signatures" required disabled={closed} />All signatures are complete (checked in Dropbox Sign)</label>
    <label class="confirmation"><input type="checkbox" name="payment" required disabled={closed} />{terms.paymentMode === 'standard' ? 'First installment received (checked in Stripe or the bank)' : 'First invoice sent'}</label>
    <label>Next update to the client<input class="studio-input" type="date" name="next_update_on" /><small class="rail-muted">Only promise a date you can keep.</small></label>
    <button class="studio-button" disabled type="submit">Confirm start</button>
  </form> : <>
    <form data-software-state data-updated-at={project.updated_at}>
      <fieldset disabled={closed || Boolean(project.revoked_at)}>
        <label>State<select class="studio-select" name="state">{Object.entries(projectStates).map(([value,label]) => <option value={value} selected={project.state === value}>{label}</option>)}</select></label>
        <label>Waiting for<input class="studio-input" name="waiting_for" maxlength="200" value={project.waiting_for} required={project.state === 'waiting_for_input'} /><small class="rail-muted">Name the one thing you need, e.g. Access to the sample export.</small></label>
        <label>Milestone<select class="studio-select" name="milestone_index">{terms.milestones.map((item,index) => <option value={index} selected={index === project.milestone_index}>Milestone {index+1} · {item.name}</option>)}</select></label>
        <label>Step<select class="studio-select" name="step">{projectSteps.map(step => <option value={step} selected={step === project.step}>{step[0].toUpperCase()+step.slice(1)}</option>)}</select></label>
        <label>Next update to the client<input class="studio-input" type="date" name="next_update_on" value={project.next_update_on} /><small class="rail-muted">Only promise a date you can keep.</small></label>
        <button class="studio-button" type="submit">Save</button>
      </fieldset>
    </form>
    <h3>Updates</h3>
    <ul class="software-update-list">{updates.map(update => <li><strong>{update.title || 'Untitled draft'}</strong><span>{update.kind === 'progress' ? 'Progress' : String(update.kind).replaceAll('_',' ')} · {update.status}{update.shared_at ? ` · ${softwareDate(update.shared_at)}` : ''}</span>
      {['pending','failed','sending'].includes(update.notification_status) && <><p class="rail-muted">{update.notification_status === 'sending' ? 'Email unconfirmed. Check Resend before retrying.' : update.notification_status === 'failed' ? 'Update email failed.' : 'Update email pending.'}</p><button class="studio-quiet" type="button" data-software-notice={update.id} data-uncertain={update.notification_status === 'sending' ? 'true' : undefined}>{update.notification_status === 'sending' ? 'I checked Resend; retry' : 'Retry notice'}</button></>}
    </li>)}</ul>
    {!closed && !project.revoked_at && <a href={`/owner/requests/${requestId}/update`}>{draft ? 'Continue draft' : 'New update'} →</a>}
    <h3>Client access</h3><p class="rail-muted">{project.revoked_at ? 'Access closed.' : project.invitation_status === 'sent' ? 'Sign-in link sent.' : project.invitation_status === 'sending' ? 'Sign-in email unconfirmed. Check Resend before retrying.' : `Invitation ${project.invitation_status}.`}</p>
    {!closed && !project.revoked_at && <>{project.invitation_status !== 'sent' && <button class="studio-quiet" type="button" data-software-notice="" data-uncertain={project.invitation_status === 'sending' ? 'true' : undefined}>{project.invitation_status === 'sending' ? 'I checked Resend; retry' : 'Retry invitation'}</button>}
      <details><summary>Close client access</summary><p class="rail-caption">Signs the client out and hides the project immediately.</p><button class="studio-quiet danger" type="button" data-software-revoke>Close client access</button></details>
    </>}
  </>}
  <p class="studio-status" data-software-status role="status" aria-live="polite"></p>
</section>}
<style>
  fieldset { display: grid; gap: .8rem; }
  label.confirmation { display: flex; align-items: start; gap: .6rem; }
  input[type=checkbox] { accent-color: var(--accent); margin-top: .3rem; flex-shrink: 0; }
  h3 { font: 400 1.25rem/1.3 Newsreader,Georgia,serif; margin-top: 1rem; }
  .software-update-list { list-style: none; padding: 0; }
  li { display: grid; gap: .4rem; border-top: 1px solid var(--rule); padding: .8rem 0; overflow-wrap: anywhere; }
  li strong { font: 500 .9rem/1.5 Inter,sans-serif; } li span { font: .75rem/1.5 Inter,sans-serif; color: var(--muted); }
  summary { cursor: pointer; margin-top: .8rem; }
</style>
<script>import { setupSoftwareProject } from '~/scripts/software-project'; setupSoftwareProject();</script>
