---
type FileRow = { id: string; version: 'review' | 'final'; display_name: string; byte_size: number;
  status: 'uploaded' | 'published' | 'revoked'; uploaded_at: string; published_at: string | null };
type PendingUpload = { id: string; display_name: string; state: 'pending' | 'discarding'; created_at: string };
type Props = { files: FileRow[]; pending: PendingUpload[]; endpoint: string; canUpload: boolean };
const { files, pending, endpoint, canUpload } = Astro.props;
---
<section class="owner-section project-files" data-owner-project-files data-endpoint={endpoint} aria-labelledby="project-files-heading">
  <p class="owner-kicker">Private files</p><h2 id="project-files-heading">Review and delivery</h2>
  {files.length ? <ul>{files.map(file => <li><div><strong>{file.display_name}</strong><span>{file.version === 'review' ? 'Review' : 'Final'} · {file.status} · {(file.byte_size / 1024 / 1024).toFixed(1)} MB</span></div><time datetime={file.uploaded_at}>{new Date(file.uploaded_at).toLocaleDateString('en-US', { dateStyle: 'medium' })}</time></li>)}</ul> : <p>No files uploaded yet.</p>}
  {pending.length > 0 && <div class="unfinished"><h3>Unfinished uploads</h3><p>If an upload finished but did not appear above, try recovery. Otherwise discard it and start again.</p><ul>{pending.map(upload => <li><div><strong>{upload.display_name}</strong><span>{upload.state === 'discarding' ? 'Cleanup needs another try' : 'Started'} {new Date(upload.created_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}</span></div><div class="upload-actions">{upload.state === 'pending' && <button type="button" data-upload-action="recover" data-upload-id={upload.id}>Recover</button>}<button type="button" data-upload-action="abort" data-upload-id={upload.id}>{upload.state === 'discarding' ? 'Retry cleanup' : 'Discard'}</button></div></li>)}</ul><p data-pending-status role="status" aria-live="polite"></p></div>}
  {canUpload && <form data-project-upload-form>
    <h3>Upload a private file</h3>
    <p>Uploading does not share a file with the client. You will choose when to publish it.</p>
    <label>Version <select name="version"><option value="review">Review version</option><option value="final">Final version</option></select></label>
    <label>Audio file <input name="file" type="file" accept=".mp3,.wav,audio/mpeg,audio/wav" required /></label>
    <button type="submit">Upload file</button>
    <p data-upload-status role="status" aria-live="polite"></p>
  </form>}
</section>
<style>
  .project-files h2 { font-size: clamp(2rem,4vw,3rem); line-height: 1.1; margin-bottom: 1.2rem; }
  .project-files > p:not(.owner-kicker),form p { color: #514d47; font: .9rem/1.5 Inter,sans-serif; }
  ul { list-style: none; padding: 0; margin: 0 0 2rem; border-top: 1px solid #d8d2c9; }
  li { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid #d8d2c9; }
  li div { display: grid; gap: .2rem; min-width: 0; }
  li strong { overflow-wrap: anywhere; font: 500 1rem/1.4 Inter,sans-serif; }
  li span,li time { color: #66615a; font: .78rem/1.4 Inter,sans-serif; }
  form { display: grid; gap: .85rem; max-width: 32rem; border-top: 1px solid #d8d2c9; padding-top: 1.5rem; }
  h3 { font: 400 1.6rem/1.15 Newsreader,Georgia,serif; }
  label { display: grid; gap: .35rem; font: 500 .85rem/1.4 Inter,sans-serif; }
  select,input { padding: .65rem; border: 1px solid #9d968c; background: #fffdf9; font: 1rem/1.4 Inter,sans-serif; max-width: 100%; }
  button { justify-self: start; border: 0; border-bottom: 1px solid currentColor; background: none; padding: .4rem 0; font: 500 .9rem/1.4 Inter,sans-serif; cursor: pointer; }
  button:hover { color: #a4512f; } button:disabled { opacity: .5; cursor: wait; }
  .unfinished { margin-top: 1.5rem; } .unfinished h3 { margin-bottom: .5rem; } .unfinished p { color: #514d47; font: .9rem/1.5 Inter,sans-serif; }
  .upload-actions { display: flex; gap: 1rem; align-items: center; } .upload-actions button { font-size: .8rem; }
  [data-upload-status] { min-height: 1.4rem; }
</style>
