---
import { offerAgreements } from '~/lib/software-agreements';
import { consentText, authorityText, intentText } from '~/lib/agreement-fields';
interface Props {
  requestId: string;
  offerId: string;
}
const { requestId, offerId } = Astro.props,
  db = Astro.locals.runtime.env.MUSIC_DB!;
const docs = await offerAgreements(db, offerId),
  sow = docs.find((d) => d.kind === 'sow'),
  pending = docs.filter((d) => d.status === 'client_signed');
const artifact = sow
  ? await db
      .prepare('SELECT status,attempt_id FROM software_agreement_artifacts WHERE agreement_id=?')
      .bind(sow.id)
      .first<{ status: string; attempt_id: string | null }>()
  : null;
const deliveries = sow
  ? (
      await db
        .prepare(
          'SELECT recipient_role,status,alternate_delivered_at FROM software_agreement_deliveries WHERE agreement_id=?',
        )
        .bind(sow.id)
        .all<{ recipient_role: string; status: string; alternate_delivered_at: string | null }>()
    ).results
  : [];
const notifications = sow
  ? (
      await db
        .prepare('SELECT kind,status FROM software_agreement_notifications WHERE agreement_id=?')
        .bind(sow.id)
        .all<{ kind: string; status: string }>()
    ).results
  : [];
const action = pending.length === 2 ? 'Countersign MSA and SOW' : 'Countersign SOW',
  values = sow ? JSON.parse(sow.values_json) : null,
  endpoint = `/api/owner/requests/${requestId}/agreement`;
---
{sow&&<section class="rail-section wide"><h2>Agreement</h2><p>{sow.status==='client_signed'?'Client signature saved. Review before countersigning.':sow.status==='executed'?artifact?.status==='ready'?'Signed copy ready.':'Signed by both parties. Copy preparation needs attention.':'Client is reviewing.'}</p>
 {docs.map(d=><details><summary>{d.kind.toUpperCase()} · {d.effective_on}</summary><p class="rail-muted">SHA-256 {d.text_sha256}</p><pre>{d.canonical_text}</pre></details>)}
 {notifications.map(n=><p>{n.kind==='signature-receipt'?'Client signature receipt':'Owner countersign notice'}: {n.status}</p>)}
 {(pending.length>0||sow.status==='executed')&&<form method="post" action={endpoint}><input type="hidden" name="action" value="retry-copy" /><input type="hidden" name="agreement_id" value={sow.id} /><label><input type="checkbox" name="confirmedNotSent" value="true" />I checked Resend and confirmed any unconfirmed agreement email was not sent.</label><button class="studio-quiet">Retry agreement email</button></form>}
 {pending.length>0&&<><form method="post" action={endpoint}><input type="hidden" name="action" value="countersign" /><input type="hidden" name="documents" value={JSON.stringify(pending.map(d=>({id:d.id,hash:d.text_sha256})))} /><label>Full legal name<input class="studio-input" name="typed_name" required maxlength="200" /></label><p>Keep a complete copy. Signed agreements and signature evidence remain archived for 10 years after the agreement ends, longer for active reuse or legal hold.</p><label><input type="checkbox" name="consent" value="true" required />{consentText}</label><label><input type="checkbox" name="authority" value="true" required />{authorityText(values.contractor.legal_name)}</label><label><input type="checkbox" name="intent" value="true" required />{intentText(action)}</label><button class="studio-button">{action}</button></form><details><summary>Abandon pending countersignature</summary><form method="post" action={endpoint}><input type="hidden" name="action" value="abandon" /><input type="hidden" name="documents" value={JSON.stringify(pending.map(d=>({id:d.id,hash:d.text_sha256})))} /><label>Reason<textarea class="studio-textarea" name="reason" required maxlength="1000"></textarea></label><label><input type="checkbox" name="confirmed" value="true" required />Retain the client signature and require a new offer.</label><button class="studio-quiet">Abandon</button></form></details></>}
 {sow.status==='executed'&&<><form method="post" action={endpoint}><input type="hidden" name="action" value="retry-artifact" /><input type="hidden" name="agreement_id" value={sow.id} />{artifact?.status==='rendering'&&<><input type="hidden" name="expectedAttempt" value={artifact.attempt_id} /><label><input type="checkbox" name="confirmedStale" value="true" required />I checked the interrupted preparation attempt and confirmed it is safe to recover.</label></>}<button class="studio-quiet">Prepare or retry signed copy</button></form>{artifact?.status==='ready'&&<a href={`/api/owner/agreements/${sow.id}/file`}>Download signed agreement</a>}{deliveries.map(d=><p>{d.recipient_role} copy: {d.alternate_delivered_at?'Alternate delivery recorded':d.status}</p>)}</>}
{sow.status==='executed'&&<details><summary>Copy delivery and retention</summary><form method="post" action={endpoint}><input type="hidden" name="action" value="record-alternate-copy" /><input type="hidden" name="agreement_id" value={sow.id} /><label>Party<select class="studio-select" name="role"><option value="client">Client</option><option value="contractor">Contractor</option></select></label><label>Delivery method and reference<input class="studio-input" name="method" required maxlength="200" /></label><label><input type="checkbox" name="confirmed" value="true" required />I delivered the complete signed copy to this party.</label><button class="studio-quiet">Record alternate delivery</button></form>{docs.map(d=><><form method="post" action={endpoint}><input type="hidden" name="action" value="hold" /><input type="hidden" name="agreement_id" value={d.id} /><label><input type="checkbox" name="held" value="true" checked={Boolean((d as typeof d & {legal_hold:number}).legal_hold)} />Keep {d.kind.toUpperCase()} under legal hold</label><button class="studio-quiet">Save legal hold</button></form><form method="post" action={endpoint}><input type="hidden" name="action" value="end" /><input type="hidden" name="agreement_id" value={d.id} /><label>Explicit {d.kind.toUpperCase()} end date<input class="studio-input" type="date" name="ended_on" required /></label><label><input type="checkbox" name="confirmed" value="true" required />The agreement ended on this date. For an MSA, this also ends future reuse.</label><button class="studio-quiet">Record agreement end</button></form></>)}</details>}
</section>}
<style>
form {
  display: grid;
  gap: 1rem;
  margin: 1rem 0;
}
label {
  display: grid;
  gap: 0.4rem;
}
pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font: inherit;
}
p {
  overflow-wrap: anywhere;
}
details {
  margin: 1rem 0;
}
</style>
