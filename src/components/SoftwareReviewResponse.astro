---
import { softwareDate, softwareClientRevisionBody, softwareVersionLabel, softwareVersionNumber } from '~/lib/software-projects';
import type { ClientSoftwareUpdate } from '~/lib/software-projects';
type Props = { update: ClientSoftwareUpdate; checks: string[]; deliverables?: string[]; missingDeliverables?: {label:string;index:number}[]; inaccessibleDeliverables?: {label:string;index:number}[]; milestoneName: string; endpoint: string; readonly?: boolean; canAccept?: boolean };
const {update,checks,deliverables=[],missingDeliverables=[],inaccessibleDeliverables=[],milestoneName,endpoint,readonly=false,canAccept=true}=Astro.props;
const version=softwareVersionLabel(update);
const direction=update.kind==='direction_review';
const decisionBody=softwareClientRevisionBody(update.decision_body,checks,deliverables);
---
<section class="software-review">
  <h2>{direction ? 'Does this match how you work?' : 'Try these'}</h2>
  {update.decision ? <>
    <p>{update.decision==='direction_confirmed' ? `You confirmed this direction on ${softwareDate(update.decided_at!)}.` : update.decision==='milestone_accepted' ? `You accepted ${version} on ${softwareDate(update.decided_at!)}.` : `You asked for changes on ${softwareDate(update.decided_at!)}. I’ll reply here.`}</p>
    {update.decision==='changes_requested' && <p>{decisionBody}</p>}
  </> : readonly ? <p>This update is shown for reference.</p> : <form data-software-review data-endpoint={endpoint} data-version={version} data-milestone={milestoneName} data-direction={String(direction)}>
    {!direction && <><p>Mark what you've tried. Nothing is accepted until you click Accept.</p><div class="try-checks">{checks.map((check,index)=><div class="try-check"><span>{check}</span><div role="group" aria-label={check}><button type="button" data-review-check={index} data-review-mark="works" aria-pressed="false">Works</button><button type="button" data-review-check={index} data-review-mark="not-yet" aria-pressed="false">Not yet</button></div></div>)}</div></>}
    <button class="studio-button" type="submit" name="decision" formnovalidate value={direction ? 'direction_confirmed' : 'milestone_accepted'} disabled={!direction && !canAccept}>{direction ? 'Confirm this direction' : `Accept ${softwareVersionNumber(update) ? version.toLowerCase() : version}`}</button>
    {!direction && !canAccept && <p>This version can't be accepted yet because it doesn't include everything we agreed. You can still try it and send notes.</p>}
    <details data-request-changes><summary>Something's not right? Tell me what</summary>
      {!direction && <fieldset><legend>Which agreed checks are unmet?</legend>{checks.map((check,index)=><label class="check-choice"><input type="checkbox" name="criteria" value={index} />{check}</label>)}<p class="hint">Select a check that does not pass, or choose a deliverable below.</p></fieldset>}
      {!direction && missingDeliverables.length>0 && <fieldset><legend>Which planned deliverables are not included yet?</legend><p class="hint">These items were in the agreement but are not listed in this delivery. You can request them without marking a passing check as failed.</p>{missingDeliverables.map(item=><label class="check-choice"><input type="checkbox" name="missing_deliverables" value={item.index} />{item.label}</label>)}</fieldset>}
      {!direction && inaccessibleDeliverables.length>0 && <fieldset><legend>Which included deliverables can’t you open or find?</legend><p class="hint">Choose an item listed as included if you can’t access it. This is separate from a check that does not pass.</p>{inaccessibleDeliverables.map(item=><label class="check-choice"><input type="checkbox" name="inaccessible_deliverables" value={item.index} />{item.label}</label>)}</fieldset>}
      <label>What did you see?<textarea class="studio-textarea" name="note" required maxlength="2000" placeholder={direction ? 'What should change, and why?' : 'Tell me what happened and how to see it.'}></textarea></label>
      <button class="studio-button secondary" type="submit" name="decision" value="changes_requested">Send</button>
    </details>
    {direction && <p>Confirming the direction approves this approach only. The working milestone is reviewed separately.</p>}
    <p class="studio-status" role="status" aria-live="polite" data-review-status></p>
  </form>}
</section>
<style>
  .try-check { display: flex; justify-content: space-between; align-items: center; gap: .8rem; border-top: 1px solid var(--rule); padding: .7rem 0; font: .9rem/1.5 Inter,sans-serif; }
  .try-check [role=group] { display: flex; gap: .4rem; flex-shrink: 0; }
  .try-check button { border: 1px solid var(--rule); padding: .4rem .6rem; background: transparent; color: var(--ink); }
  .try-check button[aria-pressed=true] { border-color: var(--studio-done); background: var(--studio-soft); }
  .studio-status:empty { display: none; }
  fieldset { border: 0; padding: 0; margin: 0; }
  .software-review { min-width: 0; overflow-wrap: anywhere; }
  h2 { font: 400 1.8rem/1.2 Libron,Georgia,serif; margin: 0 0 .6rem; }
  p { font: .95rem/1.6 Inter,sans-serif; white-space: pre-wrap; }
  form, fieldset, label { display: grid; gap: .8rem; min-width: 0; }
  legend { font: .95rem/1.5 Inter,sans-serif; margin-bottom: .6rem; }
  label { font: .9rem/1.5 Inter,sans-serif; }
  label.check-choice { display: flex; align-items: start; gap: .6rem; }
  label.check-choice span { display: grid; gap: .1rem; }
  label.check-choice small { color: var(--muted); font: .78rem/1.4 Inter,sans-serif; }
  input[type=checkbox] { accent-color: var(--accent); margin-top: .3rem; flex-shrink: 0; }
  details { border-top: 1px solid var(--rule); padding-top: .8rem; }
  summary { list-style: none; cursor: pointer; font: .95rem/1.5 Inter,sans-serif; color: var(--ink); text-decoration: underline; text-underline-offset: .2em; margin-bottom: .8rem; }
  summary::-webkit-details-marker { display: none; }
  .hint { color: var(--muted); font-size: .8rem; }
  .secondary { background: transparent; color: var(--ink); border: 1px solid var(--ink); width: 100%; }
  .secondary:hover { color: var(--paper); }
  .studio-button { width: 100%; }
</style>
