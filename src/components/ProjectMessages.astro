---
import type { ProjectMessage } from '~/lib/audio-project-messages';
import { safeExternalUrl } from '~/lib/owner-model';
import '~/styles/studio.css';

type Props = {
  messages: ProjectMessage[];
  endpoint: string;
  reader: 'owner' | 'client';
  closed: boolean;
};
const { messages, endpoint, reader, closed } = Astro.props;
const unread = messages.some(message => message.actor !== reader && !message.read_at);
function parts(body: string) {
  const result: { text: string; href?: string }[] = [];
  const links = /https:\/\/[^\s<>"']+/gi;
  let cursor = 0;
  for (const match of body.matchAll(links)) {
    const start = match.index ?? 0;
    if (start > cursor) result.push({ text: body.slice(cursor, start) });
    const link = match[0].replace(/[.,!?;:)\]]+$/, '');
    const href = safeExternalUrl(link);
    result.push(href ? { text: link, href } : { text: link });
    cursor = start + link.length;
  }
  if (cursor < body.length) result.push({ text: body.slice(cursor) });
  return result;
}
---
<section class="project-messages" data-project-messages data-endpoint={endpoint} data-unread={unread ? 'true' : 'false'} aria-labelledby="project-messages-heading">
  <div class="project-messages-heading"><p class="project-messages-kicker">Conversation</p><h2 id="project-messages-heading">Stay in the loop</h2></div>
  {messages.length ? <ol class="project-message-list">{messages.map(message =>
    <li class:list={{ mine: message.actor === reader }} data-unread-message={message.actor !== reader && !message.read_at ? message.id : undefined}>
      <div class="project-message-meta"><strong>{message.actor === reader ? 'You' : message.actor === 'owner' ? 'Kazon' : 'Client'}</strong>{message.review_decision && <span class:list={['decision', message.review_decision]}>{message.review_decision === 'approved' ? 'Approved the mix' : message.review_decision === 'stopped' ? 'Stopped the project' : 'Requested changes'}</span>}<time datetime={message.created_at}>{new Date(message.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York', timeZoneName: 'short' })}</time>{message.actor !== reader && !message.read_at && <span class="unread">New</span>}</div>
      <p>{parts(message.body).map(part => part.href ? <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text)}</p>
    </li>
  )}</ol> : <p class="project-messages-empty">No messages yet.</p>}
  {closed ? <p class="project-messages-closed">This conversation is closed. You can still read its history.</p> :
    <form data-project-message-form>
      <label class="studio-field" for={reader === 'owner' ? 'owner-project-message' : 'client-project-message'}>Your message <small>Questions, direction, or an updated HTTPS link to your files. Files stay in your Drive, Dropbox, or WeTransfer account.</small></label>
      <div class="composer">
        <textarea class="studio-textarea" id={reader === 'owner' ? 'owner-project-message' : 'client-project-message'} name="body" rows="2" maxlength="4000" placeholder="Write a message…" required></textarea>
        <button type="submit" class="studio-button">Send</button>
      </div>
      <p class="studio-status" data-project-message-status role="status" aria-live="polite"></p>
    </form>}
</section>
<style>
  .project-messages { border-top: 1px solid var(--rule); padding: 2.5rem 0; }
  .project-messages-heading { display: flex; align-items: baseline; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .project-messages-kicker { margin: 0; color: var(--accent); font: 500 .78rem/1.4 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
  h2 { margin: 0; font: 400 clamp(2rem, 4vw, 3rem)/1.1 Newsreader, Georgia, serif; }
  .project-message-list { list-style: none; margin: 0 0 1.75rem; padding: 0; display: grid; gap: 1.1rem; max-width: 46rem; }
  .project-message-list li { display: grid; gap: .45rem; }
  .project-message-meta { display: flex; gap: .9rem; align-items: baseline; flex-wrap: wrap; font: .78rem/1.4 Inter, sans-serif; color: var(--studio-muted); }
  .project-message-meta strong { color: var(--ink); font-weight: 600; }
  .decision { padding: .05rem .5rem; border-radius: 1rem; font-weight: 600; background: color-mix(in srgb, var(--studio-done) 18%, var(--paper)); color: var(--ink); }
  .decision.changes, .decision.stopped { background: color-mix(in srgb, var(--accent) 14%, var(--paper)); }
  .unread { padding: .05rem .45rem; border-radius: 1rem; background: color-mix(in srgb, var(--accent) 14%, var(--paper)); color: var(--accent); font-weight: 500; }
  .project-message-list p { margin: 0; padding: .85rem 1rem; border: 1px solid var(--rule); border-radius: 2px; background: var(--studio-field); white-space: pre-wrap; overflow-wrap: anywhere; font: .98rem/1.6 Inter, sans-serif; }
  .project-message-list li.mine p { background: var(--studio-soft); border-color: transparent; }
  .project-message-list a { text-decoration: underline; text-underline-offset: .2em; }
  .project-messages-empty, .project-messages-closed { font: .95rem/1.6 Inter, sans-serif; color: var(--studio-muted); }
  .project-messages-closed { max-width: 46rem; padding: .9rem 1rem; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  form { display: grid; gap: .6rem; max-width: 46rem; }
  .composer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; align-items: end; }
  .composer .studio-textarea { min-height: 3.2rem; }
  .composer .studio-button { min-height: 3.2rem; padding-inline: 1.6rem; }
  @media (max-width: 30rem) { .composer { grid-template-columns: 1fr; } }
</style>
