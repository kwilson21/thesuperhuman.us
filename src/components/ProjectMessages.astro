---
import type { ProjectMessage } from '~/lib/audio-project-messages';
import { safeExternalUrl } from '~/lib/owner-model';

type Props = {
  messages: ProjectMessage[];
  endpoint: string;
  reader: 'owner' | 'client';
  closed: boolean;
};
const { messages, endpoint, reader, closed } = Astro.props;
const unread = messages.some(message => message.actor !== reader && !message.read_at);
function parts(body: string) {
  const result: { text: string; href?: string }[] = [];
  const links = /https:\/\/[^\s<>"']+/gi;
  let cursor = 0;
  for (const match of body.matchAll(links)) {
    const start = match.index ?? 0;
    if (start > cursor) result.push({ text: body.slice(cursor, start) });
    const link = match[0].replace(/[.,!?;:)\]]+$/, '');
    const href = safeExternalUrl(link);
    result.push(href ? { text: link, href } : { text: link });
    cursor = start + link.length;
  }
  if (cursor < body.length) result.push({ text: body.slice(cursor) });
  return result;
}
---
<section class="project-messages" data-project-messages data-endpoint={endpoint} data-unread={unread ? 'true' : 'false'} aria-labelledby="project-messages-heading">
  <div class="project-messages-heading"><p class="project-messages-kicker">Conversation</p><h2 id="project-messages-heading">Stay in the loop</h2></div>
  {messages.length ? <ol class="project-message-list">{messages.map(message =>
    <li class:list={{ mine: message.actor === reader }} data-unread-message={message.actor !== reader && !message.read_at ? message.id : undefined}>
      <div class="project-message-meta"><strong>{message.actor === reader ? 'You' : message.actor === 'owner' ? 'Kazon' : 'Client'}</strong><time datetime={message.created_at}>{new Date(message.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York', timeZoneName: 'short' })}</time></div>
      <p>{parts(message.body).map(part => part.href ? <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a> : part.text)}</p>
    </li>
  )}</ol> : <p class="project-messages-empty">No messages yet.</p>}
  {closed ? <p class="project-messages-closed">This conversation is closed. You can still read its history.</p> :
    <form data-project-message-form>
      <label for={reader === 'owner' ? 'owner-project-message' : 'client-project-message'}>Your message</label>
      <textarea id={reader === 'owner' ? 'owner-project-message' : 'client-project-message'} name="body" rows="4" maxlength="4000" required></textarea>
      <p class="project-messages-help">Share a question, direction, or updated HTTPS file link. Files stay in your Drive, Dropbox, or WeTransfer account.</p>
      <button type="submit">Send message <span aria-hidden="true">→</span></button>
      <p data-project-message-status role="status" aria-live="polite"></p>
    </form>}
</section>
<style>
  .project-messages { border-top: 1px solid #d8d2c9; padding: 2.5rem 0; }
  .project-messages-heading { display: flex; align-items: baseline; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .project-messages-kicker { margin: 0; color: #a4512f; font: 500 .78rem/1.4 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
  h2 { margin: 0; font: 400 clamp(2rem, 4vw, 3rem)/1.1 Newsreader, Georgia, serif; }
  .project-message-list { list-style: none; margin: 0 0 2rem; padding: 0; border-bottom: 1px solid #d8d2c9; }
  .project-message-list li { border-top: 1px solid #d8d2c9; padding: 1.25rem 0; max-width: 47rem; }
  .project-message-list li.mine { padding-left: clamp(0rem, 4vw, 3rem); }
  .project-message-meta { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; font: .8rem/1.4 Inter, sans-serif; }
  .project-message-meta strong { color: #a4512f; }
  .project-message-meta time { color: #66615a; }
  .project-message-list p { margin: .65rem 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 1rem/1.6 Inter, sans-serif; }
  .project-message-list a { text-decoration: underline; text-underline-offset: .2em; }
  .project-messages-empty,.project-messages-closed { font: 1rem/1.6 Inter, sans-serif; color: #514d47; }
  form { display: grid; gap: .85rem; max-width: 47rem; }
  label { font: 500 .9rem/1.4 Inter, sans-serif; }
  textarea { width: 100%; min-height: 7rem; padding: .9rem 1rem; border: 1px solid #9d968c; border-radius: 0; background: #fffdf9; font: 1rem/1.5 Inter, sans-serif; resize: vertical; }
  .project-messages-help { margin: 0; color: #66615a; font: .85rem/1.5 Inter, sans-serif; }
  button { justify-self: start; border: 0; border-bottom: 1px solid currentColor; background: none; padding: .5rem 0; cursor: pointer; font: 500 .9rem/1.4 Inter, sans-serif; }
  button:hover { color: #a4512f; }
  button:disabled { opacity: .5; cursor: wait; }
  [data-project-message-status] { min-height: 1.5rem; margin: 0; font: .9rem/1.5 Inter, sans-serif; }
</style>
