---
import PersonalName from '~/components/PersonalName.astro';
import { doors } from '~/data/work-with-me';
import { personalNameSegments } from '~/lib/personal-name';
interface Props {
  headingLevel?: 'h2' | 'h3';
  overrides?: Partial<Record<(typeof doors)[number]['id'], Partial<Pick<(typeof doors)[number], 'href' | 'label'>>>>;
  /* 'eager' where the doors render in the first screen (the Work with me hub); Home keeps them lazy. */
  loading?: 'lazy' | 'eager';
}
const { headingLevel = 'h3', overrides = {}, loading = 'lazy' } = Astro.props;
---
<div class="doors">
  {doors.map((door, index) => {
    const href = overrides[door.id]?.href ?? door.href;
    const label = overrides[door.id]?.label ?? door.label;
    return <article class="door" id={`door-${door.id}`}>
    <a class="door-art" href={href} tabindex="-1" aria-hidden="true"><img src={door.picture.src} width={door.picture.width} height={door.picture.height} alt="" loading={loading} fetchpriority={loading === 'eager' && index === 0 ? 'high' : undefined} /></a>
    {/* The caption is Inter, which has no name-mark cut yet, so the name inherits the caption face (website-system-plan.md, Deferred maintenance). */}
    <p class="door-caption">{personalNameSegments(door.caption).map(part => part.variant ? <PersonalName variant={part.variant} style="inherit" /> : part.text)}</p>
    {headingLevel === 'h2' ? <h2 class="door-title">{door.title}</h2> : <h3 class="door-title">{door.title}</h3>}
    <p class="door-line">{door.line}</p>
    <a class="door-button site-button" href={href}>{label}</a>
  </article>;
  })}
</div>
<style>
  .doors { display: grid; }
  .door { scroll-margin-top: 1.5rem; display: grid; }
  .door-art { display: block; aspect-ratio: 3 / 2; border: 1px solid var(--rule); border-radius: 3px; padding: 0; overflow: hidden; background: color-mix(in srgb, var(--rule) 50%, var(--paper)); }
  .door-art img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .door-caption { font-family: var(--font-sans); font-size: .78rem; color: var(--muted); margin: .7rem 0 .8rem; text-wrap: pretty; }
  .door-title { font-size: 1.55rem; line-height: 1.2; letter-spacing: -.02em; margin: 0 0 .35rem; }
  .door-line { font-size: 1.05rem; line-height: 1.5; color: var(--muted); max-width: 30ch; margin: 0 0 .9rem; text-wrap: pretty; }
  .door-button { justify-self: start; align-self: start; min-height: 44px; padding: .45rem 1.15rem; }
  /* Wide screens: each door is one row between hairline rules. The rows share one set of columns (subgrid), so the lines and buttons line up from door to door whatever wraps. */
  @media (min-width: 801px) {
    .doors { grid-template-columns: 216px minmax(0, 1fr) minmax(0, 1.15fr) auto; column-gap: 2rem; border-bottom: 1px solid var(--rule); }
    .door { grid-column: 1 / -1; grid-template-columns: subgrid; grid-template-areas: "art caption line button" "art title line button"; align-items: start; align-content: center; padding-block: 1.25rem; border-top: 1px solid var(--rule); }
    .door-art { grid-area: art; }
    .door-caption { grid-area: caption; margin: 0 0 .3rem; align-self: end; }
    .door-title { grid-area: title; margin: 0; }
    .door-line { grid-area: line; margin: 0; align-self: center; max-width: 34ch; }
    .door-button { grid-area: button; align-self: center; justify-self: end; }
  }
  /* Until the line has room for its own column, it sits under the title, so it does not wrap to a few words a line. */
  @media (min-width: 801px) and (max-width: 1199px) {
    .doors { grid-template-columns: 216px minmax(0, 1fr) auto; }
    .door { grid-template-rows: auto auto 1fr; grid-template-areas: "art caption button" "art title button" "art line button"; align-content: start; }
    .door-caption { align-self: start; }
    .door-line { align-self: start; margin-top: .35rem; }
  }
  @media (max-width: 800px) {
    .doors { grid-template-columns: 1fr; row-gap: 1.75rem; }
    .door { grid-template-columns: 104px 1fr; grid-template-areas: "art caption" "art title" "art line" "art button"; column-gap: 1rem; align-items: start; }
    .door-art { grid-area: art; }
    .door-caption { grid-area: caption; margin: 0 0 .4rem; }
    .door-title { grid-area: title; font-size: 1.4rem; }
    .door-line { grid-area: line; }
    .door-button { grid-area: button; }
  }
  /* Near 362px the button stops fitting beside the picture on one line, so at 370px and below it moves under the picture (with room for engine differences). */
  @media (max-width: 370px) {
    .door { grid-template-areas: "art caption" "art title" "art line" "button button"; }
  }
</style>
