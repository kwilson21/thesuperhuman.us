---
import '~/styles/studio.css';

type Props = { stage: string; bookingPaid?: boolean; size?: 'full' | 'mini' };
const { stage, bookingPaid = false, size = 'full' } = Astro.props;
// "Booking paid" is derived from Stripe while the stored stage stays Accepted.
const stages = [
  ['files_under_review', 'Files under review'],
  ['accepted', 'Accepted'],
  ['booking_paid', 'Booking paid'],
  ['in_progress', 'In progress'],
  ['review_ready', 'Review ready'],
  ['revision_in_progress', 'Revision in progress'],
  ['final_files_ready', 'Final files ready'],
  ['complete', 'Complete'],
] as const;
const shown = stage === 'accepted' && bookingPaid ? 'booking_paid' : stage;
const current = Math.max(0, stages.findIndex(([key]) => key === shown));
const state = (index: number) => index < current || shown === 'complete' ? 'done' : index === current ? 'current' : 'upcoming';
---
<div class:list={['stage-track', size]}>
  <ol aria-label={`Stage ${current + 1} of ${stages.length}: ${stages[current][1]}`}>
    {stages.map(([key, label], index) => <li class={state(index)} aria-current={index === current ? 'step' : undefined} data-stage={key}>
      <span class="stage-dot" aria-hidden="true"></span><span class="stage-name">{label}</span>
    </li>)}
  </ol>
  {size === 'full' && <p class="stage-summary" aria-hidden="true">Stage {current + 1} of {stages.length} · <strong>{stages[current][1]}</strong></p>}
</div>
<style>
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); }
  li { position: relative; display: grid; justify-items: center; gap: .65rem; text-align: center; }
  /* The connecting line runs from the previous dot to this one. */
  li:not(:first-child)::before { content: ''; position: absolute; top: .5rem; right: 50%; width: 100%; height: 1.5px; background: var(--studio-line); }
  li.done:not(:first-child)::before, li.current:not(:first-child)::before { background: var(--studio-done); }
  .stage-dot { position: relative; z-index: 1; width: 1rem; height: 1rem; border-radius: 50%; border: 1.5px solid var(--studio-line); background: var(--paper); }
  .done .stage-dot { border-color: var(--studio-done); background: var(--studio-done); }
  .current .stage-dot { border: 2px solid var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 14%, transparent); }
  .stage-name { max-width: 9ch; color: var(--studio-muted); font: 400 .78rem/1.3 Inter, sans-serif; text-wrap: balance; }
  .done .stage-name { color: var(--ink); }
  .current .stage-name { color: var(--accent); font-weight: 500; }
  .stage-summary { display: none; margin: .9rem 0 0; color: var(--studio-muted); font: .85rem/1.4 Inter, sans-serif; }
  .stage-summary strong { color: var(--accent); font-weight: 500; }
  .mini ol { width: 9.5rem; }
  .mini li { gap: 0; }
  .mini li:not(:first-child)::before { top: .3rem; }
  .mini .stage-dot { width: .6rem; height: .6rem; border-width: 1.5px; }
  .mini .current .stage-dot { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
  .mini .stage-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 45rem) {
    .full .stage-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .full li { gap: 0; }
    .stage-summary { display: block; }
  }
</style>
