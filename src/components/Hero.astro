---
import studio from "~/assets/site/studio-v1.webp";
import PersonalName from "~/components/PersonalName.astro";
import StudioLife from "~/components/home/StudioLife.astro";
import { tallyMilestones } from "~/data/project-stories/tally";

// Tally's newest published journal entry; the monitor types its headline when a visitor points at it. Of entries on
// the same day it takes the first listed, the one the journal shows first.
const latest = tallyMilestones.reduce((newest, entry) =>
	entry.day > newest.day ? entry : newest,
);

// The objects on the desk, in the artwork's own pixels (1536 x 1024), each a way into the site. The touch pin (`short`)
// is a word from the label, so a visitor using speech input can say what they see.
const objects = [
	{
		id: "monitor",
		label: "What I’m building",
		short: "Building",
		href: "/building",
		x: 755,
		y: 118,
		w: 600,
		h: 420,
	},
	{
		id: "headphones",
		label: "Listen to a mix and master",
		short: "Listen",
		href: "/audio/portfolio",
		// Its area stops short of the headband's tip, which is off screen at widths from 1233 to about 1290 pixels, so
		// its focus ring stays on screen.
		x: 1075,
		y: 590,
		w: 360,
		h: 200,
	},
	{
		id: "notebook",
		label: "What I’m writing",
		short: "Writing",
		href: "/writing/ai-gives-you-speed",
		x: 805,
		y: 745,
		w: 500,
		h: 210,
	},
	{
		id: "controller",
		label: "Kaillera Next, netplay for old games",
		short: "Netplay",
		href: "/building/kaillera-next",
		x: 585,
		y: 692,
		w: 285,
		h: 98,
	},
];

const percent = (value: number, of: number) =>
	`${((value / of) * 100).toFixed(3)}%`;
---
<section class="studio-hero site-shell" aria-labelledby="intro-title" data-studio>
  <div class="studio-copy">
    <h1 id="intro-title"><PersonalName variant="full" style="display" breakAfterFirst /></h1>
    <p class="studio-tagline">Software, sound, and things worth exploring.</p>
    <p class="studio-intro">I build software, design websites, and mix and master music.</p>
    <div class="site-links">
      <a class="site-button" href="/software/start">Start a project</a>
      <a class="site-link" href="/building">Explore what I’m building <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="studio-art">
    <div class="studio-scene" data-studio-scene>
      <img src={studio.src} width={studio.width} height={studio.height} alt="" loading="eager" fetchpriority="high" />
      <StudioLife headline={`tally · ${latest.title}`} />
      <nav class="studio-objects" aria-label="Around the studio">
        {objects.map(object => <a class="studio-object" href={object.href} data-studio-object={object.id} style={`left:${percent(object.x, 1536)};top:${percent(object.y, 1024)};width:${percent(object.w, 1536)};height:${percent(object.h, 1024)}`}><span class="studio-object-label">{object.label} <span aria-hidden="true">→</span></span><span class="studio-object-pin" aria-hidden="true">{object.short}</span></a>)}
      </nav>
    </div>
  </div>
</section>
<script>
  import { setupStudioObjects } from '~/scripts/studio-objects';

  setupStudioObjects();
</script>
<style>
  .studio-hero { position: relative; min-height: 610px; padding-block: 3rem 5rem; isolation: isolate; }
  .studio-copy { position: relative; z-index: 1; max-width: 440px; }
  h1 { font-size: clamp(5rem, 8.8vw, 7.5rem); line-height: .88; letter-spacing: -.065em; margin: 0 0 1.65rem; }
  .studio-tagline { font-size: clamp(1.8rem, 2.8vw, 2.25rem); line-height: 1.14; letter-spacing: -.025em; max-width: 420px; margin: 0 0 1.1rem; }
  .studio-intro { max-width: 340px; color: var(--muted); font-size: 1.125rem; line-height: 1.5; margin: 0 0 1.7rem; }
  /* The studio sits still: it neither drifts with the scroll nor leans toward the pointer. */
  .studio-art { position: absolute; z-index: -1; width: 84%; right: -5%; top: 0; pointer-events: none; }
  /* The overlay shares the image's box and mask, so it fades out exactly where the picture does. */
  .studio-scene { position: relative; }
  .studio-scene :global(img) { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  /* Each object on the desk is a link over its own area of the picture. The label is the link's text: it shows on
     keyboard focus, and on hover with a fine pointer. The headphones sit above the notebook where their areas meet, and
     their label hangs from their right edge so it stays on screen. */
  .studio-objects { position: absolute; inset: 0; }
  .studio-object { position: absolute; display: block; pointer-events: auto; border-radius: 6px; border-bottom: 0; padding: 0; color: var(--ink); text-decoration: none; }
  .studio-object:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .studio-object[data-studio-object="headphones"] { z-index: 1; }
  /* The object whose label shows rises above the others, so no other link covers its label. */
  .studio-object:focus-visible { z-index: 2; }
  .studio-object[data-studio-object="notebook"] { --pin-y: 65%; }
  /* A label takes clicks only while it shows. The strip under it bridges the gap to its object, so the pointer can
     move onto the label without it disappearing (WCAG 1.4.13). */
  .studio-object-label { position: absolute; left: 0; bottom: calc(100% + .35rem); width: max-content; max-width: 16rem; padding: .3rem .6rem; border: 1px solid var(--rule); border-radius: 3px; background: var(--paper); font: .875rem/1.35 var(--font-serif); white-space: normal; opacity: 0; pointer-events: none; }
  .studio-object-label::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: calc(.35rem + 1px); }
  .studio-object[data-studio-object="headphones"] .studio-object-label { left: auto; right: 0; }
  .studio-object-label span { color: var(--accent); }
  .studio-object:focus-visible .studio-object-label { opacity: 1; pointer-events: auto; }
  @media (hover: hover) and (pointer: fine) {
    .studio-object:hover { z-index: 3; }
    .studio-object:hover .studio-object-label { opacity: 1; pointer-events: auto; }
  }
  /* Escape hides a showing label until the visitor points at or focuses an object again (studio-objects.ts). */
  .studio-scene[data-labels-dismissed] .studio-object .studio-object-label { opacity: 0; pointer-events: none; }
  /* Touch screens have no hover, and on a narrow screen the full labels would cover the copy and run off the edge, so
     each object shows a one-word pin instead; the full label stays the link's name for screen readers. Each area is
     at least 44px tall to tap. */
  .studio-object-pin { display: none; }
  @media (hover: none), (pointer: coarse), (max-width: 800px) {
    .studio-object-label { width: 1px; height: 1px; padding: 0; border: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .studio-object-pin { display: block; position: absolute; left: var(--pin-x, 50%); top: var(--pin-y, 50%); transform: translate(-50%, -50%); padding: .1rem .5rem; border: 1px solid var(--rule); border-radius: 3px; background: var(--paper); font: .875rem/1.4 var(--font-serif); white-space: nowrap; }
    .studio-object::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: max(100%, 44px); transform: translateY(-50%); }
  }
  @media (prefers-reduced-motion: no-preference) { .studio-object-label { transition: opacity 180ms var(--ease-site); } }
  .studio-scene :global(img), .studio-scene :global(.studio-life) { mask-image: linear-gradient(to right, transparent, #000 18%, #000 94%, transparent), linear-gradient(to bottom, transparent, #000 12%, #000 80%, transparent); mask-composite: intersect; }
  @media (prefers-reduced-motion: no-preference) {
    .studio-copy > * { animation: studio-rise 900ms var(--ease-site) both; }
    .studio-copy > :nth-child(2) { animation-delay: 110ms; }
    .studio-copy > :nth-child(3) { animation-delay: 220ms; }
    .studio-copy > :nth-child(4) { animation-delay: 330ms; }
    .studio-art { animation: studio-settle 1400ms var(--ease-site) 120ms both; }
  }
  @keyframes studio-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes studio-settle { from { opacity: 0; transform: translateY(14px) scale(.985); } }
  @media (max-width: 1232px) and (min-width: 801px) {
    .studio-hero { min-height: 560px; }
    .studio-copy { max-width: 360px; }
    .studio-art { top: 40px; width: 76%; right: 0; }
  }
  @media (max-width: 800px) {
    .studio-hero { min-height: 0; padding-top: 1.5rem; padding-bottom: 0; }
    .studio-copy { max-width: 480px; }
    h1 { font-size: clamp(4.7rem, 16vw, 6rem); margin-bottom: 1.25rem; }
    .studio-tagline { font-size: clamp(1.7rem, 5.8vw, 2.1rem); max-width: 410px; }
    .studio-intro { font-size: 1.1rem; max-width: 350px; }
    .studio-art { position: relative; top: auto; right: auto; width: calc(100% + 3rem); margin: -1rem -1.5rem -1rem; }
    .studio-scene :global(img), .studio-scene :global(.studio-life) { mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 85%, transparent); }
  }
</style>
