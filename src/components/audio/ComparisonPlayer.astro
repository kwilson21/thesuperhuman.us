---
import { musicFile, type MusicCatalog, type Recording } from '~/lib/music-catalog';
import { waveformGeometry } from '~/lib/waveform';
import PlayIcon from './PlayIcon.astro';
interface Props { example: MusicCatalog['examples'][number]; recording: Recording; compact?: boolean }
const { example, recording, compact = false } = Astro.props;
const labels = example.service === 'mastering' ? ['Mix', 'Master'] : ['Before mixing', 'Mixed version'];
---
<div class:list={['comparison-player', compact && 'comparison-player--compact']} data-comparison data-duration={recording.duration} data-title={recording.title}>
  <div class="comparison-lanes">
    {(['before', 'after'] as const).map((side, index) => <section class="comparison-lane" data-lane={side}>
      <div class="lane-heading"><span class="lane-letter">{index === 0 ? 'A' : 'B'}</span><h3>{labels[index]}</h3><span class="lane-selected" aria-hidden="true">Selected</span></div>
      {example.waveforms && <div class="comparison-waveform-stage"><svg class="comparison-waveform" viewBox={`0 0 ${example.waveforms[side].length * 4} 64`} preserveAspectRatio="none" aria-hidden="true">{example.waveforms[side].map((height, i) => <line x1={i * 4 + 2} x2={i * 4 + 2} y1={32 - Math.max(1, height * 75)} y2={32 + Math.max(1, height * 75)} stroke="currentColor" stroke-width="2" />)}</svg><span class="comparison-playhead" aria-hidden="true" hidden></span></div>}
      <audio controls controlslist="nodownload" preload="none" data-version={side} data-label={labels[index]} data-offset={example.alignment[side]} data-loudness={example.loudness?.[side]} aria-label={`${recording.title}: ${labels[index]}`} src={musicFile(recording.id, example[side])}></audio>
    </section>)}
  </div>
  {compact ? <>
    <div class="compact-waveform-stage">
      <button class="round-play compact-waveform-play" data-comparison-play aria-label={`Play ${recording.title}: ${labels[0]}`}><PlayIcon /></button>
      <div class="compact-waveform-column">
        <div class="compact-waveform-label"><span data-compact-version-label>{labels[0]}</span><span data-comparison-time class="comparison-time">0:00 / {Math.floor(recording.duration / 60)}:{String(Math.floor(recording.duration % 60)).padStart(2, '0')}</span></div>
        {example.waveforms && <svg class="compact-waveform" data-compact-waveform data-waveform-before={JSON.stringify(example.waveforms.before)} data-waveform-after={JSON.stringify(example.waveforms.after)} data-version="before" viewBox={`0 0 ${example.waveforms.before.length * 4} 64`} preserveAspectRatio="none" aria-hidden="true">
          {example.waveforms.before.map((amplitude, i) => { const { y1, y2 } = waveformGeometry([amplitude])[0]; return <line data-compact-wave-line x1={i * 4 + 2} x2={i * 4 + 2} y1={y1} y2={y2} stroke="currentColor" stroke-width="2" />; })}
        </svg>}
        <input class="compact-waveform-seek" data-comparison-seek type="range" min="0" max={recording.duration} step="0.1" value="0" aria-label={`Seek in ${labels[0]}`} />
      </div>
    </div>
    <div class="compact-choice-row">
      <div class="comparison-switch" role="group" aria-label="Choose version">
        <button data-select-version="before" aria-label={labels[0]} aria-pressed="true"><span aria-hidden="true">A</span><span>{example.service === 'mastering' ? 'Mix' : 'Unmixed'}</span></button><button data-select-version="after" aria-label={labels[1]} aria-pressed="false"><span aria-hidden="true">B</span><span>{example.service === 'mastering' ? 'Master' : 'Mix'}</span></button>
      </div>
      {example.loudness && <label class="comparison-match"><input type="checkbox" data-match-level /> Match loudness</label>}
    </div>
  </> : <div class="comparison-controls" hidden>
    <button class="round-play" data-comparison-play aria-label={`Play comparison: ${recording.title}`}><PlayIcon /></button>
    <span class="comparison-time" data-comparison-time>0:00</span>
    <div class="comparison-switch" role="group" aria-label="Choose version">
      <button data-select-version="before" aria-label={labels[0]} aria-pressed="true">A <span>{example.service === 'mastering' ? 'Mix' : 'Unmixed'}</span></button><button data-select-version="after" aria-label={labels[1]} aria-pressed="false">B <span>{example.service === 'mastering' ? 'Master' : 'Mix'}</span></button>
    </div>
    <label class="comparison-volume">Volume <input data-comparison-volume type="range" min="0" max="1" step="0.05" value="1" /></label>
    {example.loudness && <label class="comparison-match"><input type="checkbox" data-match-level /> Match loudness</label>}
    <label class="comparison-seek">Playback position <input data-comparison-seek type="range" min="0" max={recording.duration} step="0.1" value="0" /></label>
  </div>}
  {!compact && <p class="music-note comparison-instruction">Switch versions. Keep your place. Click or tap either waveform to seek.</p>}
  <details class="comparison-about"><summary>{compact ? 'About this A/B' : 'About this comparison'}</summary><p>{example.comparisonNote}</p>{example.loudness && <p>Match loudness lowers the louder export using measured whole-song loudness. Original export levels play when unchecked.</p>}</details>
  <p class="media-status" data-comparison-status role="status"></p>
</div>
<style>
.comparison-player{border:1px solid var(--rule);border-radius:4px;padding:1rem}.comparison-about{font-size:.8rem;color:var(--muted);margin-top:.5rem}.comparison-about summary{cursor:pointer}.comparison-match{display:flex;align-items:center;gap:.4rem;font-size:.8rem}.comparison-match input{accent-color:var(--accent)}.comparison-lanes{position:relative}.comparison-lane{padding:.6rem 0;border-bottom:1px solid var(--rule);color:var(--muted)}.comparison-lane[data-lane=after]{color:var(--accent)}.lane-heading{display:flex;align-items:center;gap:.7rem;font-family:Inter,sans-serif}.lane-heading h3{font-size:.9rem}.lane-letter{font-size:.8rem;border:1px solid currentColor;display:grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%}.lane-selected{margin-left:auto;font-size:.7rem;opacity:0}.comparison-lane[data-selected=true] .lane-selected{opacity:1}.comparison-waveform-stage{position:relative;margin-top:.4rem}.comparison-waveform{display:block;width:100%;height:52px}.comparison-playhead{position:absolute;left:var(--position,0%);top:0;bottom:0;border-left:1px solid var(--accent);pointer-events:none}.comparison-controls{display:flex;align-items:center;flex-wrap:wrap;gap:1rem;margin-top:1.25rem}.round-play{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--paper);flex-shrink:0}.round-play :global(svg){width:17px;height:17px}.round-play[data-playing=true] :global(.play-symbol){display:none}.round-play:not([data-playing=true]) :global(.pause-symbol){display:none}.comparison-time{font: .8rem Inter,sans-serif;font-variant-numeric:tabular-nums;min-width:5.5rem}.comparison-switch{display:flex;justify-self:start;width:max-content;border:1px solid var(--rule);border-radius:3px;overflow:hidden}.comparison-switch button{min-height:44px;padding:.5rem .85rem;font:.8rem Inter,sans-serif}.comparison-switch button[aria-pressed=true]{background:var(--ink);color:var(--paper)}.comparison-switch button[data-select-version=after][aria-pressed=true]{background:var(--accent)}.comparison-switch span{margin-left:.3rem}.comparison-volume{margin-left:auto;display:flex;align-items:center;gap:.5rem;font:.7rem Inter,sans-serif}.comparison-volume input{width:70px;accent-color:var(--accent)}.comparison-seek{width:100%;font: .75rem Inter,sans-serif;color:var(--muted)}.comparison-seek input{display:block;width:100%;margin-top:.5rem;accent-color:var(--accent)}.comparison-instruction{margin-top:.8rem}.comparison-controls button{cursor:pointer}.comparison-player [hidden]{display:none!important}@media(max-width:420px){.comparison-controls{gap:.65rem}.comparison-volume{margin-left:0}.comparison-switch button{padding:.5rem .6rem}.comparison-time{min-width:2.2rem}}

.comparison-waveform{height:44px}.comparison-controls{display:grid;grid-template-columns:44px 5.5rem minmax(50px,1fr) auto;gap:.65rem;margin-top:.8rem}.comparison-controls .round-play{width:42px;height:42px}.comparison-seek{grid-column:3;grid-row:1;font-size:0}.comparison-seek input{margin:0}.comparison-switch{grid-column:4;grid-row:1}.comparison-volume{grid-column:1/3;grid-row:2;margin-left:0}.comparison-match{grid-column:3/5;grid-row:2;justify-self:end}.comparison-instruction{font-size:.75rem}.comparison-switch button{min-height:40px;padding:.4rem .6rem}@media(max-width:500px){.comparison-controls{grid-template-columns:42px 1fr auto}.comparison-switch{grid-column:3}.comparison-seek{grid-column:1/-1;grid-row:3}.comparison-volume{grid-column:1/3}.comparison-match{grid-column:3;font-size:.7rem}.comparison-switch span{display:none}.comparison-about{margin-top:.5rem}}
.comparison-player[data-initialized="true"] .comparison-waveform{cursor:pointer}
.comparison-player--compact{padding:.5rem .6rem}.comparison-player--compact .compact-waveform-stage,.comparison-player--compact .compact-choice-row{display:none}.comparison-player--compact[data-initialized="true"]:not([data-audio-fallback="true"]) .comparison-lanes{display:none}.comparison-player--compact[data-initialized="true"]:not([data-audio-fallback="true"]) .compact-waveform-stage{display:grid}.comparison-player--compact[data-initialized="true"]:not([data-audio-fallback="true"]) .compact-choice-row{display:flex}.comparison-player--compact[data-audio-fallback="true"] .comparison-lanes{display:block}.comparison-player--compact .compact-waveform-stage{display:grid;grid-template-columns:44px minmax(0,1fr);align-items:center;gap:.65rem}.comparison-player--compact .compact-waveform-play{width:44px;height:44px;min-width:44px;min-height:44px;padding:0}.comparison-player--compact .compact-waveform-column{min-width:0}.comparison-player--compact .compact-waveform{display:block;width:100%;height:38px;color:var(--ink);pointer-events:none;transition:color 160ms ease}.comparison-player--compact .compact-waveform[data-version="after"]{color:var(--accent)}.comparison-player--compact .compact-waveform line{transition:y1 180ms ease,y2 180ms ease}.comparison-player--compact .compact-waveform-label{display:flex;justify-content:space-between;gap:.5rem;color:var(--muted);font:.68rem Inter,sans-serif;line-height:1.2}.comparison-player--compact .compact-waveform-label [data-compact-version-label]{font-weight:600}.comparison-player--compact .compact-waveform-label .comparison-time{min-width:0;font-size:.68rem}.comparison-player--compact .compact-waveform-seek{appearance:none;display:block;width:100%;height:24px;margin:0;padding:0;background:transparent;cursor:pointer;touch-action:pan-y}.comparison-player--compact .compact-waveform-seek::-webkit-slider-runnable-track{height:2px;background:linear-gradient(to right,var(--accent) 0 var(--position,0%),var(--rule) var(--position,0%) 100%)}.comparison-player--compact .compact-waveform-seek::-webkit-slider-thumb{appearance:none;width:8px;height:8px;margin-top:-3px;border:0;border-radius:50%;background:var(--accent)}.comparison-player--compact .compact-waveform-seek::-moz-range-track{height:2px;border:0;background:linear-gradient(to right,var(--accent) 0 var(--position,0%),var(--rule) var(--position,0%) 100%)}.comparison-player--compact .compact-waveform-seek::-moz-range-thumb{width:8px;height:8px;border:0;border-radius:50%;background:var(--accent)}.comparison-player--compact .compact-waveform-seek:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}.comparison-player--compact .compact-waveform-play:focus-visible,.comparison-player--compact .comparison-switch button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.comparison-player--compact .compact-choice-row{display:flex;align-items:center;gap:.6rem;margin-top:.2rem}.comparison-player--compact .comparison-switch{margin:0}.comparison-player--compact .comparison-switch button{display:flex;align-items:center;gap:.3rem;min-height:44px;padding:.35rem .7rem;font-size:.78rem}.comparison-player--compact .comparison-switch button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}.comparison-player--compact .comparison-switch button[data-select-version="after"][aria-pressed="true"]{background:var(--accent)}.comparison-player--compact .comparison-switch button span:first-child{font-size:.68rem;opacity:.75}.comparison-player--compact .comparison-switch span{display:inline}.comparison-player--compact .comparison-match{margin-left:auto;min-height:40px;font-size:.72rem;white-space:nowrap}.comparison-player--compact .comparison-about{font-size:.75rem}.comparison-player--compact .media-status{margin:.25rem 0 0;font-size:.75rem}.comparison-player--compact[data-audio-fallback="true"] .compact-waveform-stage,.comparison-player--compact[data-audio-fallback="true"] .compact-choice-row{display:none}@media(prefers-reduced-motion:reduce){.comparison-player--compact .compact-waveform,.comparison-player--compact .compact-waveform line{transition:none}}
</style>
