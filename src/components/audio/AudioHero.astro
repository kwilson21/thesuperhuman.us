---
import headphones from '~/assets/site/headphones-v1.webp';
import { mainSitePath, audioPath } from '~/lib/host-routing';
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const mainHref = (path: string) => mainSitePath(host, path);
---
<header class="audio-hero">
  <div><p class="page-kicker"><a href={mainHref('/about')}>About</a> / Audio</p><h1 class="page-title">Audio<br />engineering.</h1><p class="page-lede">I studied audio production at Middle Tennessee State University. Audio is still part of my life.</p><div class="site-links"><a class="site-button" href={audioPath(host, '/services')}>Audio services</a><a class="site-button site-button-outline" href="#book">Discuss a project</a></div></div>
  <img class="audio-art" src={headphones.src} alt="" width={headphones.width} height={headphones.height} fetchpriority="high" />
</header>
<style>
  .audio-hero { display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; gap: 2rem; padding-block: 1rem 3rem; }
  .audio-hero .page-lede { max-width: 32ch; font-size: 1.25rem; line-height: 1.6; margin-block: 1.5rem 2rem; }
  .audio-hero img { width: 100%; height: auto; mix-blend-mode: multiply; }
  @media(max-width: 800px) { .audio-hero { grid-template-columns: 1fr; gap: 1rem; }.audio-hero img { max-width: 580px; margin-inline: auto; } }
</style>
