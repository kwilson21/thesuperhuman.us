---
import { AUDIO_SERVICES, DELIVERY_METHODS } from '~/lib/audio-validation';
const turnstileSiteKey = Astro.locals.runtime.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<form id="audio-form" class="site-form" data-available={Boolean(turnstileSiteKey)} novalidate>
  <noscript>
    <p class="text-sm" style="color: var(--accent);">
      This form requires JavaScript. Email
      <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>
      directly.
    </p>
  </noscript>

  <div class="form-pair">
    <div>
      <label  for="af-name">Name</label>
      <input id="af-name" name="name" autocomplete="name" type="text" required maxlength="100" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent" />
      <p hidden data-form-error="name" style="color: var(--accent);"></p>
    </div>
    <div>
      <label  for="af-email">Email</label>
      <input id="af-email" name="email" autocomplete="email" type="email" required maxlength="120" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent" />
      <p hidden data-form-error="email" style="color: var(--accent);"></p>
    </div>
  </div>

  <fieldset>
    <legend class="mb-3">Service interest</legend>
    <div class="flex flex-wrap gap-2">
      {AUDIO_SERVICES.map((s) => (
        <label class="af-chip cursor-pointer">
          <input type="checkbox" name="services" value={s} class="sr-only peer" />
          <span class="inline-block border border-rule px-3 py-1.5 text-sm rounded-full capitalize peer-checked:bg-ink peer-checked:text-paper peer-checked:border-ink peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent peer-focus-visible:outline-offset-2">
            {s}
          </span>
        </label>
      ))}
    </div>
    <p hidden data-form-error="services" style="color: var(--accent);"></p>
  </fieldset>

  <div class="form-pair">
    <div>
      <label  for="af-tracks">Number of tracks <span class="text-muted normal-case tracking-normal">(optional)</span></label>
      <input id="af-tracks" name="trackCount" type="number" min="1" max="1000" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent" />
      <p hidden data-form-error="trackCount" style="color: var(--accent);"></p>
    </div>
    <div>
      <label  for="af-date">Target delivery date</label>
      <input id="af-date" name="targetDate" type="date" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent" />
      <label class="inline-flex items-center gap-2 mt-2 text-sm">
        <input type="checkbox" name="flexible" /> Flexible
      </label>
      <p hidden data-form-error="targetDate" style="color: var(--accent);"></p>
    </div>
  </div>

  <div>
    <label  for="af-references">Reference tracks <span class="text-muted normal-case tracking-normal">(optional)</span></label>
    <textarea id="af-references" name="references" rows={2} maxlength="2000" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent"></textarea><p hidden data-form-error="references"></p>
  </div>

  <div>
    <label  for="af-delivery">File delivery method</label>
    <select id="af-delivery" name="delivery" required class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent">
      <option value="">Pick one</option>
      {DELIVERY_METHODS.map((d) => <option value={d}>{d}</option>)}
    </select>
    <p hidden data-form-error="delivery" style="color: var(--accent);"></p>
  </div>

  <div>
    <label  for="af-notes">Project notes</label>
    <textarea id="af-notes" name="notes" rows={5} required minlength="40" maxlength="4000" class="w-full border border-rule bg-paper px-3 py-2 text-base rounded-sm focus:outline-none focus:border-accent"></textarea>
    <p hidden data-form-error="notes" style="color: var(--accent);"></p>
  </div>

  {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-hint">The form is unavailable right now. You can email me below.</p>}
  <p hidden data-form-error="turnstileToken" style="color: var(--accent);"></p>

  <div>
    <button type="submit" disabled class="site-button">Send inquiry</button>
    <p id="af-status" data-form-status role="status" tabindex="-1"></p>
  </div>
<p class="form-hint">Prefer email? <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a></p>
</form>

<div id="audio-success" class="form-success" role="status" tabindex="-1" hidden><h3>Inquiry received.</h3><p>Thanks for sharing your project. I’ll review the details.</p></div>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
<script>
  import { setupFormSubmission } from '~/scripts/form-submission';
  const form = document.getElementById('audio-form') as HTMLFormElement;
  setupFormSubmission({ form, endpoint: '/api/audio-inquiry', success: document.getElementById('audio-success')!, payload: data => ({
    name: String(data.get('name') ?? ''), email: String(data.get('email') ?? ''), services: data.getAll('services').map(String),
    trackCount: data.get('trackCount') ? Number(data.get('trackCount')) : null,
    targetDate: String(data.get('targetDate') ?? ''), flexible: data.get('flexible') === 'on',
    references: String(data.get('references') ?? ''), delivery: String(data.get('delivery') ?? ''), notes: String(data.get('notes') ?? ''),
  }) });
</script>
