function withinRange(figure: int, low: int, high: int): int
  requires (low <= high)
{
  if (figure < low) then
    low
  else
    if (figure > high) then
      high
    else
      figure
}

lemma withinRange_ensures(figure: int, low: int, high: int)
  requires (low <= high)
  ensures (low <= withinRange(figure, low, high))
  ensures (withinRange(figure, low, high) <= high)
