}

function estimateHigh(halfDays: int, dayValueCents: int, contingencyPercent: int): int
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
  requires (contingencyPercent >= 0)
{
  var twice := twiceExactHigh(halfDays, dayValueCents, contingencyPercent);
  upToRounding(JSFloorDiv((twice + 1), 2))
}

lemma estimateHigh_ensures(halfDays: int, dayValueCents: int, contingencyPercent: int)
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
  requires (contingencyPercent >= 0)
  ensures (JSRem(estimateHigh(halfDays, dayValueCents, contingencyPercent), 5000) == 0)
  ensures ((2 * estimateHigh(halfDays, dayValueCents, contingencyPercent)) >= twiceExactHigh(halfDays, dayValueCents, contingencyPercent))
  ensures ((2 * (estimateHigh(halfDays, dayValueCents, contingencyPercent) - 5000)) < twiceExactHigh(halfDays, dayValueCents, contingencyPercent))
