}

function estimateLow(halfDays: int, dayValueCents: int): int
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
{
  upToRounding(exactLow(halfDays, dayValueCents))
}

lemma estimateLow_ensures(halfDays: int, dayValueCents: int)
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
  ensures (JSRem(estimateLow(halfDays, dayValueCents), 5000) == 0)
  ensures (estimateLow(halfDays, dayValueCents) >= exactLow(halfDays, dayValueCents))
  ensures ((estimateLow(halfDays, dayValueCents) - exactLow(halfDays, dayValueCents)) < 5000)
