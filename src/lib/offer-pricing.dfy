// Generated by lsc from offer-pricing.ts

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function JSRem(a: int, b: int): int
  requires b != 0
{
  var r := (if a < 0 then -a else a) % (if b < 0 then -b else b);
  if a < 0 then -r else r
}

function upToRounding(cents: int): int
  requires (cents >= 0)
{
  var rest := JSRem(cents, ROUNDING_CENTS);
  if (rest == 0) then
    cents
  else
    (cents + (ROUNDING_CENTS - rest))
}

lemma upToRounding_ensures(cents: int)
  requires (cents >= 0)
  ensures (JSRem(upToRounding(cents), 5000) == 0)
  ensures (upToRounding(cents) >= cents)
  ensures ((upToRounding(cents) - cents) < 5000)
{
}

function exactLow(halfDays: int, dayValueCents: int): int
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
{
  (halfDays * JSFloorDiv(dayValueCents, 2))
}

lemma exactLow_ensures(halfDays: int, dayValueCents: int)
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
  ensures (exactLow(halfDays, dayValueCents) >= 0)
{
}

function twiceExactHigh(halfDays: int, dayValueCents: int, contingencyPercent: int): int
  requires (halfDays >= 0)
  requires (dayValueCents >= 0)
  requires (contingencyPercent >= 0)
{
  ((halfDays * JSFloorDiv(dayValueCents, 100)) * (100 + contingencyPercent))
}

