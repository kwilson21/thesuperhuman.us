---
import '~/styles/global.css';
import '~/styles/studio.css';
import PersonalName from '~/components/PersonalName.astro';
interface Props {
  title: string;
}
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>{Astro.props.title}</title><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..700&family=Inter:wght@400;500;600&display=swap" /></head><body><a class="skip-link" href="#agreement-main">Skip to agreement</a><main class="site-shell" id="agreement-main" tabindex="-1"><header><PersonalName /><p class="page-kicker">Private agreement</p></header><slot /></main></body></html>
<style is:global>.agreement-form {display:grid;gap:1.2rem;max-width:42rem;min-width:0}.agreement-form label {display:grid;gap:.4rem}.agreement-form input,.agreement-form textarea{max-width:100%;min-width:0}.agreement-text {white-space:pre-wrap;overflow-wrap:anywhere;font:400 1rem/1.7 Inter,system-ui,sans-serif;border-top:1px solid var(--rule);padding-top:1.5rem;max-width:100%}.agreement-section {margin:2rem 0;min-width:0}.agreement-meta {overflow-wrap:anywhere;font-size:.8rem;color:var(--muted)}.agreement-status {margin:1rem 0;overflow-wrap:anywhere}fieldset{min-width:0}h1{overflow-wrap:anywhere}</style>
