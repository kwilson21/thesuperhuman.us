---
import '~/styles/global.css';
import '~/styles/studio.css';
import PersonalName from '~/components/PersonalName.astro';
interface Props {
  title: string;
  step?: number;
}
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="referrer" content="no-referrer" /><title>{Astro.props.title}</title><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" /></head><body class="agreement-page"><a class="skip-link" href="#agreement-main">Skip to agreement</a><main class="agreement-shell site-shell" id="agreement-main" tabindex="-1"><header class="offer-header"><PersonalName variant="full" /><span class="page-kicker">Private agreement</span></header><p class="page-kicker agreement-kicker">Private agreement{Astro.props.step && ` · Step ${Astro.props.step} of 3`}</p><slot /></main></body></html>
