---
import BaseLayout from './BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import '~/styles/project-journal.css';
interface Props {
  title: string;
  subtitle: string;
  description: string;
  status: string;
  journalHref: string;
  ogImage?: string;
  /** Overrides the browser tab title (and og:title) only; the visible <h1> always uses `title`.
   * Falls back to "`${title} · Project journal · Kazon Wilson`" when omitted. Lets a project's
   * separate routes (for example a story or archive view) carry their own tab title. */
  pageTitle?: string;
}
const { title, subtitle, description, status, journalHref, ogImage, pageTitle } = Astro.props;
---
<BaseLayout title={pageTitle ?? `${title} · Project journal · Kazon Wilson`} description={description} ogImage={ogImage}>
  <div class="site-shell project-shell">
    <header class="project-intro">
      <p class="page-kicker"><a href="/building">Building</a> / {title}</p>
      <h1 class="page-title">{title}</h1>
      <p class="project-subtitle">{subtitle}</p>
      <p class="project-description">{description}</p>
      <p class="project-status" data-testid="journal-current-state">{status}</p>
      <a class="site-link" href={journalHref}>Development journal <span aria-hidden="true">↓</span></a>
    </header>
    <slot />
    <nav class="project-close" aria-label="Continue exploring">
      <a class="site-link" href="/building">Back to Building <span aria-hidden="true">←</span></a>
      <a class="site-link" href="/#contact">Get in touch <span aria-hidden="true">→</span></a>
    </nav>
  </div>
  <Footer compact slot="footer" />
</BaseLayout>
