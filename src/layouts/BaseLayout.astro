---
import '~/styles/global.css';
import { publicCanonicalFor } from '~/lib/canonical';
import { DEFAULT_OG_SCENE, ogMedia, ogSceneFor, type OgScene } from '~/lib/og-media';
import SiteNav from '~/components/SiteNav.astro';

interface Props {
  title: string;
  description: string;
  /** Image-only preview for a page without a scene of its own, such as a music release's artwork. */
  ogImage?: string;
  /** Forces a link-preview scene, for pages whose URL does not identify them (the 404 page). */
  ogScene?: OgScene;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage, ogScene, noindex = false, jsonLd } = Astro.props;
const hostHeader = (Astro.isPrerendered ? null : Astro.request.headers.get('host'));
const canonical = publicCanonicalFor(Astro.url, hostHeader);
const match = ogSceneFor(new URL(canonical).pathname);
const scene = ogScene ?? (match?.exact || !ogImage ? match?.scene ?? DEFAULT_OG_SCENE : null);
const preview = scene ? ogMedia(scene) : null;
const ogImageUrl = new URL(preview?.image ?? ogImage!, canonical).toString();
const ogVideoUrl = preview && new URL(preview.video, canonical).toString();

function jsonLdString(data: object): string {
  return JSON.stringify(data)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/\//g, '\\u002f');
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {preview && <>
      <meta property="og:image:width" content={String(preview.width)} />
      <meta property="og:image:height" content={String(preview.height)} />
      <meta property="og:image:alt" content={preview.alt} />
      {/* Apple's preview reader starts a new video at each URL tag that follows a type or size tag,
          so both URL tags come first. Messages plays the video; most other apps show og:image. */}
      <meta property="og:video" content={ogVideoUrl} />
      <meta property="og:video:secure_url" content={ogVideoUrl} />
      <meta property="og:video:type" content="video/mp4" />
      <meta property="og:video:width" content={String(preview.width)} />
      <meta property="og:video:height" content={String(preview.height)} />
    </>}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/kazon-name-text.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    {jsonLd && (
      <script type="application/ld+json" set:html={jsonLdString(jsonLd)} />
    )}
  </head>
  <body class="bg-paper text-ink font-serif">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteNav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
