---
import BaseLayout from './BaseLayout.astro';
import WorkWithMe from '~/components/WorkWithMe.astro';
import SoftwareServiceIllustration from '~/components/SoftwareServiceIllustration.astro';
import PersonalName from '~/components/PersonalName.astro';
import { mainSitePath } from '~/lib/host-routing';
import type { ServiceSheet } from '~/data/services';
interface Props { sheet: ServiceSheet; }
const { sheet } = Astro.props;
const href = (path: string) => mainSitePath(Astro.request.headers.get('host') ?? Astro.url.host, path);
---
<BaseLayout title="Work with me · Kazon Wilson" description="Three ways to work with Kazon Wilson: mixing and mastering, website design, and software engineering. Fixed-price projects, agreed in writing before work begins.">
  <article class="service-sheet site-shell">
    <header class="hub-intro">
      <p class="page-kicker">Work with me</p>
      <h1>Three ways to work with me.</h1>
      <p class="sheet-introduction">Mixing and mastering, website design, and software engineering. Every project is fixed price and agreed in writing before work begins.</p>
    </header>
    <div class="hub-doors"><WorkWithMe headingLevel="h2" /></div>
    <section id="software" class="sheet-software" aria-labelledby="software-title">
      <div class="site-section-heading"><h2 id="software-title">{sheet.title}</h2></div>
      <div class="sheet-lead">
        <div><p class="sheet-introduction">{sheet.introduction}</p><p class="sheet-approach">{sheet.approach}</p></div>
        <div class="sheet-illustration"><SoftwareServiceIllustration kind="idea" /></div>
      </div>
      <div class="sheet-offerings">{sheet.offerings.map(item => <div class="sheet-offering" id={item.id}><div class="offering-illustration"><SoftwareServiceIllustration kind={item.illustration} /></div><div><h3>{item.label}</h3><p>{item.description}</p>{item.evidence && <a class="offering-evidence" href={href(item.evidence)}>See this website’s redesign <span aria-hidden="true">→</span></a>}</div></div>)}</div>
      <div class="sheet-background"><p>{sheet.background}</p><a class="site-link" href={href(sheet.evidence)}>{sheet.evidenceLabel} <span aria-hidden="true">→</span></a></div>
    </section>
    <section class="sheet-working"><h2>Working together</h2><p>{sheet.working}</p></section>
    <section class="sheet-contact"><div><h2>{sheet.closing}</h2><p>{sheet.starting}</p></div><a class="site-button" href={href(sheet.contact)}>{sheet.contactLabel} <span aria-hidden="true">→</span></a></section>
    <p class="hub-elsewhere">Hiring for a role? <a href={href('/about#resumes')}>Request my resume</a>. Something else? <a href={href('/#contact')}>Get in touch</a>.</p>
    <div class="sheet-address"><span>kazon.wilson@thesuperhuman.us</span><a href={href(sheet.path)}>thesuperhuman.us{sheet.path}</a></div>
    <footer class="sheet-footnote"><span><PersonalName variant="full" /> · The Superhuman Group LLC · <a href={href('/privacy')}>Privacy</a></span><button type="button" class="site-button site-button-outline" data-print-sheet><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6M6 18H3V9h18v9h-3"/><path d="M6 14h12v7H6zM17 12h1"/></svg>Print / Save PDF</button></footer>
  </article>
</BaseLayout>
<script>document.querySelector('[data-print-sheet]')?.addEventListener('click', () => window.print());</script>
<style>
  .service-sheet { max-width: 1100px; padding-block: 2rem 3rem; }
  .hub-intro { padding-block: 1rem 2.5rem; }
  h1 { font-size: clamp(2.75rem, 5.5vw, 4.5rem); line-height: 1.02; letter-spacing: -.04em; max-width: 14ch; margin-bottom: 1.25rem; }
  h2 { font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.15; }
  p { font-size: 1.2rem; line-height: 1.5; color: var(--muted); }
  .sheet-introduction { font-size: clamp(1.4rem, 2.3vw, 1.7rem); line-height: 1.3; color: var(--ink); max-width: 34ch; }
  .sheet-software { margin-top: var(--site-section-space); scroll-margin-top: 1.5rem; }
  .sheet-lead { display: grid; grid-template-columns: 1.55fr 1fr; gap: 3rem; align-items: center; padding-block: .5rem 2rem; }
  .sheet-approach { margin-top: .75rem; }
  .sheet-illustration :global(svg), .offering-illustration :global(svg) { width: 100%; height: auto; display: block; }
  .site-button { gap: .75rem; text-align: center; }
  .sheet-offerings { border-top: 1px solid var(--rule); }
  .sheet-offering { display: grid; grid-template-columns: 30% 1fr; gap: 3rem; align-items: center; border-bottom: 1px solid var(--rule); padding-block: 1.75rem; scroll-margin-top: 1.5rem; }
  .sheet-offering h3 { font-size: clamp(1.6rem, 3vw, 2rem); line-height: 1.15; }
  .sheet-offering p { margin-top: .5rem; }.offering-illustration { display: grid; place-items: center; }
  .offering-evidence { display: inline-block; font-size: .95rem; margin-top: .6rem; }
  .sheet-background { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .75rem 2rem; padding-block: 1.5rem; border-bottom: 1px solid var(--rule); }.sheet-background p { font-size: 1rem; }
  .sheet-working { padding: 1.5rem; margin-top: 1.5rem; background: color-mix(in srgb, var(--paper), var(--rule) 35%); }.sheet-working h2 { font-size: 1.1rem; color: var(--muted); margin-bottom: .5rem; }.sheet-working p { color: var(--ink); font-size: 1.4rem; }
  .sheet-contact { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2rem; }.sheet-contact > div { max-width: 35ch; }.sheet-contact p { margin-top: .75rem; }.sheet-contact .site-button { flex-shrink: 0; }
  .hub-elsewhere { font-size: 1.05rem; margin-top: 1.5rem; }
  .sheet-address { display: grid; justify-items: start; gap: .3rem; margin-top: 1.5rem; font-size: 1rem; overflow-wrap: anywhere; }
  .sheet-footnote { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; border-top: 1px solid var(--rule); margin-top: 2rem; padding-top: 1rem; font: .8rem/1.5 Inter,sans-serif; color: var(--muted); }.sheet-footnote button { min-height: 48px; font: 1rem/1.4 Inter,sans-serif; cursor: pointer; }.sheet-footnote button svg { flex-shrink: 0; }
  @media screen and (max-width:700px) { .hub-intro { padding-block: .5rem 2rem; }.sheet-lead { grid-template-columns: 1fr; gap: 1rem; padding-block: 0 1.5rem; }.sheet-illustration { max-width: 220px; justify-self: center; }.sheet-offering { grid-template-columns: 1fr; gap: .8rem; }.offering-illustration { width: 180px; }.sheet-contact { align-items: start; flex-direction: column; gap: 1rem; }.sheet-working { padding: 1.2rem; } }
  @media screen and (max-width:400px) { .sheet-offering h3 { font-size: 1.45rem; }.sheet-offering p { font-size: 1.05rem; } }
  @media print {
    @page { size: letter; margin: .55in; }
    :global(.site-header), :global(.compact-footer), :global(.skip-link), [data-print-sheet], .hub-doors, .site-button, .sheet-background .site-link { display: none !important; }
    .service-sheet { max-width: none; padding: 0; }.hub-intro { padding: 0 0 8pt; } h1 { font-size: 26pt; margin-bottom: 6pt; } h2 { font-size: 15pt; } p { font-size: 10.5pt; line-height: 1.35; }.sheet-introduction { font-size: 14pt; }.sheet-software { margin-top: 10pt; }.sheet-lead { grid-template-columns: 1.6fr 1fr; gap: .3in; padding: 0 0 10pt; }.sheet-approach { margin-top: 6pt; }
    .sheet-offering { grid-template-columns: 1.4in 1fr; gap: .25in; padding-block: 7pt; break-inside: avoid; }.sheet-offering h3 { font-size: 15pt; }.offering-illustration :global(svg) { max-height: 48pt; }.sheet-offering p { margin-top: 3pt; }.offering-evidence { font-size: 9pt; margin-top: 3pt; }
    .sheet-background { padding-block: 9pt; }.sheet-background p { font-size: 10pt; }.sheet-working { margin-top: 10pt; padding: 10pt; print-color-adjust: exact; }.sheet-working h2 { font-size: 10pt; }.sheet-working p { font-size: 12pt; }.sheet-contact { margin-top: 12pt; }.sheet-contact > div { max-width: none; }.sheet-contact p { margin-top: 4pt; }.hub-elsewhere { font-size: 10pt; margin-top: 8pt; }.sheet-address { font-size: 9pt; margin-top: 8pt; gap: 1pt; }.sheet-footnote { font-size: 8pt; margin-top: 10pt; padding-top: 8pt; }
  }
</style>
