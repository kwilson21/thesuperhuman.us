---
export const prerender = false;
import OwnerLayout from '~/layouts/OwnerLayout.astro';
import { listCampaigns } from '~/lib/owner-reporting';
import { listOwnerRequests } from '~/lib/owner-requests';
const db = Astro.locals.runtime.env.MUSIC_DB;
if (!db) return new Response('Owner reporting is unavailable.', { status: 503 });
const [campaigns, newRequests] = await Promise.all([listCampaigns(db), listOwnerRequests(db, { status: 'new' })]);
---
<OwnerLayout title="Campaigns" current="campaigns" newRequestCount={newRequests.length} ownerEmail={Astro.locals.owner?.email ?? ''}>
  <header class="owner-page-heading compact"><div><p class="owner-kicker">Promotion history</p><h1>Campaigns</h1><p>Each campaign keeps its plan, evidence, and lesson for next time.</p></div></header>
  <section class="owner-section campaign-archive"><ol>{campaigns.map(campaign => <li><a href={`/owner/campaigns/${campaign.id}`}><span><small>{campaign.endsAt ? 'Complete' : 'Active'}</small><strong>{campaign.name}</strong><em>{campaign.primaryGoal}</em></span><time datetime={campaign.startsAt}>{new Date(campaign.startsAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></a></li>)}</ol>{!campaigns.length && <p class="owner-empty">No campaigns have been planned yet.</p>}</section>
</OwnerLayout>
