---
export const prerender = false;
import OwnerLayout from '~/layouts/OwnerLayout.astro';
import AttentionIndex from '~/components/owner/AttentionIndex.astro';
import ListeningPath from '~/components/owner/ListeningPath.astro';
import RequestList from '~/components/owner/RequestList.astro';
import MetricDefinition from '~/components/owner/MetricDefinition.astro';
import { loadCampaignDesk } from '~/lib/owner-reporting';
import { listOwnerRequests } from '~/lib/owner-requests';
import { loadTrafficSummary } from '~/lib/cloudflare-analytics';
const db = Astro.locals.runtime.env.MUSIC_DB;
if (!db) return new Response('Owner reporting is unavailable.', { status: 503 });
const campaign = Astro.params.id ? await loadCampaignDesk(db, Astro.params.id, new Date()) : null;
if (!campaign) return new Response('Campaign not found.', { status: 404 });
const [newRequests, traffic] = await Promise.all([
  listOwnerRequests(db, { status: 'new' }),
  loadTrafficSummary(Astro.locals.runtime.env, { start: new Date(campaign.startsAt), end: campaign.endsAt ? new Date(campaign.endsAt) : new Date() }),
]);
---
<OwnerLayout title={campaign.name} current="campaigns" newRequestCount={newRequests.length} ownerEmail={Astro.locals.owner?.email ?? ''}>
  <p class="owner-breadcrumb"><a href="/owner">Today</a> <span>/</span> <a href="/owner/campaigns">Campaigns</a> <span>/</span> {campaign.name}</p>
  <header class="owner-page-heading compact campaign-heading"><div><p class="owner-kicker">Campaign Desk · {campaign.status}</p><h1>{campaign.name}</h1><p>{campaign.primaryGoal}</p></div><a href="/owner">Return to Today →</a></header>
  <section class="owner-section campaign-evidence"><AttentionIndex number="01" label="First area to inspect" /><div class="section-heading-line"><div><p class="owner-kicker">Meaningful listening</p><h2>How far people listened</h2></div><MetricDefinition label="reported listening">These milestones follow an ordered browser sequence bounded by server time. They cannot prove attention or device volume.</MetricDefinition></div><ListeningPath listening={campaign.listening} /></section>
  <section class="owner-section demand-section"><AttentionIndex number="02" label="Next useful area" /><div class="section-heading-line"><div><p class="owner-kicker">Demand</p><h2>Who asked for more</h2></div></div><dl class="demand-tally"><div><dt>Purchase</dt><dd>{campaign.demand.purchase}</dd></div><div><dt>Merchandise</dt><dd>{campaign.demand.merchandise}</dd></div><div><dt>Release updates</dt><dd>{campaign.demand.subscribers}</dd></div></dl><RequestList requests={campaign.requests.slice(0, 5)} empty="No one has requested the song or merchandise through this campaign yet." /></section>
  <div class="campaign-support-grid">
    <section class="owner-section"><p class="owner-kicker">Approximate geography</p><h2>Where listening gathers</h2>{campaign.geography.cities.length ? <ol class="simple-tally">{campaign.geography.cities.map(city => <li><span>{city.label}</span><strong>{city.reportedListens}</strong></li>)}</ol> : <p class="owner-empty">City patterns appear after at least five qualifying reported sessions share a city.</p>}</section>
    <section class="owner-section"><p class="owner-kicker">Discovery</p><h2>How people arrived</h2>{traffic.status === 'available' ? <dl class="traffic-tally"><div><dt>Site visits</dt><dd>{traffic.summary.visits}</dd></div><div><dt>Requests</dt><dd>{traffic.summary.requests}</dd></div></dl> : <p class="owner-empty">Traffic detail is unavailable here. <a href={traffic.dashboardUrl}>Open Cloudflare analytics →</a></p>}<p class="owner-annotation">Controlled links: {campaign.channels.length ? campaign.channels.map(item => `${item.channel} / ${item.creative}`).join(', ') : 'None yet'}</p></section>
  </div>
  {(campaign.approvedPlan || campaign.retrospective || campaign.nextLesson) && <section class="owner-section campaign-notes"><p class="owner-kicker">Campaign memory</p><h2>Keep what this teaches you</h2><dl>{campaign.approvedPlan && <div><dt>Approved plan</dt><dd>{campaign.approvedPlan}</dd></div>}{campaign.retrospective && <div><dt>Retrospective</dt><dd>{campaign.retrospective}</dd></div>}{campaign.nextLesson && <div><dt>Next lesson</dt><dd>{campaign.nextLesson}</dd></div>}</dl></section>}
</OwnerLayout>
