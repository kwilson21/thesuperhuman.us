---
export const prerender = false;
import OwnerLayout from '~/layouts/OwnerLayout.astro';
import AudioPaymentPanel from '~/components/owner/AudioPaymentPanel.astro';
import ProjectMessages from '~/components/ProjectMessages.astro';
import AudioProjectUpdates from '~/components/AudioProjectUpdates.astro';
import { getAudioPayment } from '~/lib/audio-payments';
import { clientPortalEnabled } from '~/lib/audio-client-access';
import { listProjectMessages } from '~/lib/audio-project-messages';
import { listProjectUpdates } from '~/lib/audio-project-updates';
import { getOwnerRequest, listOwnerRequestAudit, listOwnerRequests } from '~/lib/owner-requests';
import { safeExternalUrl } from '~/lib/owner-model';
import { stripeAvailable } from '~/lib/stripe-invoicing';
const db = Astro.locals.runtime.env.MUSIC_DB;
if (!db) return new Response('Owner reporting is unavailable.', { status: 503 });
const request = Astro.params.id ? await getOwnerRequest(db, Astro.params.id) : null;
if (!request) return new Response('Request not found.', { status: 404 });
const [audit, newRequests] = await Promise.all([listOwnerRequestAudit(db, request.id), listOwnerRequests(db, { status: 'new' })]);
const payment = request.kind === 'service' ? await getAudioPayment(db, request.id) : null;
const portalProject = request.kind === 'service' && clientPortalEnabled(Astro.locals.runtime.env)
  ? await db.prepare('SELECT stage,current_due_at,revoked_at FROM audio_projects WHERE request_id=?').bind(request.id).first<{ stage: string; current_due_at: string | null; revoked_at: string | null }>() : null;
const projectMessages = portalProject ? await listProjectMessages(db, request.id) : [];
const projectUpdates = portalProject ? await listProjectUpdates(db, request.id) : [];
const allowed = request.status === 'new' ? ['review', 'resolve', 'withdraw'] : request.status === 'reviewed' ? ['resolve', 'reopen', 'withdraw'] : request.status === 'resolved' ? ['reopen', 'withdraw'] : [];
const label = (key: string) => key.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, character => character.toUpperCase());
const detailRows = Object.entries(request.details).filter(([, value]) => value !== '' && value !== null && value !== false && (!Array.isArray(value) || value.length));
const detailValue = (value: unknown) => Array.isArray(value) ? value.join(', ') : typeof value === 'object' && value ? Object.entries(value).map(([key, item]) => `${label(key)}: ${String(item)}`).join(' · ') : String(value);
---
<OwnerLayout title={request.summary} current="requests" newRequestCount={newRequests.length} ownerEmail={Astro.locals.owner?.email ?? ''}>
  <p class="owner-breadcrumb"><a href="/owner/requests">Requests</a> <span aria-hidden="true">/</span> {request.summary}</p>
  <header class="owner-page-heading compact"><div><p class="owner-kicker">{request.kind} · {request.status}</p><h1>{request.summary}</h1><p>Received {new Date(request.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p></div></header>
  <div class="request-detail-grid" data-request-id={request.id}>
    <section class="owner-section request-contact" aria-labelledby="contact-heading"><p class="owner-kicker">Person</p><h2 id="contact-heading">Contact</h2><dl><dt>Name</dt><dd>{request.name || 'Not supplied'}</dd><dt>Email</dt><dd><a href={`mailto:${request.email}`}>{request.email}</a></dd><dt>City or region <small>Supplied by requester</small></dt><dd>{request.cityRegion || 'Not supplied'}</dd></dl>
      {(request.releaseId || request.serviceId || request.campaignId) && <div class="request-source"><p class="owner-kicker">Related</p>{request.releaseId && <a href={`/music/${request.releaseId.replace(/-single$/, '')}`}>Open release →</a>}{request.serviceId && <a href="/audio/services">Open service →</a>}{request.campaignId && <a href={`/owner/campaigns/${request.campaignId}`}>Open campaign →</a>}</div>}
    </section>
    {detailRows.length > 0 && <section class="owner-section request-submission" aria-labelledby="submission-heading"><p class="owner-kicker">Submitted with this request</p><h2 id="submission-heading">Project details</h2><dl>{detailRows.map(([key, value]) => { const href = /url|link/i.test(key) ? safeExternalUrl(value) : null; return <><dt>{label(key)}</dt><dd>{href ? <a href={href} rel="noreferrer">Open supplied link →</a> : detailValue(value)}</dd></>; })}</dl></section>}
    <section class="owner-section request-work" aria-labelledby="work-heading"><p class="owner-kicker">Your working note</p><h2 id="work-heading">Keep the next step clear</h2><form data-request-note><label for="owner-private-note">Private note</label><textarea id="owner-private-note" name="note" maxlength="1000" rows="5">{request.privateNote}</textarea><button type="submit">Save private note</button><p data-action-status aria-live="polite"></p></form>
      {allowed.length > 0 && <div class="request-actions" data-request-actions>{allowed.map(action => <button type="button" data-action={action} class:list={{ danger: action === 'withdraw' }}>{action === 'review' ? 'Mark reviewed' : action === 'resolve' ? 'Mark resolved' : action === 'reopen' ? 'Reopen request' : 'Honor withdrawal'}</button>)}</div>}
    </section>
  </div>
  {request.kind === 'service' && <AudioPaymentPanel requestId={request.id} payment={payment} stripeEnabled={stripeAvailable(Astro.locals.runtime.env)} />}
  {portalProject && <AudioProjectUpdates updates={projectUpdates} currentDueAt={portalProject.current_due_at} stage={portalProject.stage} requestStatus={request.status} bookingPaid={payment?.bookingStatus === 'paid'} revoked={Boolean(portalProject.revoked_at)} endpoint={`/api/owner/projects/${encodeURIComponent(request.id)}/updates`} />}
  {portalProject && <ProjectMessages messages={projectMessages} endpoint={`/api/owner/projects/${encodeURIComponent(request.id)}/messages`} reader="owner" closed={portalProject.stage === 'complete' || Boolean(portalProject.revoked_at) || request.status === 'withdrawn'} />}
  <section class="owner-section audit-trail"><p class="owner-kicker">Audit trail</p><h2>What changed</h2><ol>{audit.map(item => <li><strong>{item.action.replace('-', ' ')}</strong><span>{item.actor}</span><time datetime={item.occurredAt}>{new Date(item.occurredAt).toLocaleString()}</time>{item.note && <p>{item.note}</p>}</li>)}</ol></section>
  <script>import { setupOwnerRequestActions } from '~/scripts/owner-request-actions'; import { setupOwnerPaymentActions } from '~/scripts/owner-payment-actions'; import { setupProjectMessages } from '~/scripts/project-messages'; import { setupProjectUpdates } from '~/scripts/project-updates'; setupOwnerRequestActions(); setupOwnerPaymentActions(); setupProjectMessages(); setupProjectUpdates();</script>
</OwnerLayout>
