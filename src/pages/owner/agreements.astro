---
import { newYorkTime } from "~/lib/agreement-artifacts";

export const prerender = false;

import OwnerLayout from "~/layouts/OwnerLayout.astro";
import {
	currentTemplate,
	templateFields,
	templateVersionLabel,
	type AgreementTemplate,
} from "~/lib/agreement-templates";
import { signingEnabled } from "~/lib/agreement-access";
import { projectToday } from "~/lib/audio-project-updates";

const db = Astro.locals.runtime.env.MUSIC_DB!;

const enabled = await signingEnabled(db),
	templates = await Promise.all(
		(["msa", "sow"] as const).map((kind) => currentTemplate(db, kind)),
	);

const config = await db
	.prepare(
		"SELECT version,values_json FROM software_contractor_config ORDER BY version DESC LIMIT 1",
	)
	.first<{ version: number; values_json: string }>();

const histories = await Promise.all(
	["msa", "sow"].map((kind) =>
		db
			.prepare(
				"SELECT version,published_at,version_label FROM software_agreement_templates WHERE kind=? ORDER BY version DESC",
			)
			.bind(kind)
			.all<{
				version: number;
				published_at: string;
				version_label: string | null;
			}>(),
	),
);

const currentVersionText = (template: AgreementTemplate | null) =>
	template
		? `${template.version} · ${templateVersionLabel(template)}`
		: "not published";

const values = config ? JSON.parse(config.values_json) : {};
---
<OwnerLayout title="Agreements" current="agreements" newRequestCount={0} ownerEmail={Astro.locals.owner!.email}>
 <p class="owner-breadcrumb"><a href="/owner">Owner center</a> <span aria-hidden="true">/</span> Agreements</p>
 <header class="owner-page-heading compact"><div><p class="owner-kicker">Owner / Agreements</p><h1>Agreements.</h1><p>Manage private templates and signing. Published versions and signed documents stay unchanged.</p></div></header>
 <div class="agreement-settings software-rail">
 <section class="rail-section"><h2>Website signing</h2><form method="post" action="/api/owner/agreements"><input type="hidden" name="action" value="setting" /><label class="confirmation"><input type="checkbox" name="enabled" value="true" checked={enabled} /> Enable website signing</label><input type="hidden" name="confirmed" value="true" /><p class="rail-muted">Review the templates and consent with counsel when possible. While signing is off, use the signed outside the website path.</p><button class="studio-button">Save setting</button></form></section>
 <section class="rail-section"><h2>Contractor details</h2><form data-agreement-config method="post" action="/api/owner/agreements"><input type="hidden" name="action" value="config" /><input type="hidden" name="expectedCurrentVersion" value={config?.version??0} />{[['legal_name','Legal business name'],['entity_jurisdiction','Entity and jurisdiction'],['signer_name','Signer name'],['signer_title','Signer title'],['notice_email','Business notice email'],['business_address','Registered-agent business mailing address']].map(([name,label])=><label>{label}<input class="studio-input" name={name} value={values[name]??''} required /></label>)}<label class="confirmation"><input type="checkbox" name="registered_agent_confirmed" required /> I verified this is the registered-agent business address.</label><p class="rail-muted">Use the business address. Sent offers keep the version they were sent with.</p><button class="studio-button">Save new version</button><p role="status"></p></form></section>
 {(['msa','sow'] as const).map((kind,index)=><section class="rail-section"><h2>{kind.toUpperCase()} template</h2><p>Current version {currentVersionText(templates[index])}</p><form data-template-editor method="post" action="/api/owner/agreements"><input type="hidden" name="kind" value={kind} /><input type="hidden" name="expectedCurrentVersion" value={templates[index]?.version??0} /><label>Plain text template<textarea class="studio-textarea" name="text" rows="20" required maxlength="102400">{templates[index]?.text??''}</textarea></label><details><summary>Field reference</summary><ul>{templateFields[kind].map(field=><li><code>{'{{'+field+'}}'}</code></li>)}</ul></details><div class="software-field"><label>Version label<input class="studio-input" name="versionLabel" value={`v${projectToday()}`} required maxlength="40" pattern={'[A-Za-z0-9.\\-]{1,40}'} title="Use letters, digits, dots and dashes for the version label, up to 40 characters." aria-describedby={`${kind}-version-label-hint`} /></label><p class="rail-muted rail-caption" id={`${kind}-version-label-hint`}>Clients see this on the agreement. Use the date of the legal text it reflects.</p></div><div class="software-field"><label>Source revision<input class="studio-input" name="sourceRevision" maxlength="120" aria-describedby={`${kind}-source-revision-hint`} /></label><p class="rail-muted rail-caption" id={`${kind}-source-revision-hint`}>Your reference for the legal source, for example a counsel revision. Clients can see it in the signing record attached to the signed PDF.</p></div><button class="studio-quiet" name="action" value="preview" formnovalidate>Preview sample</button><label class="confirmation"><input type="checkbox" name="confirmed" value="true" /> Publish a new immutable version</label><button class="studio-button" name="action" value="publish">Publish new version</button><p role="status"></p><pre data-template-preview></pre><div data-template-diff hidden aria-live="polite"></div></form><details><summary>Version history</summary><ul>{histories[index].results.map(v=><li>Version {v.version} · {templateVersionLabel(v)} · {newYorkTime(v.published_at)} <div class="software-actions"><button type="button" class="studio-quiet" data-template-version data-kind={kind} data-version={v.version} data-view="text">View text</button>{v.version>1&&<button type="button" class="studio-quiet" data-template-version data-kind={kind} data-version={v.version} data-view="compare">Compare with previous</button>}</div><div data-template-version-output></div></li>)}</ul></details></section>)}
<section class="rail-section"><h2>Agreement retention</h2><p>Preview agreements eligible after the ten-year period and private uploads left unindexed for at least 30 days. Open agreements, legal holds, active MSA reuse, and files with live references stay retained. This cleanup is separate from project messages and images.</p><form data-retention-preview><button class="studio-quiet">Preview eligible agreements and uploads</button><p role="status"></p><pre data-retention-preview-output></pre></form><form method="post" action="/api/owner/agreements"><input type="hidden" name="action" value="retention-apply" /><label>Reviewed manifest<textarea class="studio-textarea" name="manifest" rows="8" required></textarea></label><label class="confirmation"><input type="checkbox" name="confirmed" value="true" required />I reviewed these exact IDs and hashes for deletion.</label><button class="studio-quiet">Apply reviewed cleanup</button></form></section>
<section class="rail-section"><h2>Expired email verification data</h2><p>Remove challenges and sessions expired or revoked for at least 30 days. Saved signature evidence and signed agreements remain retained.</p><form method="post" action="/api/owner/agreements"><input type="hidden" name="action" value="access-cleanup" /><label class="confirmation"><input type="checkbox" name="confirmed" value="true" required />Remove expired verification data only.</label><button class="studio-quiet">Clean up expired verification data</button></form></section>
 </div>
</OwnerLayout>
<style>
form {
  display: grid;
  gap: 1rem;
  min-width: 0;
}
label:not(.confirmation) {
  display: grid;
  gap: 0.4rem;
}
textarea,
input {
  max-width: 100%;
  min-width: 0;
}
pre,
code {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
/* The page script builds these nodes at runtime without the scope class, so only the leaf is global; the settings root keeps the rules on this page. */
.agreement-settings :global(.template-diff),
.agreement-settings :global(.template-text) {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.agreement-settings :global(.diff-removed),
.agreement-settings :global(.diff-unchanged) {
  color: var(--muted);
}
.agreement-settings :global(.diff-added) {
  color: var(--accent);
}
.agreement-settings {
  max-width: 60rem;
  min-width: 0;
  overflow-wrap: anywhere;
}
form > button {
  justify-self: start;
}
</style>
<script>
  import { setupOwnerAgreements } from '~/scripts/owner-agreements';

  setupOwnerAgreements();
</script>
