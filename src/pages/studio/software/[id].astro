---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import StudioUnavailable from '~/components/StudioUnavailable.astro';
import SoftwareProjectUpdate from '~/components/SoftwareProjectUpdate.astro';
import SoftwareStepTrack from '~/components/SoftwareStepTrack.astro';
import ProjectMessages from '~/components/ProjectMessages.astro';
import { clientPortalEnabled, clientSoftwareProjectForSession, studioSessionFromRequest } from '~/lib/audio-client-access';
import { projectTerms, sharedSoftwareUpdates, softwareStateSentence, softwareDate } from '~/lib/software-projects';
import { listSoftwareProjectMessages } from '~/lib/software-project-messages';
import '~/styles/studio.css';
const env = Astro.locals.runtime.env;
if (!clientPortalEnabled(env)) return new Response('Not found', { status: 404 });
if (!env.MUSIC_DB) return new Response('Studio is temporarily unavailable.', { status: 503 });
const token = studioSessionFromRequest(Astro.request);
if (!token) return Astro.redirect('/studio/sign-in?for=software');
const project = await clientSoftwareProjectForSession(env.MUSIC_DB, token, Astro.params.id!);
if (!project) Astro.response.status = 404;
const terms = project ? projectTerms(project) : null;
const updates = project ? await sharedSoftwareUpdates(env.MUSIC_DB, project.request_id) : [];
const messages = project ? await listSoftwareProjectMessages(env.MUSIC_DB, project.request_id) : [];
const latest = updates[0], milestone = terms?.milestones[project?.milestone_index ?? 0];
const visual = (id: string) => `/api/studio/software/${project!.request_id}/updates/${id}/visual`;
const waiting = latest?.client_request || (project?.state === 'waiting_for_input' ? project.waiting_for : '');
---
{!project || !terms ? <StudioUnavailable backLabel="Back to your projects" /> : <BaseLayout title={`${terms.outcome} · Private project`} description="Your private project." noindex>
  <article class="site-shell software-project">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/studio">Your projects</a> / {terms.outcome}</nav>
    <header><p class="studio-kicker">Private project</p><h1>{terms.outcome}</h1><p class="summary">{terms.summary}</p></header>
    <div class="project-band"><div><h2>Milestone {project.milestone_index+1} · {milestone?.name}</h2><p>{softwareStateSentence(project)}</p></div><div>{latest?.shared_at && <p>Last update: {softwareDate(latest.shared_at)}</p>}{project.next_update_on && <p>Next update: {softwareDate(project.next_update_on)}</p>}</div><SoftwareStepTrack step={project.step} /></div>
    <div class="project-columns"><main>
      {latest ? <SoftwareProjectUpdate update={latest} visualUrl={latest.has_visual ? visual(latest.id) : undefined} /> : <section><h2>Your first update is on its way.</h2>{project.next_update_on && <p>Next update: {softwareDate(project.next_update_on)}</p>}</section>}
      <details><summary>What we agreed</summary>{terms.milestones.map(item => <section><h3>{item.name}</h3><h4>Deliverables</h4><ul>{item.deliverables.map(line => <li>{line}</li>)}</ul><h4>Acceptance examples</h4><ul>{item.acceptance.map(line => <li>{line}</li>)}</ul></section>)}<h3>Your inputs</h3><p>{terms.clientInputs}</p><h3>Exclusions</h3><p>{terms.exclusions}</p></details>
      {updates.length > 1 && <details><summary>Earlier updates</summary>{updates.slice(1).map(update => <SoftwareProjectUpdate update={update} visualUrl={update.has_visual ? visual(update.id) : undefined} />)}</details>}
    </main><aside aria-label="Next steps and conversation">{waiting && <section><h2>Waiting on you</h2><p>{waiting}</p></section>}{latest?.next_step && <section><h2>Next from me</h2><p>{latest.next_step}</p></section>}<ProjectMessages messages={messages} endpoint={`/api/studio/software/${project.request_id}/messages`} reader="client" closed={project.state === 'complete'} heading="Ask a question" placeholder="Ask about a screen, a step or a date." hint="" /></aside></div>
    <footer class="project-records"><span>Agreement · Complete</span><span>{project.payment_mode === 'standard' ? 'Initial payment · Received' : 'First invoice · Sent'}</span><span>Start · Confirmed {softwareDate(project.started_at)}</span></footer>
  </article><script>import { setupProjectMessages } from '~/scripts/project-messages'; setupProjectMessages();</script>
</BaseLayout>}
<style>
  .software-project { max-width: 80rem; margin: auto; padding: clamp(3rem,7vw,6rem) 1.5rem; overflow-wrap: anywhere; }
  .breadcrumb { color: var(--muted); font: .85rem/1.5 Inter,sans-serif; margin-bottom: 2rem; }
  .studio-kicker { color: var(--accent); font: 500 .75rem/1.4 Inter,sans-serif; text-transform: uppercase; letter-spacing: .15em; }
  h1 { font: 400 clamp(2.8rem,6vw,5rem)/1.02 Newsreader,Georgia,serif; margin: 1rem 0; }
  h2 { font: 400 1.8rem/1.2 Newsreader,Georgia,serif; margin: 0 0 .6rem; }
  h3 { font: 400 1.5rem/1.2 Newsreader,Georgia,serif; margin: 1.5rem 0 .5rem; }
  p, li { font: 1rem/1.6 Inter,sans-serif; white-space: pre-wrap; }
  .summary { color: var(--muted); max-width: 60ch; }
  .project-band { display: grid; grid-template-columns: 1.3fr .8fr 1fr; gap: 2rem; align-items: center; border-block: 1px solid var(--rule); padding: 1.5rem 0; margin: 2.5rem 0; }
  .project-band h2 { font-size: 1.4rem; }
  .project-band p { font-size: .85rem; color: var(--muted); }
  .project-columns { display: grid; grid-template-columns: minmax(0,2fr) minmax(0,1fr); gap: 3rem; align-items: start; }
  main, aside { min-width: 0; }
  aside { border-left: 1px solid var(--rule); padding-left: 2rem; }
  aside section { padding-bottom: 2rem; }
  details { border-top: 1px solid var(--rule); padding: 1.5rem 0; margin-top: 2rem; }
  summary { cursor: pointer; font: 400 1.5rem/1.4 Newsreader,Georgia,serif; }
  ul { padding-left: 1.3rem; }
  .project-records { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--rule); margin-top: 3rem; padding-top: 1.5rem; font: .8rem/1.5 Inter,sans-serif; color: var(--muted); }
  @media(max-width: 55rem) { .project-band, .project-columns { grid-template-columns: 1fr; } aside { border-left: 0; border-top: 1px solid var(--rule); padding: 2rem 0 0; } }
</style>
