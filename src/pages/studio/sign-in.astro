---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/studio.css';
import studioCorner from '~/assets/site/studio-corner-v1.webp';
import { clientPortalEnabled } from '~/lib/audio-client-access';
const env = Astro.locals.runtime?.env;
if (!clientPortalEnabled(env)) return new Response('Not found', { status: 404 });
const siteKey = env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const partialSignOut = Astro.url.searchParams.get('signout') === 'partial';
---
<BaseLayout title="Studio sign-in · Kazon" description="Sign in to your private audio project." noindex>
  <article class="studio-sign-in site-shell">
    <p class="studio-kicker">Your private studio</p>
    <h1>Return to your song.</h1>
    {partialSignOut && <p role="status">You’re signed out on this device. If you’re concerned someone else has access, <a href="mailto:kazon.wilson@thesuperhuman.us">contact Kazon</a>.</p>}
    <p class="studio-intro">Use the email you shared when you sent your project. We’ll send a short code to confirm it’s you.</p>
    {siteKey ? <>
      <form id="studio-code-request">
        <label class="studio-field" for="studio-email">Email address</label>
        <input class="studio-input" id="studio-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="320" />
        <div class="cf-turnstile" data-sitekey={siteKey}></div>
        <button type="submit" class="studio-button">Send a code</button>
      </form>
      <form id="studio-code-verify" hidden>
        <h2>Check your email</h2>
        <p class="studio-intro small">We sent an eight-digit code. It expires in 10 minutes.</p>
        <fieldset class="code-boxes" data-code-boxes>
          <legend>Eight-digit code</legend>
          {Array.from({ length: 8 }, (_, index) => <input class="code-box" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete={index === 0 ? 'one-time-code' : 'off'} aria-label={`Digit ${index + 1} of 8`} />)}
        </fieldset>
        <input type="hidden" name="code" />
        <button type="submit" class="studio-button">Open my project</button>
        <button type="button" class="studio-quiet" data-new-code>Send a new code</button>
      </form>
      <p id="studio-status" role="status" aria-live="polite"></p>
    </> : <p>Studio sign-in is temporarily unavailable. Please try again later.</p>}
  </article>
  <img class="studio-corner" src={studioCorner.src} width={studioCorner.width} height={studioCorner.height} alt="" loading="lazy" decoding="async" />
  <style>
    .studio-sign-in { max-width: 58rem; margin: 0 auto; padding: clamp(4rem, 12vw, 9rem) 1.5rem 3rem; }
    /* Decorative. The top and side edges fade into the page so no image edge shows. */
    .studio-corner { display: block; width: min(100%, 72rem); height: auto; margin: 0 auto; pointer-events: none; user-select: none;
      mask-image: linear-gradient(to bottom, transparent, #000 18%), linear-gradient(to right, transparent, #000 3%, #000 82%, transparent);
      mask-composite: intersect; -webkit-mask-composite: source-in; }
    @media (max-width: 45rem) { .studio-corner { aspect-ratio: 1.45; object-fit: cover; object-position: left bottom; } }
    .studio-kicker { color: var(--accent); font: 500 .78rem/1.4 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
    h1 { font-family: Newsreader, Georgia, serif; font-size: clamp(3.8rem, 10vw, 7.5rem); font-weight: 400; line-height: .95; margin: 1.5rem 0 2rem; }
    .studio-intro { max-width: 36rem; font: 1.2rem/1.6 Inter, sans-serif; color: #4d4b47; margin-bottom: 3rem; }
    form { border-top: 1px solid var(--rule); padding-top: 1.75rem; max-width: 31rem; display: grid; gap: 1rem; }
    form[hidden] { display: none; }
    h2 { margin: 0; font: 400 clamp(2rem, 5vw, 2.8rem)/1.1 Newsreader, Georgia, serif; }
    .studio-intro.small { margin: -.4rem 0 .4rem; font-size: 1rem; }
    .code-boxes { display: grid; grid-template-columns: repeat(8, minmax(0, 3rem)); gap: .45rem; margin: 0; padding: 0; border: 0; }
    .code-boxes legend { margin-bottom: .6rem; padding: 0; font: 500 .82rem/1.4 Inter, sans-serif; }
    .code-box { width: 100%; aspect-ratio: 5 / 6; padding: 0; border: 1px solid var(--studio-line); border-radius: 2px; background: var(--studio-field); text-align: center; font: 500 1.35rem/1 Inter, sans-serif; font-variant-numeric: tabular-nums; }
    .code-box:focus-visible { outline: none; border: 2px solid var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
    .studio-button { min-width: 12rem; }
    #studio-status { min-height: 2rem; margin-top: 1.5rem; font: .95rem/1.5 Inter, sans-serif; }
  </style>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
  {siteKey && <script>
    const requestForm = document.querySelector<HTMLFormElement>('#studio-code-request');
    const verifyForm = document.querySelector<HTMLFormElement>('#studio-code-verify');
    const status = document.querySelector<HTMLElement>('#studio-status');
    requestForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!requestForm || !verifyForm || !status) return;
      const email = (requestForm.elements.namedItem('email') as HTMLInputElement).value;
      const turnstileToken = (requestForm.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]'))?.value ?? '';
      const button = requestForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const response = await fetch('/api/studio/code', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, turnstileToken }) });
        const result = await response.json() as { message?: string; error?: string };
        status.textContent = result.message ?? result.error ?? 'Please try again.';
        if (response.ok) { verifyForm.hidden = false; boxes[0]?.focus(); }
      } catch { status.textContent = 'Could not reach the studio. Please try again.'; }
      finally {
        if (button) button.disabled = false;
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
    // Eight single-digit boxes; typing advances, backspace returns, and a pasted code fills them all.
    const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-code-boxes] input')];
    const fill = (digits: string, from: number) => {
      [...digits].forEach((digit, offset) => { if (boxes[from + offset]) boxes[from + offset].value = digit; });
      boxes[Math.min(from + digits.length, boxes.length - 1)]?.focus();
    };
    boxes.forEach((box, index) => {
      box.addEventListener('input', () => {
        const digits = box.value.replace(/\D/g, '');
        box.value = '';
        if (digits) fill(digits.slice(0, boxes.length - index), index);
      });
      box.addEventListener('keydown', event => {
        if (event.key === 'Backspace' && !box.value && index > 0) { boxes[index - 1].value = ''; boxes[index - 1].focus(); event.preventDefault(); }
        if (event.key === 'ArrowLeft' && index > 0) boxes[index - 1].focus();
        if (event.key === 'ArrowRight' && index < boxes.length - 1) boxes[index + 1].focus();
      });
      box.addEventListener('paste', event => {
        const digits = event.clipboardData?.getData('text').replace(/\D/g, '') ?? '';
        if (!digits) return;
        event.preventDefault();
        fill(digits.slice(0, boxes.length - index), index);
      });
    });
    document.querySelector('[data-new-code]')?.addEventListener('click', () => {
      if (!verifyForm || !status) return;
      verifyForm.hidden = true;
      boxes.forEach(box => { box.value = ''; });
      status.textContent = 'Complete the security check and send a new code.';
      document.querySelector<HTMLInputElement>('#studio-email')?.focus();
    });
    verifyForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!requestForm || !verifyForm || !status) return;
      const email = (requestForm.elements.namedItem('email') as HTMLInputElement).value;
      const code = boxes.map(box => box.value).join('');
      if (!/^\d{8}$/.test(code)) { status.textContent = 'Enter all eight digits.'; boxes.find(box => !box.value)?.focus(); return; }
      (verifyForm.elements.namedItem('code') as HTMLInputElement).value = code;
      const button = verifyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const response = await fetch('/api/studio/session', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, code }) });
        const result = await response.json() as { error?: string };
        if (response.ok) { location.assign('/studio'); return; }
        status.textContent = result.error ?? 'Please try again.';
      } catch { status.textContent = 'Could not reach the studio. Please try again.'; }
      finally { if (button) button.disabled = false; }
    });
  </script>}
</BaseLayout>
