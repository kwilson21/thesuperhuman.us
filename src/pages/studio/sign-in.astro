---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import { clientPortalEnabled, clientProjectsForSession, studioSessionFromRequest } from '~/lib/audio-client-access';
const env = Astro.locals.runtime?.env;
if (!clientPortalEnabled(env)) return new Response('Not found', { status: 404 });
// A client following an email link with a live session goes straight to their songs.
const existing = studioSessionFromRequest(Astro.request);
if (existing && env.MUSIC_DB && await clientProjectsForSession(env.MUSIC_DB, existing)) return Astro.redirect('/studio');
const siteKey = env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const partialSignOut = Astro.url.searchParams.get('signout') === 'partial';
---
<BaseLayout title="Studio sign-in · Kazon" description="Sign in to your private audio project." noindex>
  <article class="studio-sign-in site-shell">
    <p class="studio-kicker">Your private studio</p>
    <h1>Return to your song.</h1>
    {partialSignOut && <p role="status">You’re signed out on this device. If you’re concerned someone else has access, <a href="mailto:kazon.wilson@thesuperhuman.us">contact Kazon</a>.</p>}
    <p class="studio-intro">Use the email you shared when you sent your project. We’ll send a short code to confirm it’s you.</p>
    {siteKey ? <>
      <form id="studio-code-request">
        <label for="studio-email">Email address</label>
        <input id="studio-email" name="email" type="email" autocomplete="email" required maxlength="320" />
        <div class="cf-turnstile" data-sitekey={siteKey}></div>
        <button type="submit" class="site-button">Send a code</button>
      </form>
      <form id="studio-code-verify" hidden>
        <label for="studio-code">Eight-digit code</label>
        <input id="studio-code" name="code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" required />
        <button type="submit" class="site-button">Open my project</button>
      </form>
      <p id="studio-status" role="status" aria-live="polite"></p>
    </> : <p>Studio sign-in is temporarily unavailable. Please try again later.</p>}
  </article>
  <style>
    .studio-sign-in { max-width: 58rem; margin: 0 auto; padding: clamp(4rem, 12vw, 9rem) 1.5rem 7rem; }
    .studio-kicker { color: #a4512f; font: 500 .78rem/1.4 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
    h1 { font-family: Newsreader, Georgia, serif; font-size: clamp(3.8rem, 10vw, 7.5rem); font-weight: 400; line-height: .95; margin: 1.5rem 0 2rem; }
    .studio-intro { max-width: 36rem; font: 1.2rem/1.6 Inter, sans-serif; color: #4d4b47; margin-bottom: 3rem; }
    form { border-top: 1px solid #d8d2c9; padding-top: 1.5rem; max-width: 31rem; display: grid; gap: 1rem; }
    form[hidden] { display: none; }
    label { font: 500 .9rem/1.4 Inter, sans-serif; }
    input { width: 100%; border: 1px solid #9d968c; background: #fffdf9; border-radius: 0; padding: .85rem 1rem; font: 1rem/1.4 Inter, sans-serif; }
    button { justify-self: start; margin-top: .5rem; }
    #studio-status { min-height: 2rem; margin-top: 1.5rem; font: .95rem/1.5 Inter, sans-serif; }
  </style>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
  {siteKey && <script>
    const requestForm = document.querySelector<HTMLFormElement>('#studio-code-request');
    const verifyForm = document.querySelector<HTMLFormElement>('#studio-code-verify');
    const status = document.querySelector<HTMLElement>('#studio-status');
    requestForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!requestForm || !verifyForm || !status) return;
      const email = (requestForm.elements.namedItem('email') as HTMLInputElement).value;
      const turnstileToken = (requestForm.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]'))?.value ?? '';
      const button = requestForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const response = await fetch('/api/studio/code', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, turnstileToken }) });
        const result = await response.json() as { message?: string; error?: string };
        status.textContent = result.message ?? result.error ?? 'Please try again.';
        if (response.ok) { verifyForm.hidden = false; verifyForm.querySelector('input')?.focus(); }
      } catch { status.textContent = 'Could not reach the studio. Please try again.'; }
      finally {
        if (button) button.disabled = false;
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
    verifyForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!requestForm || !verifyForm || !status) return;
      const email = (requestForm.elements.namedItem('email') as HTMLInputElement).value;
      const code = (verifyForm.elements.namedItem('code') as HTMLInputElement).value;
      const button = verifyForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const response = await fetch('/api/studio/session', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, code }) });
        const result = await response.json() as { error?: string };
        if (response.ok) { location.assign('/studio'); return; }
        status.textContent = result.error ?? 'Please try again.';
      } catch { status.textContent = 'Could not reach the studio. Please try again.'; }
      finally { if (button) button.disabled = false; }
    });
  </script>}
</BaseLayout>
