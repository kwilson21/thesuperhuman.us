---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import { clientPaymentDue, clientPortalEnabled, clientProjectForSession, studioSessionFromRequest } from '~/lib/audio-client-access';
import { latestReviewDecision, listProjectMessages, REVISION_ROUNDS, revisionRoundsLeft } from '~/lib/audio-project-messages';
import { listProjectUpdates } from '~/lib/audio-project-updates';
import { clientProjectFiles } from '~/lib/audio-project-files';
import ProjectMessages from '~/components/ProjectMessages.astro';
import ReviewResponse from '~/components/ReviewResponse.astro';
import AudioProjectUpdates from '~/components/AudioProjectUpdates.astro';
import ProjectPlayer from '~/components/ProjectPlayer.astro';
import StageTrack from '~/components/StageTrack.astro';
import StudioUnavailable from '~/components/StudioUnavailable.astro';
const env = Astro.locals.runtime?.env;
if (!clientPortalEnabled(env)) return new Response('Not found', { status: 404 });
if (!env.MUSIC_DB) return new Response('Studio is temporarily unavailable.', { status: 503 });
const token = studioSessionFromRequest(Astro.request);
if (!token) return Astro.redirect('/studio/sign-in');
const project = Astro.params.id ? await clientProjectForSession(env.MUSIC_DB, token, Astro.params.id) : null;
if (!project) Astro.response.status = 404;
const messages = project ? await listProjectMessages(env.MUSIC_DB, project.request_id) : [];
const updates = project ? await listProjectUpdates(env.MUSIC_DB, project.request_id) : [];
const files = project ? await clientProjectFiles(env.MUSIC_DB, project.request_id, token) : [];
const finalExpiry = files.find(file => file.version === 'final')?.expires_at;
const paymentDue = project ? clientPaymentDue(project) : null;
const currentReview = project?.stage === 'review_ready' ? files.find(file => file.version === 'review') : undefined;
const reviewShared = Boolean(currentReview);
const decision = reviewShared ? await latestReviewDecision(env.MUSIC_DB, project!.request_id) : null;
const roundsLeft = reviewShared ? await revisionRoundsLeft(env.MUSIC_DB, project!.request_id) : 0;
const next = !project ? '' : project.stage === 'files_under_review' ? 'I’m checking the files and direction you sent.' :
  paymentDue?.installment === 'booking' ? 'Your booking invoice is ready below. Stripe also emailed it to you.' :
  project.stage === 'accepted' && project.booking_status !== 'paid' ? 'Your booking details are being confirmed.' :
  project.stage === 'accepted' ? 'Your song is booked. I’ll post an update when work begins.' :
  project.stage === 'in_progress' ? 'I’m working on your song. You’ll get an email when there’s something to hear.' :
  reviewShared && decision === 'approved' ? 'You approved this mix. Next come the remaining balance and your final files.' :
  reviewShared && decision === 'changes' ? 'Your notes are in. I’ll start on the changes.' :
  reviewShared ? 'Your review is ready below. Listen, then approve it or request changes.' :
  project.stage === 'revision_in_progress' ? 'Your notes are in. I’m working on the revision now.' :
  project.stage === 'final_files_ready' && finalExpiry ? 'Your final audio is ready to listen to or download below.' :
  project.stage === 'complete' && finalExpiry ? 'Your completed audio stays here through its availability date.' :
  'I’ll keep this page updated as your song moves forward.';
const money = (cents: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
const longDate = (value: string) => new Date(`${value}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const moved = project?.original_due_at && project.current_due_at && project.original_due_at !== project.current_due_at;
---
{project ? <BaseLayout title={`${project.summary} · Studio`} description="Your private audio project." noindex>
  <article class="site-shell studio-project">
    <p class="studio-kicker"><a href="/studio">Your songs</a> / Project</p>
    <h1>{project.summary}</h1>
    <StageTrack stage={project.stage} bookingPaid={project.booking_status === 'paid'} />
    <div class="studio-status-row">
      <p class="studio-next">{next}</p>
      {finalExpiry ? <p class="studio-date"><span>Available through</span><strong>{new Date(finalExpiry).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</strong></p>
        : project.current_due_at && <p class="studio-date"><span>Expected by</span><strong>{longDate(project.current_due_at)}</strong>{moved && <del>{longDate(project.original_due_at!)}</del>}</p>}
    </div>
    {paymentDue && <section class="studio-pay" aria-labelledby="studio-pay-heading">
      <div><p class="studio-kicker">Payment</p><h2 id="studio-pay-heading">{paymentDue.installment === 'booking' ? 'Your booking invoice is ready' : 'Your remaining balance is ready'}</h2>
        <p>{paymentDue.installment === 'booking' ? 'Paying it books your song, and work starts once it clears.' : 'Your final files are released here after it clears.'} Payment is handled securely by Stripe.</p></div>
      <a class="studio-button" href={paymentDue.href} target="_blank" rel="noopener noreferrer">Pay {money(paymentDue.amountCents)} <span aria-hidden="true">↗</span></a>
    </section>}
    {files.length > 0 && <section class="studio-files" aria-labelledby="studio-files-heading"><h2 id="studio-files-heading" class="studio-kicker">Listen</h2>
      {files.map(file => {
        const href = `/api/studio/projects/${encodeURIComponent(project.request_id)}/files/${encodeURIComponent(file.id)}`;
        return <ProjectPlayer src={href} name={file.display_name} label={file.version === 'final' ? 'Final audio' : 'Review audio'} peaks={file.peaks} downloadHref={file.downloadable ? `${href}?download=1` : undefined} />;
      })}
    </section>}
    {reviewShared && !decision && <ReviewResponse endpoint={`/api/studio/projects/${encodeURIComponent(project.request_id)}/messages`} reviewId={currentReview!.id} roundsLeft={roundsLeft} rounds={REVISION_ROUNDS} />}
    <AudioProjectUpdates updates={updates} currentDueAt={project.current_due_at} stage={project.stage} />
    <ProjectMessages messages={messages} endpoint={`/api/studio/projects/${encodeURIComponent(project.request_id)}/messages`} reader="client" closed={project.stage === 'complete'} />
  </article>
  <style>
    .studio-project { max-width: 72rem; margin: 0 auto; padding: clamp(4rem, 9vw, 7rem) 1.5rem 8rem; }
    .studio-kicker { margin: 0; color: var(--accent); font: 500 .78rem/1.4 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
    .studio-kicker a { text-decoration: underline; text-underline-offset: .25em; }
    h1 { font: 400 clamp(3.2rem, 8vw, 6.4rem)/1 Newsreader, Georgia, serif; margin: 1.5rem 0 3rem; max-width: 60rem; text-wrap: balance; }
    .studio-status-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; margin: 3rem 0 0; padding: 2rem 0; border-top: 1px solid var(--rule); }
    .studio-next { max-width: 34rem; margin: 0; font: 400 clamp(1.35rem, 2.6vw, 1.8rem)/1.3 Newsreader, Georgia, serif; }
    .studio-date { display: grid; gap: .2rem; margin: 0; text-align: right; font: .82rem/1.4 Inter, sans-serif; color: var(--studio-muted); }
    .studio-date strong { color: var(--ink); font: 400 1.7rem/1.1 Newsreader, Georgia, serif; }
    .studio-date del { font-size: .82rem; }
    .studio-pay { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding: 1.75rem 0 2rem; border-top: 1px solid var(--rule); }
    .studio-pay h2 { margin: .5rem 0 .4rem; font: 400 clamp(1.6rem, 3vw, 2.2rem)/1.15 Newsreader, Georgia, serif; }
    .studio-pay p:not(.studio-kicker) { margin: 0; max-width: 34rem; color: var(--studio-muted); font: .95rem/1.55 Inter, sans-serif; }
    .studio-pay .studio-button { text-decoration: none; }
    .studio-files { display: grid; padding: 1.5rem 0 2rem; border-top: 1px solid var(--rule); }
    .studio-files :global(.player + .player) { border-top: 1px solid var(--rule); }
    @media (max-width: 45rem) { .studio-date { text-align: left; } }
  </style>
  <script>import { setupProjectMessages } from '~/scripts/project-messages'; import { setupProjectPlayers } from '~/scripts/project-player'; import { setupReviewResponse } from '~/scripts/review-response'; setupProjectMessages(); setupProjectPlayers(); setupReviewResponse();</script>
</BaseLayout> : <StudioUnavailable />}
