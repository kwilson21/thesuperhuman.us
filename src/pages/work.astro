---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import ExperienceRow from '~/components/ExperienceRow.astro';
import WorkDiagram from '~/components/WorkDiagram.astro';
import { experience, lyftBonus, lyftTeams, workFocus, workingPreference } from '~/data/profile';
---
<BaseLayout title="Work · Kazon Wilson" description="Software engineer building with AI. Work highlights, professional experience, and an approach grounded in exploration, iteration, and engineering judgment.">
  <div class="site-shell primary-page work-page">
    <header class="work-intro">
      <div><p class="page-kicker">Work</p><h1 class="page-title">Software engineer.<br />Building with AI.</h1><p class="page-lede">I turn ideas into working software through exploration, iteration, and engineering judgment.</p><div class="site-links"><a class="site-link" href="#selected-work">Work highlights <span aria-hidden="true">→</span></a><a class="site-link" href="#experience">Experience <span aria-hidden="true">→</span></a><a class="site-link" href="/services">Software services <span aria-hidden="true">→</span></a><a class="site-link" href="/about#resumes">Request resume <span aria-hidden="true">→</span></a></div></div>
      <aside aria-label="At a glance"><h2>At a glance</h2><ul><li><span aria-hidden="true">01</span>7+ years in production engineering</li><li><span aria-hidden="true">02</span>AI-assisted building</li><li><span aria-hidden="true">03</span>Cross-team delivery</li><li><span aria-hidden="true">04</span>Website design</li></ul></aside>
    </header>
    <p class="working-preference">{workFocus} {workingPreference}</p>
    <section id="selected-work" class="site-section">
      <div class="site-section-heading"><h2>Work highlights</h2></div>
      <article id="lyft" class="selected-story">
        <div><p class="page-kicker">Lyft · Associate Tools</p><h3>More independence for support.</h3><p class="story-summary">Refactored a bonus tool and added visibility so support could run and monitor the work.</p><p class="capacity-figure">{lyftBonus.before} <span aria-hidden="true">→</span><span class="sr-only">to</span> {lyftBonus.after} rows</p><p class="text-muted text-sm">{lyftBonus.evidence}</p>
          <details class="context-disclosure"><summary>Read the context <span aria-hidden="true">+</span></summary><div><p>The customer incident response team used this tool to issue driver bonuses. I rewrote its batch handling and added Grafana observability, making runs visible to the people responsible for them.</p><p>The figures describe rows handled per batch. They are from my career account; they do not measure runtime or a new benchmark.</p></div></details>
          <a class="site-link lyft-scope-link" href="#lyft-background">Explore my work across three Lyft teams <span aria-hidden="true">→</span></a>
        </div><WorkDiagram kind="bonus" />
      </article>
      <article id="skupos" class="selected-story">
        <div><p class="page-kicker">Skupos</p><h3>Turning analyst work into software.</h3><p class="story-summary">Built an internal service to automate POS data-quality troubleshooting.</p><details class="context-disclosure"><summary>Read the context <span aria-hidden="true">+</span></summary><div><p>Analysts were using Google Sheets and ad-hoc Python scripts. I designed and built a Python WSGI application on AWS EC2 to bring that troubleshooting into one tool.</p><p>The aim was to scale operations through application performance instead of continually adding analysts. It was an early lesson in connecting engineering decisions to the work people actually do.</p></div></details></div><WorkDiagram kind="analyst" />
      </article>
    </section>
    <section id="experience" class="site-section"><div class="site-section-heading"><h2>Experience</h2></div>{experience.map(job => <ExperienceRow {...job}>
      {job.id === 'lyft' && <div class="lyft-teams">{lyftTeams.map(team => <section aria-label={team.name}>
        <h4>{team.name}</h4>
        <ul>{team.projects.map(project => <li><strong>{project.title}.</strong> {project.description}</li>)}</ul>
      </section>)}</div>}
    </ExperienceRow>)}</section>
    <section class="site-section"><div class="site-section-heading"><h2>How I work</h2></div><div class="working-values"><div><h3>Ownership</h3><p>I take responsibility and see things through.</p></div><div><h3>Async collaboration</h3><p>Clear communication keeps work moving.</p></div><div><h3>AI-assisted development</h3><p>I use AI to move faster, with engineering judgment and validation.</p></div></div><div class="site-links"><a class="site-link" href="/writing/ai-gives-you-speed">Read my perspective <span aria-hidden="true">→</span></a><a class="site-link" href="/building">Explore personal projects <span aria-hidden="true">→</span></a></div></section>
    <section class="page-connect"><div><p class="page-kicker">Let’s talk</p><h2>An interesting problem or possibility?</h2><p>I’d love to hear about it.</p></div><a class="site-button" href="/#contact">Get in touch</a></section>
  </div><Footer compact slot="footer" />
</BaseLayout>
<script>
  function revealExperience(hash = location.hash) {
    const target = document.getElementById(hash.slice(1));
    if (target instanceof HTMLDetailsElement) { target.open = true; target.scrollIntoView(); }
  }
  revealExperience();
  window.addEventListener('hashchange', () => revealExperience());
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => revealExperience(link.hash));
  });
</script>
<style>
  .work-intro { display: grid; grid-template-columns: 1.55fr 1fr; gap: 5rem; align-items: center; }
  .work-intro .page-title { font-size: clamp(3.25rem, 5.5vw, 4.75rem); }
  .work-intro .site-links { margin-top: 2rem; }
  aside { border-left: 1px solid var(--rule); padding-left: 2.5rem; }
  aside h2 { font-size: 1.75rem; }
  aside li { display: flex; gap: 1.5rem; align-items: center; padding-block: 1.4rem; font-size: 1.125rem; line-height: 1.4; }
  aside li + li { border-top: 1px solid var(--rule); }
  aside li span { color: var(--accent); font-family: 'JetBrains Mono', monospace; font-size: .8rem; }
  .working-preference { border-top: 1px solid var(--rule); padding-top: 1.5rem; margin-top: 2.5rem; font-size: 1.125rem; }
  .selected-story { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3.5rem; align-items: start; padding-block: .5rem 2rem; }
  .selected-story + .selected-story { border-top: 1px solid var(--rule); padding-top: 2.5rem; }
  h3 { font-size: clamp(1.65rem, 2.7vw, 2.2rem); line-height: 1.15; letter-spacing: -.025em; }
  .story-summary { font-size: 1.2rem; line-height: 1.45; color: var(--muted); margin-block: .8rem 1.5rem; max-width: 30rem; }
  .lyft-scope-link { margin-top: 1rem; font-size: .95rem; }
  .lyft-teams { margin-block: 1.5rem; }
  .lyft-teams section { border-left: 2px solid var(--rule); padding-left: 1.25rem; }
  .lyft-teams section + section { margin-top: 1.75rem; }
  .lyft-teams h4 { font-size: 1.35rem; line-height: 1.3; margin-bottom: .6rem; }
  .lyft-teams ul { list-style: none; }
  .lyft-teams li { line-height: 1.65; }
  .lyft-teams li + li { margin-top: 1rem; }
  .lyft-teams strong { font-weight: 600; }
  .capacity-figure { font-size: clamp(1.9rem, 3vw, 2.65rem); line-height: 1.2; letter-spacing: -.025em; }
  .capacity-figure span { color: var(--accent); }
  .working-values { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; margin-bottom: 2rem; }
  .working-values > div { border-left: 2px solid var(--rule); padding-left: 1.3rem; }
  .working-values h3 { font-size: 1.4rem; margin-bottom: .5rem; }.working-values p { color: var(--muted); }
  @media(max-width: 800px) {
    .work-intro { grid-template-columns: 1fr; gap: 2.5rem; } aside { border-left: 0; border-top: 1px solid var(--rule); padding: 1.5rem 0 0; } aside li { padding-block: 1rem; }
    .selected-story { grid-template-columns: 1fr; gap: 1.5rem; }.working-values { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
