---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import ExperienceRow from '~/components/ExperienceRow.astro';
import WorkDiagram from '~/components/WorkDiagram.astro';
import { personJsonLd, experience, lyftBonus, lyftTeams, skuposStages, workingPreference } from '~/data/profile';
---
<BaseLayout jsonLd={personJsonLd} title="Work · Kazon Wilson" description="See how I automated transaction-data troubleshooting at Skupos and built rental features and internal tools at Lyft.">
  <div class="site-shell primary-page work-page">
    <header class="work-intro">
      <p class="page-kicker">Work</p>
      <h1 class="page-title">Software engineer.<br />I build useful software.</h1>
      <p class="page-lede">7+ years in production engineering: I automated transaction-data troubleshooting at Skupos and built rental features and internal tools at Lyft. {workingPreference}</p>
      <p class="work-evidence">Tally is my current example of product ownership with AI: I set the direction, shape the product and architecture, and AI coding agents implement it. <a class="site-link" href="/building/tally/">Tally development journal <span aria-hidden="true">→</span></a></p>
      <div class="site-links"><a class="site-link" href="/about#resumes">Request my resume <span aria-hidden="true">→</span></a><a class="site-link" href="/services#software">Hire me for software <span aria-hidden="true">→</span></a></div>
    </header>
    <section id="selected-work" class="site-section">
      <div class="site-section-heading"><h2>Work highlights</h2></div>
      <article id="lyft" class="selected-story">
        <div><p class="page-kicker">Lyft - Associate Tools team</p><h3>Support could run and monitor driver-bonus batches.</h3><p class="story-summary">{lyftBonus.description}</p><p class="capacity-figure">{lyftBonus.before} <span aria-hidden="true">→</span><span class="sr-only">to</span> {lyftBonus.after} rows per batch</p><p class="text-muted text-sm">{lyftBonus.evidence}</p>
          <details class="context-disclosure"><summary>Read the context <span aria-hidden="true">+</span></summary><div><p>The customer incident response team used this tool to issue driver bonuses. I rewrote its batch handling and added Grafana observability, making runs visible to the people responsible for them.</p><p>The figures describe rows handled per batch. They are from my career account; they do not measure runtime or a new benchmark.</p></div></details>
        </div><WorkDiagram kind="bonus" />
      </article>
      <article id="skupos" class="selected-story">
        <div><p class="page-kicker">Skupos</p><h3>From scripts to a system I owned.</h3><p class="story-summary">I built a tool that helped data operators troubleshoot retail transactions and automated updates to Google Sheets, keeping them as the teams’ shared source of truth.</p>
          <details class="context-disclosure"><summary>Read the context <span aria-hidden="true">+</span></summary><div>
            <p>I started with Python scripts that automated tobacco scan-data troubleshooting and updates to Google Sheets for data operations and account managers. Those scripts became background tasks managed by a Flask application, scheduled through Huey, with MySQL on AWS. I extended an existing internal React page so data operators could use the tools.</p>
            <p>The application supported transaction-data troubleshooting across 3,000+ retailer locations. The tobacco scan-data automation supported 3–5× store growth without increasing operations headcount.</p>
            <p>I then took ownership of multipack matching in the core product’s Rails reporting rewrite. That move into product feature ownership continued at Lyft.</p>
          </div></details>
        </div><WorkDiagram kind="analyst" />
      </article>
    </section>
    <section id="experience" class="site-section"><div class="site-section-heading"><h2>Experience</h2></div>{experience.map(job => <ExperienceRow {...job}>
      {(job.id === 'lyft' || job.id === 'skupos') && <div class="experience-groups">{(job.id === 'lyft' ? lyftTeams : skuposStages).map(team => <section aria-label={team.name}>
        <h4>{team.name}</h4>
        <ul>{team.projects.map(project => <li><strong>{project.title}.</strong> {project.description}</li>)}</ul>
      </section>)}</div>}
    </ExperienceRow>)}</section>
    <section class="page-connect"><div><p class="page-kicker">Let’s talk</p><h2>Have a problem worth exploring?</h2><p>I’d love to hear about it.</p></div><a class="site-button" href="/#contact">Get in touch</a></section>
  </div><Footer compact slot="footer" />
</BaseLayout>
<script>
  import { runMotion } from '~/scripts/scroll-scenes';
  // Restrained on purpose: only the two evidence diagrams build as they arrive.
  runMotion();
  function revealExperience(hash = location.hash) {
    const target = document.getElementById(hash.slice(1));
    if (target instanceof HTMLDetailsElement) { target.open = true; target.scrollIntoView(); }
  }
  revealExperience();
  window.addEventListener('hashchange', () => revealExperience());
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => revealExperience(link.hash));
  });
</script>
<style>
  .work-intro { max-width: 46rem; }
  .work-evidence { margin-top: 1rem; color: var(--muted); font-size: 1.125rem; }
  .work-intro .site-links { margin-top: 2rem; }
  .selected-story { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3.5rem; align-items: start; padding-block: .5rem 2rem; }
  .selected-story + .selected-story { border-top: 1px solid var(--rule); padding-top: 2.5rem; }
  h3 { font-size: clamp(1.65rem, 2.7vw, 2.2rem); line-height: 1.15; letter-spacing: -.025em; }
  .story-summary { font-size: 1.2rem; line-height: 1.45; color: var(--muted); margin-block: .8rem 1.5rem; max-width: 30rem; }
  .experience-groups { margin-block: 1.5rem; }
  .experience-groups section { border-left: 2px solid var(--rule); padding-left: 1.25rem; }
  .experience-groups section + section { margin-top: 1.75rem; }
  .experience-groups h4 { font-size: 1.35rem; line-height: 1.3; margin-bottom: .6rem; }
  .experience-groups ul { list-style: none; }
  .experience-groups li { line-height: 1.65; }
  .experience-groups li + li { margin-top: 1rem; }
  .experience-groups strong { font-weight: 700; }
  .capacity-figure { font-size: clamp(1.9rem, 3vw, 2.65rem); line-height: 1.2; letter-spacing: -.025em; }
  .capacity-figure span { color: var(--accent); }
  @media(max-width: 800px) {
    .selected-story { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
