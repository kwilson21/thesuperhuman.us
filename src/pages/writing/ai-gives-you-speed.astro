---
export const prerender = false;
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';

const entry = await getEntry('pages', 'ai-gives-you-speed');
if (!entry) throw new Error('AI essay content missing');
const { Content, headings } = await entry.render();
const sections = headings.filter(heading => heading.depth === 2);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="site-shell essay-layout">
    <aside class="essay-contents">
      <nav aria-label="In this essay">
        <p>In this essay</p>
        <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
      </nav>
    </aside>
    <article class="essay-article">
      <header class="essay-header">
        <p class="page-kicker"><a href="/writing">Writing</a> / AI-assisted engineering</p>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">{entry.data.description}</p>
        <p class="essay-byline"><a href="/about">Kazon Wilson</a></p>
      </header>
      <details class="essay-mobile-contents context-disclosure">
        <summary>In this essay</summary>
        <nav aria-label="Essay sections"><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav>
      </details>
      <div class="prose-writing"><Content /></div>
      <div class="essay-projects"><a class="site-link" href="/building">Explore the projects <span aria-hidden="true">→</span></a></div>
      <nav class="essay-close" aria-label="Continue exploring"><a class="site-link" href="/writing">Back to Writing <span aria-hidden="true">←</span></a><a class="site-link" href="/#contact">Get in touch <span aria-hidden="true">→</span></a></nav>
    </article>
  </div>
  <Footer compact slot="footer" />
</BaseLayout>
<style>
  .essay-layout { display: grid; grid-template-columns: 210px minmax(0, 760px); gap: clamp(2rem, 5vw, 4.5rem); padding-block: clamp(3rem, 6vw, 5rem) 2rem; }
  .essay-contents nav { position: sticky; top: 2rem; }
  .essay-contents p { font-size: .9rem; margin-bottom: 1rem; }
  .essay-contents ol, .essay-mobile-contents ol { list-style: none; }
  .essay-contents li { border-left: 1px solid var(--rule); padding: .6rem 0 .6rem 1rem; font-size: .85rem; line-height: 1.5; color: var(--muted); }
  .essay-contents a:hover, .essay-mobile-contents a:hover { color: var(--accent); }
  .essay-header { padding-bottom: 2rem; border-bottom: 1px solid var(--rule); margin-bottom: 2rem; }
  .essay-header .page-title { font-size: clamp(2.75rem, 4.7vw, 4.3rem); line-height: 1.02; }
  .essay-header .page-lede { font-size: clamp(1.3rem, 2vw, 1.6rem); margin-top: 1.5rem; }
  .essay-byline { margin-top: 1.5rem; font-size: .95rem; }
  .essay-mobile-contents { display: none; }
  .essay-projects { margin-block: 2rem; }
  .essay-close { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; padding-block: 2rem; border-top: 1px solid var(--rule); }
  @media(max-width: 1000px) {
    .essay-layout { display: block; max-width: 840px; }
    .essay-contents { display: none; }
    .essay-mobile-contents { display: block; margin-bottom: 2rem; }
    .essay-mobile-contents li { padding-block: .5rem; line-height: 1.5; }
  }
</style>
<style is:global>
  .prose-writing { font-family: theme('fontFamily.serif'); color: var(--ink); max-width: 42rem; }
  .prose-writing > * + * { margin-top: 1.3em; }
  .prose-writing h2 { font-size: clamp(1.7rem, 3vw, 2.15rem); line-height: 1.15; margin-top: 3rem; scroll-margin-top: 2rem; letter-spacing: -.02em; }
  .prose-writing p { font-size: 1.2rem; line-height: 1.65; }
  .prose-writing strong { font-weight: 600; }
  .prose-writing em { font-style: italic; }
  .prose-writing a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .prose-writing blockquote { margin: 2rem 0; padding-left: 1.25rem; border-left: 2px solid var(--accent); color: var(--muted); }
  .direction-comparison { margin-block: 2rem; }
  .direction-path { padding: 1.25rem; background: #f3eee5; }
  .direction-path + .direction-path { border-top: 1px solid var(--rule); }
  .direction-path h3 { color: var(--accent); font-size: 1.25rem; }
  .direction-path svg { display: block; width: 100%; height: auto; margin-block: .75rem; }
  .direction-labels { display: flex; justify-content: space-between; gap: 1rem; font: .75rem/1.4 Inter, sans-serif; }
  .direction-comparison figcaption { margin-top: .75rem; color: var(--muted); font: .8rem/1.6 Inter, sans-serif; }
</style>
