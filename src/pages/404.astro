---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
---
<BaseLayout title="Page not found · Kazon Wilson" description="This page could not be found. Explore Kazon Wilson’s projects or return to the homepage." noindex>
  <section class="missing-page site-shell" aria-labelledby="missing-title">
    <div class="missing-copy">
      <p class="missing-status">404</p>
      <h1 id="missing-title">This page isn’t here.</h1>
      <p class="missing-description">The link may have changed. You can return home and find your way from there.</p>
      <div class="missing-actions">
        <a class="site-button" href="https://thesuperhuman.us/">Back to home</a>
        <a class="missing-secondary" href="https://thesuperhuman.us/building">Explore my projects</a>
      </div>
    </div>
  </section>
  <Footer compact slot="footer" />
</BaseLayout>
<style>
  .missing-page { display: grid; place-items: center; min-height: clamp(32rem, calc(100svh - 260px), 44rem); padding-block: 5rem 6rem; }
  .missing-copy { width: 100%; max-width: 680px; text-align: center; }
  .missing-status { color: var(--muted); font-size: .95rem; margin: 0 0 1.5rem; }
  h1 { font-size: clamp(2.5rem, 4.7vw, 3.75rem); line-height: 1.12; letter-spacing: -.035em; margin: 0 0 1.5rem; }
  .missing-description { max-width: 36ch; margin: 0 auto 2rem; font-size: 1.125rem; line-height: 1.65; color: var(--muted); }
  .missing-actions { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .missing-actions .site-button { min-height: 48px; padding-inline: 1.75rem; }
  .missing-secondary { color: var(--muted); font-size: 1rem; }
  .missing-secondary:hover { color: var(--accent); }
  @media (max-width: 600px) {
    .missing-page { min-height: 30rem; padding-block: 3.5rem 4.5rem; }
    .missing-description { max-width: 30ch; }
  }
</style>
