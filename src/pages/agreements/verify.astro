---
export const prerender = false;

import AgreementLayout from "~/layouts/AgreementLayout.astro";
import { redeemLinkPage } from "~/server/redeem-page";

// formData() refuses a body that is not a form (JSON, plain text) with a TypeError: such a POST reads as one with no key.
function notAForm<Failure>(failure: Failure) {
	if (failure instanceof TypeError) return null;

	throw failure;
}

const key =
	Astro.request.method === "POST"
		? String((await Astro.request.formData().catch(notAForm))?.get("key") ?? "")
		: (Astro.url.searchParams.get("key") ?? "");

// The redeem (src/server/redeem-page.ts): the expired page's 401 for any refusal, the failure page's 500 for a failure on
// the site's side (a store failure or a defect), logged once.
const response = await redeemLinkPage(
	Astro.locals.runtime.env,
	Astro.request,
	key,
	undefined,
);

if (response.status === 303) return response;

Astro.response.status = response.status;

Astro.response.headers.set("Referrer-Policy", "no-referrer");

Astro.response.headers.set("Cache-Control", "no-store");

const valid = response.status === 200;

const failed = response.status === 500;
---
<AgreementLayout title={valid ? "Your documents are ready" : failed ? "This link could not be opened" : "This link has expired"}>
{valid ? <>

<h1 class="page-title">Your documents are ready.</h1>
<form class="agreement-form" method="post" action={Astro.url.pathname}><input type="hidden" name="key" value={key} /><button class="studio-button">Continue</button></form>
<p class="agreement-hint">This link works once.</p>
</> : failed ? <><h1 class="page-title">This link could not be opened.</h1><p class="page-lede">Something went wrong on my side. Try the link again in a few minutes.</p></> : <><h1 class="page-title">This link has expired.</h1><p class="page-lede">Links work once and last an hour.</p><p class="agreement-form"><a class="studio-button" href={'/agreements'}>Send a new link</a></p></>}
</AgreementLayout>
