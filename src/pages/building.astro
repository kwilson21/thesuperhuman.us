---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import BuildingIllustration from '~/components/BuildingIllustration.astro';
import dailyStory from '~/data/project-stories/the-engineers-daily.json';
import { tallyStory } from '~/data/project-stories/tally';
import { kailleraStory } from '~/data/project-stories/kaillera-next';
import { websiteStory } from '~/data/project-stories/personal-website';
import { threadlineStory } from '~/data/project-stories/threadline';
const projects = [
  { kind: 'tally' as const, title: 'Tally', status: tallyStory.status,
    description: 'Review transactions, set monthly budgets and see what remains to spend.',
    actions: ['Organize purchases into categories.', 'Set rules for repeat merchants.', 'Track spending against your budget.'],
    detail: 'AI suggests categories. Code calculates the money.', role: 'I set the direction; Claude Code writes the code.',
    links: [{ label: 'Try demo', href: 'https://tally-demo.thesuperhuman.us' }, { label: 'GitHub', href: 'https://github.com/kwilson21/tally' }, { label: 'Development journal', href: '/building/tally#tally-updates-title' }] },
  { kind: 'kaillera' as const, title: 'Kaillera-next', status: kailleraStory.status,
    description: 'Open a link and play supported retro games with friends.',
    actions: ['Create a room and invite friends.', 'Play together or watch a game.', 'Use a controller or touch controls.'],
    detail: 'Built on EmulatorJS, with rollback and host-streaming modes.', role: '',
    links: [{ label: 'Explore build', href: 'https://kaillera-next.thesuperhuman.us' }, { label: 'GitHub', href: 'https://github.com/kwilson21/kaillera-next' }, { label: 'Development journal', href: '/building/kaillera-next#kaillera-next-updates-title' }] },
  { kind: 'website' as const, title: 'Personal website', status: websiteStory.status,
    description: 'See what I can build for you, hear what I can do for your music, and hire me.',
    actions: ['Explore my software work and hear my mixes.', 'Tell me what you want to build or finish.', 'Start a paid software or audio project.'],
    detail: '', role: 'I direct the design and build with AI.',
    links: [{ label: 'Work with me', href: '/services' }, { label: 'GitHub', href: 'https://github.com/kwilson21/thesuperhuman.us' }, { label: 'Development journal', href: '/building/personal-website#personal-website-updates-title' }] },
];
const prototypes = [
  { title: dailyStory.title, status: dailyStory.status, description: 'Practice coding through a story, alongside Scripture, prayer and reflection.', href: '/building/the-engineers-daily' },
  { title: threadlineStory.title, status: threadlineStory.status, description: 'Pick up interrupted development work with its context intact.', href: '/building/threadline' },
];
---
<BaseLayout title="Building · Kazon Wilson" description="Try my budgeting and browser multiplayer projects, explore my work, and see how I build with AI.">
  <div class="site-shell primary-page">
    <header class="building-intro"><p class="page-kicker">Building</p><h1 class="page-title">Things I’m making.</h1><p class="page-lede">What you can do with each project, and how I’m building it.</p></header>
    <section class="site-section selected-projects" aria-label="Selected projects">
      {projects.map(project => <article class="project-feature" data-reveal>
        <BuildingIllustration kind={project.kind} />
        <div class="project-copy">
          <h2>{project.title}</h2><p class="page-kicker project-status">{project.status}</p>
          <p class="project-subtitle">{project.description}</p>
          <ul class="project-actions" role="list">{project.actions.map((action,index) => <li><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{index === 0 ? <><rect x="3" y="6" width="18" height="15" rx="2"/><path d="M8 6V3h8v3"/></> : index === 1 ? <><path d="M3 12h18M6 7v10M12 4v16M18 7v10"/></> : <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></>}</svg><span>{action}</span></li>)}</ul>
          <div class="project-context">{project.detail && <p>{project.detail}</p>}{project.role && <p>{project.role}</p>}</div>
          <div class="site-links project-links">{project.links.map(link => <a class="site-link" href={link.href}>{link.label}<span class="sr-only"> for {project.title}</span><span aria-hidden="true">→</span></a>)}</div>
        </div>
      </article>)}
    </section>
    <section class="earlier-prototypes" aria-labelledby="earlier-prototypes-title" data-reveal>
      <div class="site-section-heading"><h2 id="earlier-prototypes-title">Earlier prototypes</h2></div>
      <p class="prototype-intro">These projects are paused. Their pages and development journals remain available.</p>
      <div class="prototype-list">{prototypes.map(project => <article><p class="page-kicker">{project.status}</p><h3><a href={project.href}>{project.title}<span aria-hidden="true"> →</span></a></h3><p>{project.description}</p></article>)}</div>
    </section>
    <p class="journal-note">The journals show what changed, what I tested and what I’m working on next.</p>
  </div><Footer compact slot="footer" />
</BaseLayout>
<script>
  import { runMotion } from '~/scripts/scroll-scenes';
  runMotion();
</script>
<style>
  .building-intro { max-width: 48rem; }
  .building-intro .page-title { overflow-wrap: anywhere; }
  .selected-projects { margin-top: 3rem; }
  .project-feature { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(0,1fr); gap: clamp(2rem,4vw,3.5rem); align-items: center; padding-block: 3rem; border-bottom: 1px solid var(--rule); }
  .project-feature:first-child { padding-top: 0; }
  .project-copy { min-width: 0; }.project-copy h2 { font-size: clamp(2rem,3.2vw,2.8rem); line-height: 1.15; letter-spacing: -.025em; }
  .project-status { margin-block: .5rem 1.1rem; }.project-subtitle { font-size: 1.25rem; line-height: 1.4; }
  .project-actions { display: grid; gap: .9rem; list-style: none; padding: 0; margin-block: 1.5rem; }.project-actions li { display: flex; gap: .85rem; align-items: flex-start; line-height: 1.45; }.project-actions svg { flex-shrink: 0; margin-top: .05rem; }
  .project-context { border-top: 1px solid var(--rule); padding-top: 1rem; font-size: .9375rem; line-height: 1.55; color: var(--muted); }.project-links { margin-top: 1.3rem; gap: .65rem 1.35rem; font-size: .9375rem; }.project-links .site-link { min-height: 44px; align-items: center; }
  .earlier-prototypes { margin-top: 3rem; }.prototype-intro { color: var(--muted); max-width: 40rem; margin-bottom: 1.5rem; }.prototype-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2.5rem; }.prototype-list .page-kicker { margin-bottom: .4rem; }.prototype-list h3 { font-size: 1.5rem; margin-bottom: .65rem; }.prototype-list h3 a { display: inline-block; min-height: 44px; }.prototype-list h3 span { color: var(--accent); }.prototype-list article > p:last-child { color: var(--muted); }
  .journal-note { border-top: 1px solid var(--rule); margin-top: 3rem; padding-top: 1.5rem; font-size: 1.125rem; }
  @media(max-width: 800px) { .project-feature { grid-template-columns: 1fr; gap: 1.75rem; padding-block: 2.5rem; }.project-copy { grid-row: 1; }.prototype-list { grid-template-columns: 1fr; gap: 1.75rem; } }
</style>
