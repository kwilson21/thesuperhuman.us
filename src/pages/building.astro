---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import dailyStory from '~/data/project-stories/the-engineers-daily.json';
import { tallyStory } from '~/data/project-stories/tally';
import { kailleraStory } from '~/data/project-stories/kaillera-next';
import { websiteStory } from '~/data/project-stories/personal-website';
import { threadlineStory } from '~/data/project-stories/threadline';
import dailyPreview from '~/assets/projects/daily-preview.webp';
import tallyHome from '~/assets/projects/tally/home-demo-2026-09-26.webp';
import kailleraLanding from '~/assets/projects/kaillera-next/landing-thumb-2026-09-26.webp';
import websiteHome from '~/assets/site/work-with-me-website.webp';
import threadline from '~/assets/site/threadline-v1.webp';
---
<BaseLayout title="Building · Kazon Wilson" description="Projects, experiments, and ideas I want to explore.">
  <div class="site-shell primary-page">
    <header class="building-intro"><p class="page-kicker">Building</p><h1 class="page-title">Things I’m making.</h1><p class="page-lede">Projects, experiments, and ideas I want to explore.</p></header>
    <section class="site-section">
      <article class="tally-feature" data-reveal data-tilt>
        <div><p class="page-kicker">{tallyStory.status}</p><h2>{tallyStory.title}</h2><p class="project-subtitle">{tallyStory.subtitle}</p><p class="project-description">{tallyStory.description}</p><a class="site-link" href="/building/tally#tally-updates-title">Development journal <span class="sr-only">for Tally</span> <span aria-hidden="true">→</span></a></div>
        <div class="tally-image"><img src={tallyHome.src} width={tallyHome.width} height={tallyHome.height} alt="Tally’s Home screen on demo data, a CI capture from September 2026, with the Demo data banner in frame." fetchpriority="high" /></div>
      </article>
      <div class="project-rows">
        <article class="project-row" data-reveal>
          <div class="row-image"><img src={kailleraLanding.src} width={kailleraLanding.width} height={kailleraLanding.height} alt="Kaillera Next's landing page, a capture from September 2026." loading="lazy" /></div>
          <div><p class="page-kicker">{kailleraStory.status}</p><h2 class="row-title">Kaillera Next</h2><p>{kailleraStory.subtitle}</p></div>
          <a class="site-link" href="/building/kaillera-next#kaillera-next-updates-title">Development journal <span class="sr-only">for Kaillera Next</span> <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row" data-reveal>
          <div class="row-image"><img src={websiteHome.src} width={websiteHome.width} height={websiteHome.height} alt="" loading="lazy" /></div>
          <div><p class="page-kicker">{websiteStory.status}</p><h2 class="row-title">Personal website</h2><p>See how I reorganized, designed and built the site you’re reading.</p></div>
          <a class="site-link" href="/building/personal-website#personal-website-updates-title">Development journal <span class="sr-only">for Personal website</span> <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row" data-reveal>
          <div class="row-image"><img src={dailyPreview.src} width={dailyPreview.width} height={dailyPreview.height} alt="" loading="lazy" /></div>
          <div><p class="page-kicker">{dailyStory.status}</p><h2 class="row-title">{dailyStory.title}</h2><p>A prototype for practicing coding through a story, alongside Scripture, prayer and reflection.</p></div>
          <a class="site-link" href="/building/the-engineers-daily#the-engineers-daily-updates-title">Development journal <span class="sr-only">for {dailyStory.title}</span> <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row" data-reveal>
          <div class="row-image threadline-thumb"><img src={threadline.src} width={threadline.width} height={threadline.height} alt="" loading="lazy" /><span class="art-note">Illustration</span></div>
          <div><p class="page-kicker">{threadlineStory.status}</p><h2 class="row-title">Threadline</h2><p>Pick up interrupted development work with its context intact.</p></div>
          <a class="site-link" href="/building/threadline#threadline-updates-title">Development journal <span class="sr-only">for Threadline</span> <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>
  </div><Footer compact slot="footer" />
</BaseLayout>
<script>
  import { runMotion } from '~/scripts/scroll-scenes';
  // Projects rise in as they arrive; the featured capture leans toward a fine pointer.
  runMotion();
</script>
<style>
  .building-intro { max-width: 40rem; }
  .tally-feature { position: relative; display: grid; grid-template-columns: 1.65fr 1fr; gap: 2.5rem; align-items: center; }
  .tally-image { order: -1; display: block; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; box-shadow: 0 18px 40px -30px #0e0e0e59; transform: perspective(1100px) rotateX(calc(var(--rx, 0) * 2.5deg)) rotateY(calc(var(--ry, 0) * 3.5deg)); transition: transform 500ms cubic-bezier(.2, .7, .2, 1), box-shadow 500ms ease; }
  .tally-feature:is(:hover, :focus-within) .tally-image { box-shadow: 0 26px 50px -30px #0e0e0e80; }
  .tally-feature img { width: 100%; height: auto; display: block; }
  .tally-feature h2 { font-size: clamp(2rem, 3.2vw, 2.8rem); line-height: 1.15; letter-spacing: -.025em; }
  /* Above the picture, whose tilt transform would otherwise paint over the link. */
  .tally-feature .site-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .project-subtitle { font-size: 1.4rem; line-height: 1.4; margin-top: .25rem; }
  .project-description { color: var(--muted); font-size: 1.125rem; margin-block: 1rem 1.5rem; max-width: 27rem; }
  .project-rows { margin-top: 3rem; }
  .project-row { position: relative; display: grid; grid-template-columns: 140px 1fr auto; gap: 2rem; align-items: center; padding-block: 1.75rem; border-top: 1px solid var(--rule); }
  .project-row .site-link::after { content: ''; position: absolute; inset: 0; }
  .row-image { position: relative; display: block; padding: 0; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; }
  .row-image img { display: block; width: 100%; height: 90px; object-fit: cover; object-position: left top; transition: transform 500ms cubic-bezier(.2, .7, .2, 1); }
  .project-row:is(:hover, :focus-within) .row-image img { transform: scale(1.06); }
  .project-row[data-reveal]:nth-child(2) { transition-delay: 90ms; }.project-row[data-reveal]:nth-child(3) { transition-delay: 180ms; }.project-row[data-reveal]:nth-child(4) { transition-delay: 270ms; }
  @media (prefers-reduced-motion: reduce) { .tally-image, .row-image img { transform: none; transition: none; } }
  .threadline-thumb img { object-fit: contain; object-position: center; }
  .threadline-thumb .art-note { position: absolute; right: .3rem; bottom: .2rem; font-size: .625rem; line-height: 1.3; color: var(--muted); background: var(--paper); padding: 0 .3rem; border-radius: 2px; }
  .row-title { font-size: 1.7rem; }
  .project-row p:not(.page-kicker) { color: var(--muted); max-width: 36rem; }
  @media(max-width: 800px) {
    .tally-feature { grid-template-columns: 1fr; gap: 1.5rem; }.tally-image { order: 0; }
    .project-row { grid-template-columns: 84px 1fr; gap: 1rem; align-items: start; }.project-row > .site-link { grid-column: 2; justify-self: start; }
    .row-image img { height: 64px; }.row-title { font-size: 1.5rem; }
  }
</style>
