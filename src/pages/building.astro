---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import dailyStory from '~/data/project-stories/the-engineers-daily.json';
import { tallyStory } from '~/data/project-stories/tally';
import dailyPreview from '~/assets/projects/daily-preview.webp';
import tallyHome from '~/assets/site/work-with-me-software.webp';
import kailleraLobby from '~/assets/projects/kaillera-next/lobby-v0.8.0-desktop.webp';
import websiteHome from '~/assets/site/work-with-me-website.webp';
import threadline from '~/assets/site/threadline-v1.webp';
---
<BaseLayout title="Building · Kazon Wilson" description="Projects, experiments, and ideas I want to explore.">
  <div class="site-shell primary-page">
    <header class="building-intro"><p class="page-kicker">Building</p><h1 class="page-title">Things I’m making.</h1><p class="page-lede">Projects, experiments, and ideas I want to explore.</p></header>
    <section class="site-section">
      <article class="tally-feature">
        <a class="tally-image" href="/building/tally" aria-label="Explore Tally"><img src={tallyHome.src} width={tallyHome.width} height={tallyHome.height} alt="Tally’s Home screen on the public demo, with the Demo data banner in frame." fetchpriority="high" /></a>
        <div><p class="project-status">In development · public demo</p><h2>{tallyStory.title}</h2><p class="project-subtitle">{tallyStory.subtitle}</p><p class="project-description">{tallyStory.description}</p><a class="site-link" href="/building/tally#tally-updates-title">Development journal <span aria-hidden="true">→</span></a></div>
      </article>
      <div class="project-rows">
        <article class="project-row">
          <a class="row-image" href="/building/kaillera-next" aria-label="Kaillera Next"><img src={kailleraLobby.src} width={kailleraLobby.width} height={kailleraLobby.height} alt="" loading="lazy" /></a>
          <div><p class="project-status">In development · playable demo build</p><h3>Kaillera Next</h3><p>Retro gaming and online netplay.</p></div>
          <a class="site-link" href="/building/kaillera-next#kaillera-next-updates-title">Development journal <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row">
          <a class="row-image" href="/building/personal-website" aria-label="Personal website"><img src={websiteHome.src} width={websiteHome.width} height={websiteHome.height} alt="" loading="lazy" /></a>
          <div><p class="project-status">Live · ongoing design project</p><h3>Personal website</h3><p>The decisions behind a clearer, more manageable site.</p></div>
          <a class="site-link" href="/building/personal-website#personal-website-updates-title">Development journal <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row">
          <a class="row-image" href="/building/the-engineers-daily" aria-label="The Engineer’s Daily"><img src={dailyPreview.src} width={dailyPreview.width} height={dailyPreview.height} alt="" loading="lazy" /></a>
          <div><p class="project-status">Local prototype</p><h3>{dailyStory.title}</h3><p>A lesson prototype with story, practice, and reflection.</p></div>
          <a class="site-link" href="/building/the-engineers-daily#the-engineers-daily-updates-title">Development journal <span aria-hidden="true">→</span></a>
        </article>
        <article class="project-row">
          <a class="row-image" href="/building/threadline" aria-label="Threadline"><img src={threadline.src} width={threadline.width} height={threadline.height} alt="" loading="lazy" /></a>
          <div><p class="project-status">Internal prototype</p><h3>Threadline</h3><p>Pick up interrupted development work with its context intact.</p></div>
          <a class="site-link" href="/building/threadline#threadline-updates-title">Development journal <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>
  </div><Footer compact slot="footer" />
</BaseLayout>
<style>
  .building-intro { max-width: 40rem; }
  .tally-feature { display: grid; grid-template-columns: 1.65fr 1fr; gap: 2.5rem; align-items: center; }
  .tally-image { display: block; border: 1px solid var(--rule); border-radius: 3px; padding: 0; overflow: hidden; }
  .tally-feature img { width: 100%; height: auto; display: block; }
  .tally-feature h2 { font-size: clamp(2rem, 3.2vw, 2.8rem); line-height: 1.15; letter-spacing: -.025em; }
  .project-subtitle { font-size: 1.4rem; line-height: 1.4; margin-top: .25rem; }
  .project-description { color: var(--muted); font-size: 1.125rem; margin-block: 1rem 1.5rem; max-width: 27rem; }
  .project-status { display: flex; align-items: baseline; gap: .65rem; font: .75rem/1.7 'JetBrains Mono', monospace; color: var(--accent); margin-bottom: .6rem; }
  .project-status::before { content: ''; width: .65rem; height: .65rem; border-radius: 50%; flex-shrink: 0; background: var(--accent); }
  .project-rows { margin-top: 3rem; }
  .project-row { display: grid; grid-template-columns: 140px 1fr auto; gap: 2rem; align-items: center; padding-block: 1.75rem; border-top: 1px solid var(--rule); }
  .row-image { display: block; border: 1px solid var(--rule); border-radius: 3px; overflow: hidden; }
  .row-image img { display: block; width: 100%; height: 90px; object-fit: cover; }
  .project-row h3 { font-size: 1.7rem; }
  .project-row p:not(.project-status) { color: var(--muted); max-width: 36rem; }
  @media(max-width: 800px) {
    .tally-feature { grid-template-columns: 1fr; gap: 1.5rem; }.tally-feature > div { order: -1; }
    .project-row { grid-template-columns: 84px 1fr; gap: 1rem; }.project-row > .site-link { grid-column: 2; justify-self: start; }
    .row-image img { height: 64px; }.project-row h3 { font-size: 1.5rem; }
  }
</style>
