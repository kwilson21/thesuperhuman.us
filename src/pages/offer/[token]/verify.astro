---
export const prerender = false;

import AgreementLayout from "~/layouts/AgreementLayout.astro";
import { completeAgreementLink } from "~/lib/agreement-access";
import { logUnexpected } from "~/server/failure";
import { raisedByJsonGuard } from "~/server/guarded-save";

// A failure on the site's side is logged once, never shown, and answers 500 with the failure page.
function unexpected<Failure>(failure: Failure) {
	logUnexpected("Agreement verify", failure);
}

// formData() refuses a body that is not a form (JSON, plain text) with a TypeError: such a POST reads as one with no key.
function notAForm<Failure>(failure: Failure) {
	if (failure instanceof TypeError) return null;

	throw failure;
}

const key =
	Astro.request.method === "POST"
		? String((await Astro.request.formData().catch(notAForm))?.get("key") ?? "")
		: (Astro.url.searchParams.get("key") ?? "");

const response = await completeAgreementLink(
	Astro.locals.runtime.env,
	Astro.request,
	key,
	Astro.params.token,
	{ isGuard: raisedByJsonGuard, unexpected },
);

if (response.status === 303) return response;

Astro.response.status = response.status;

Astro.response.headers.set("Referrer-Policy", "no-referrer");

Astro.response.headers.set("Cache-Control", "no-store");

import { getLinkedOffer } from "~/lib/software-offers";

let offer: Awaited<ReturnType<typeof getLinkedOffer>> = null;

if (response.status === 200) {
	try {
		offer = await getLinkedOffer(
			Astro.locals.runtime.env.MUSIC_DB!,
			Astro.params.token!,
		);
	} catch (error) {
		unexpected(error);
		Astro.response.status = 500;
	}
}

const valid = Astro.response.status === 200;

const failed = Astro.response.status === 500;
---
<AgreementLayout title={valid ? "Your agreement is ready" : failed ? "This link could not be opened" : "This link has expired"}>
{valid ? <>
<p class="page-kicker">{offer && JSON.parse(offer.terms_json).outcome}</p>
<h1 class="page-title">Your agreement is ready.</h1>
<form class="agreement-form" method="post" action={Astro.url.pathname}><input type="hidden" name="key" value={key} /><button class="studio-button">Continue to sign</button></form>
<p class="agreement-hint">This link works once.</p>
</> : failed ? <><h1 class="page-title">This link could not be opened.</h1><p class="page-lede">Something went wrong on my side. Try the link again in a few minutes.</p></> : <><h1 class="page-title">This link has expired.</h1><p class="page-lede">Links work once and last an hour.</p><p class="agreement-form"><a class="studio-button" href={`/offer/${Astro.params.token}/sign`}>Send a new link</a></p></>}
</AgreementLayout>
