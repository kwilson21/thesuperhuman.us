---
export const prerender = false;
import SoftwareAgreedTerms from '~/components/SoftwareAgreedTerms.astro';
import {validateAgreementDetails} from '~/lib/agreement-fields';
import AgreementLayout from '~/layouts/AgreementLayout.astro';
import { getLinkedOffer, offerTermsSchema, formatUSD, offerTotal } from '~/lib/software-offers';
import { getOwnerRequest } from '~/lib/owner-requests';
import { agreementSession, signingEnabled } from '~/lib/agreement-access';
import { offerAgreements } from '~/lib/software-agreements';
import { consentText, intentText, agreementVersionLabel } from '~/lib/agreement-fields';
import { businessTypes, states, loadAgreementDraft, prefillAgreementDraft } from '~/lib/agreement-draft';
import { softwareDate } from '~/lib/software-projects';
const env=Astro.locals.runtime.env, db=env.MUSIC_DB, token=Astro.params.token!;
const offer=db && await signingEnabled(db) ? await getLinkedOffer(db,token) : null;
const session=offer ? await agreementSession(db!,Astro.request,'agreement',offer.id) : null;
const docs=session ? await offerAgreements(db!,offer!.id) : [];
const sow=docs.find(d=>d.kind==='sow'), signed=sow && sow.status!=='review';
const terms=offer ? offerTermsSchema.parse(JSON.parse(offer.terms_json)) : null;
const request=offer ? await getOwnerRequest(db!,offer.request_id) : null;
const reused=offer?.reused_msa_id && session ? await db!.prepare('SELECT canonical_text,values_json,id FROM software_agreements WHERE id=?').bind(offer.reused_msa_id).first<{canonical_text:string;values_json:string;id:string}>() : null;
const previous=reused ? JSON.parse(reused.values_json).client : undefined;
const draft=session && request ? await loadAgreementDraft(db!,offer!.id,session.recipient_email) ?? prefillAgreementDraft(request,previous) : null;
const sameAsPrevious=Boolean(previous && draft && previous.legal_name===draft.legal_name && previous.entity_type===draft.entity_type && previous.jurisdiction===(draft.state==='Outside the US'?draft.country:draft.state) && previous.business_address===draft.business_address);
const artifact=sow?.status==='executed' ? await db!.prepare('SELECT status FROM software_agreement_artifacts WHERE agreement_id=?').bind(sow.id).first<{status:string}>() : null;
const invoice=sow?.status==='executed' ? await db!.prepare("SELECT hosted_invoice_url FROM software_invoices WHERE offer_id=? AND kind='deposit' AND status='open' AND hosted_invoice_url IS NOT NULL ORDER BY milestone_index LIMIT 1").bind(offer!.id).first<{hosted_invoice_url:string}>() : null;
const recipient=offer?.recipient_email_snapshot ?? '';
const readyDocs=docs.filter(d=>d.status==='review' && d.review_session_hash===session?.token_hash);
if(!offer?.msa_template_id) Astro.response.status=404;
---
<AgreementLayout title="Review and sign">
{!offer?.msa_template_id ? <><h1 class="page-title">Signing is unavailable.</h1><p class="page-lede">Contact Kazon to arrange signing outside the website.</p></> : !session ? <>
  <h1 class="page-title">{Astro.url.searchParams.has('email')?'Check your email.':'Open your agreement.'}</h1>
  <p class="page-lede">{Astro.url.searchParams.has('email')?`I sent a link to ${recipient}. Tap it on any device to open your agreement.`:'Use a one-time email link to review and sign.'}</p>
  <form class="agreement-form" action={`/api/offer/${token}/link`} method="post" data-agreement-link>
    <div class="cf-turnstile" data-sitekey={env.PUBLIC_TURNSTILE_SITE_KEY??import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-size="compact"></div>
    <button class="studio-button">{Astro.url.searchParams.has('email')?"Didn't get it? Send it again":'Send a new link'}</button>
  </form><p class="agreement-status" role="status" aria-live="polite"></p>
  <noscript><p>The security check needs JavaScript. Contact Kazon for outside-site signing.</p></noscript>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</> : signed ? <>
  <h1 class="page-title">{sow.status==='executed'?'Signed by both of you.':'Signed. Over to Kazon.'}</h1>
  {sow.status==='executed'? <><p class="page-lede">Your signed copy will arrive by email.</p><a class="studio-button" href={invoice?.hosted_invoice_url ?? `/studio/software/${offer.request_id}`}>{invoice?'Pay the deposit ↗':'Open your project page'}</a>{artifact?.status==='ready' ? <p><a href={`/api/agreements/${sow.id}/file`}>Download the signed PDF</a></p> : <p>Your signed PDF is being prepared. Your signatures are saved.</p>}</> : <><p class="page-lede">Kazon countersigns next. You'll get the signed PDF by email as soon as he does.</p><ol class="signing-progress"><li>You signed ✓</li><li>Kazon countersigns</li><li>{terms!.paymentMode==='standard'?'Deposit invoice':'Your project starts'}</li></ol></>}
</> : draft && terms && <>
  <p class="page-kicker">{terms.outcome}{draft.legal_name && ` · ${draft.legal_name}`}</p>
  <h1 class="page-title">Ready to sign.</h1><p class="page-lede">Here's what we agreed. Check your details, make one choice, and sign. It takes about two minutes.</p>
  <div data-signing-errors role="alert" tabindex="-1" hidden></div>
  <form class="agreement-form" data-signing-page data-token={token} data-email={recipient} method="post" action={`/api/offer/${token}/review`} novalidate>
    <input type="hidden" name="csrf_nonce" value={session.csrf_nonce} />
    <input type="hidden" name="documents" value={JSON.stringify(readyDocs.map(d=>({id:d.id,hash:d.text_sha256})))} />
    <div class="offer-columns"><div>
      <section class="signing-card"><h2>What you're getting</h2><p>{terms.summary}</p><p class="agreement-meta">{terms.milestones.length} milestones · {formatUSD(offerTotal(terms))} fixed · {terms.paymentMode==='standard'?'50% deposit before each milestone':'Invoices on delivery, due within 30 days'} · done by {softwareDate(JSON.parse(offer.agreement_details_json!).planned_end)}</p>
      <SoftwareAgreedTerms terms={terms} values={sow ? JSON.parse(sow.values_json) : null} agreementDetails={validateAgreementDetails(JSON.parse(offer.agreement_details_json!),terms)} documents={readyDocs} websiteSigned={false} conversationOpen={false} signing={true} />
      {reused && <details><summary>Your existing MSA</summary><a href={`/api/agreements/${reused.id}/file`}>Download executed MSA</a><pre class="agreement-text">{reused.canonical_text}</pre></details>}
      {(JSON.parse(offer.agreement_details_json!).attachments??[]).map((a:{key:string;filename:string})=><p><a href={`/api/agreements/attachments/${a.key.split('/').pop()!.replace('.pdf','')}`}>Review attachment: {a.filename}</a></p>)}
</section>
      <p class="agreement-meta">{agreementVersionLabel}</p><section class="agreement-section"><h2>Your details</h2><p class="agreement-hint">Filled in from your brief. Change anything that's off.</p>
      {sameAsPrevious && <p data-returning-summary>Same as last time: {previous.legal_name}, {previous.entity_type}, {previous.jurisdiction}, {previous.business_address}. <button type="button" class="studio-quiet" data-edit-details>Edit</button></p>}
      <div class="signing-fields" data-business-details hidden={sameAsPrevious}>
      <label>Legal business name<input class="studio-input" name="legal_name" id="legal_name" value={draft.legal_name} maxlength="200" required aria-describedby="error-legal_name" /><span id="error-legal_name" data-field-error="legal_name"></span></label>
      {!previous && <label>Your title<input class="studio-input" name="signer_title" id="signer_title" value={draft.signer_title} placeholder="e.g. Owner, Operations Lead" maxlength="200" required aria-describedby="error-signer_title" /><span id="error-signer_title" data-field-error="signer_title"></span></label>}
      <label>Business type<select class="studio-select" name="entity_type" id="entity_type" required aria-describedby="error-entity_type"><option value="">Choose</option>{businessTypes.map(v=><option value={v} selected={v===draft.entity_type}>{v}</option>)}</select><span id="error-entity_type" data-field-error="entity_type"></span></label>
      <label>State<select class="studio-select" name="state" id="state" required aria-describedby="error-state"><option value="">Choose</option>{states.map(v=><option value={v} selected={v===draft.state}>{v}</option>)}</select><span id="error-state" data-field-error="state"></span></label>
      <label data-country hidden={draft.state!=='Outside the US'}>Country<input class="studio-input" name="country" id="country" value={draft.country} maxlength="100" aria-describedby="error-country" /><span id="error-country" data-field-error="country"></span></label>
      <label class="signing-wide">Business mailing address<textarea class="studio-textarea" name="business_address" id="business_address" maxlength="1000" required aria-describedby="error-business_address">{draft.business_address}</textarea><span id="error-business_address" data-field-error="business_address"></span></label>
      </div>
      {previous && <label>Your title<input class="studio-input" name="signer_title" id="signer_title" value={draft.signer_title} placeholder="e.g. Owner, Operations Lead" maxlength="200" required aria-describedby="error-signer_title" /><span id="error-signer_title" data-field-error="signer_title"></span></label>}
      <p class="agreement-meta">Reviews, approvals and formal notices go to you ({recipient}). <button type="button" class="studio-quiet" data-other-contact>Use someone else</button></p>
      <div class="signing-fields" data-other-contacts hidden={!draft.reviewer_name && !draft.reviewer_email && !draft.approver_name && !draft.approver_email && !draft.notice_email}>
      {(['reviewer_name','reviewer_email','approver_name','approver_email','notice_email'] as const).map(name=><label>{name==='notice_email'?'Notice email':name.replace('_',' ').replace(/^./,c=>c.toUpperCase())}<input class="studio-input" name={name} id={name} type={name.includes('email')?'email':'text'} maxlength={name.includes('email')?320:200} value={draft[name]} aria-describedby={`error-${name}`} /><span id={`error-${name}`} data-field-error={name}></span></label>)}
      </div></section>
      <fieldset id="portfolio_choice" aria-describedby="error-portfolio_choice"><legend>Can I show this work in my portfolio?</legend><p class="agreement-hint">Only after I remove anything confidential. Your logo is never used.</p>
      {([['private','Keep it private'],['anonymous','Show the work without naming you'],['named','Show the work and name you']] as const).map(([value,label])=><label class="confirmation"><input type="radio" name="portfolio_choice" value={value} checked={draft.portfolio_choice===value} required />{label}</label>)}<span id="error-portfolio_choice" data-field-error="portfolio_choice"></span></fieldset>
    </div><aside><h2>Your signature</h2><p class="signing-name" data-signature-name>{draft.signer_name}</p><p class="agreement-meta"><span data-signature-details>{draft.signer_name} · {draft.signer_title}, {draft.legal_name}</span> · <button type="button" class="studio-quiet" data-edit-name>Edit</button></p>
      <label data-name-field hidden>Full legal name<input class="studio-input" name="signer_name" id="signer_name" value={draft.signer_name} maxlength="200" required aria-describedby="error-signer_name" /><span id="error-signer_name" data-field-error="signer_name"></span></label>
      <label class="confirmation"><input type="checkbox" name="consent" id="consent" value="true" required aria-describedby="error-consent" /><span data-consent-text>{consentText(draft.legal_name)}</span></label><span id="error-consent" data-field-error="consent"></span>
      <button class="studio-button" type="submit" data-sign-button>Sign as {draft.signer_name}</button><p class="agreement-hint">{intentText()}</p><p class="agreement-hint">Next, Kazon countersigns. You'll get the signed PDF by email as soon as he does.</p>
      <p class="agreement-hint">The certificate records your verified email, time, IP address and browser. <a href="/privacy">Privacy notice</a>.</p>
      <p class="agreement-status" role="status" aria-live="polite" tabindex="-1"></p><a data-fresh-link href={`/offer/${token}/sign`} hidden>Send a new link</a>
    </aside></div>
  </form><noscript><p>Contact Kazon for outside-site signing if JavaScript is unavailable.</p></noscript>
</>}
</AgreementLayout>
<script>
import { setupAgreementAccess } from '~/scripts/agreement-access';
setupAgreementAccess();
</script>
<style>
  .signing-fields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .signing-fields[hidden] { display: none; }
  .signing-wide { grid-column: 1/-1; }
  .signing-card { border: 1px solid var(--rule); padding: 1.5rem; }
  .signing-name { font: italic 2.5rem/1.3 Newsreader,Georgia,serif; border-bottom: 1px solid var(--ink); margin-block: 1rem .4rem; }
  .signing-progress { padding-left: 1.5rem; }
  [data-field-error] { color: var(--accent); font: 400 .85rem/1.5 Inter,sans-serif; }
  [data-signing-errors] { border: 1px solid var(--accent); padding: 1rem; }
  @media(max-width:700px) { .signing-fields { grid-template-columns: 1fr; } }
</style>
