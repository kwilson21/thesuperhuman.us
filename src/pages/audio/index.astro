---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AudioHero from '~/components/audio/AudioHero.astro';
import MusicNav from '~/components/audio/MusicNav.astro';
import ComparisonPlayer from '~/components/audio/ComparisonPlayer.astro';
import PersonalNameText from '~/components/PersonalNameText.astro';
import AudioFooter from '~/components/audio/AudioFooter.astro';
import ServiceIcon from '~/components/audio/ServiceIcon.astro';
import { audioServices } from '~/data/audio';
import { audioPath, mainSitePath } from '~/lib/host-routing';
import { groupTracksByService, type AudioTrack } from '~/lib/audio-tracks';
import { loadMusicCatalog } from '~/lib/music-content';

const entries = await getCollection('audio-tracks');
const tracks: AudioTrack[] = entries.map((e) => ({
  slug: e.id,
  ...(e.data as Omit<AudioTrack, 'slug'>),
}));
const groups = groupTracksByService(tracks);
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const audioHref = (path: string) => audioPath(host, path);

const catalog = await loadMusicCatalog();
const example = catalog.examples.find(example => example.service === 'mastering');
const recording = example && catalog.recordings.find(track => track.id === example.recordingId);
const release = recording && catalog.releases.find(release => release.tracks.includes(recording.id));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kazon Wilson',
  jobTitle: 'Audio Engineer',
  url: 'https://thesuperhuman.us/audio/',
  worksFor: { '@type': 'Organization', name: 'The Superhuman Group LLC' },
};
---
<BaseLayout
  title="Audio engineering · Kazon Wilson"
  description="Mixing, mastering, production, and recording. Fixed-price, async delivery."
  jsonLd={jsonLd}
>
  <div class="site-shell primary-page audio-page">
    <MusicNav />
    <AudioHero />
    <section class="audio-section" aria-labelledby="listen-title">
      <div class="site-section-heading"><h2 id="listen-title">Listen</h2></div>
      {release && recording && example ? (
        <div class="audio-listen" data-reveal>
          <a class="listen-release" href={mainSitePath(host, `/music/${release.slug}`)}>
            <img src={release.artwork} alt={`${release.displayTitle ?? release.title} cover artwork`} width="1254" height="1254" />
            <p class="listen-kicker">Released</p>
            <h3>{release.displayTitle ?? release.title}</h3>
            <span class="site-link">Hear the song <span aria-hidden="true">→</span></span>
          </a>
          <div class="listen-example">
            <p class="listen-kicker">Engineering example</p>
            <ComparisonPlayer example={example} recording={recording} />
            <details class="listen-credits"><summary>Credits</summary><p>This comparison demonstrates mastering.</p>{recording.credits.map(credit => <p>{credit.role}: <PersonalNameText text={credit.name} />.</p>)}</details>
          </div>
        </div>
      ) : <p class="listen-empty">New audio work is on its way.</p>}
      <a class="listen-more site-link" href={audioHref('/portfolio')}>Portfolio <span aria-hidden="true">→</span></a>
    </section>
    <section class="audio-section" aria-labelledby="audio-services-title">
      <div class="site-section-heading"><h2 id="audio-services-title">What I work on</h2><a class="site-link" href={audioHref('/services')}>Prices and scope <span aria-hidden="true">→</span></a></div>
      <div class="audio-services" data-reveal>{groups.map(({service}) => <article><ServiceIcon service={service} /><div><h3>{audioServices[service].label}</h3><p>{audioServices[service].description}</p></div></article>)}</div>
    </section>
    <section id="book" class="audio-section audio-start" aria-labelledby="audio-start-title" data-reveal>
      <h2 id="audio-start-title">Start</h2>
      <p>Share your song, and I’ll review it before you book.</p>
      <a class="site-button" href={audioHref('/start')}>Start your song</a>
    </section>
  </div>

  <script>
    import '~/scripts/audio-player-coordinator';
    import { setupComparisonPlayers } from '~/scripts/comparison-player';
    import { runMotion } from '~/scripts/scroll-scenes';
    setupComparisonPlayers();
    // The headphones give off a few rings on arrival and the sections rise in; nothing plays sound.
    runMotion();
  </script>

  <AudioFooter slot="footer" />
</BaseLayout>

<style>
  .audio-page :global(.audio-art), .audio-page :global(.audio-scene .chapter-life) { mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); mask-composite: intersect; }
  .audio-section { border-top: 1px solid var(--rule); padding-block: 2.5rem; scroll-margin-top: 2rem; }
  .audio-section h2 { font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.15; }
  .audio-listen { display: grid; grid-template-columns: .85fr 1.15fr; gap: 3rem; align-items: start; margin-top: 1.5rem; }
  .listen-kicker { font: 600 .75rem/1.4 Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 0 0 .5rem; }
  .listen-release { display: block; border: 0; }
  .listen-release img { width: 100%; height: auto; display: block; box-shadow: 0 7px 15px #38261520; margin-bottom: 1rem; }
  .listen-release h3 { font-size: 1.75rem; line-height: 1.15; margin-bottom: .5rem; }
  .listen-credits { font-size: .85rem; color: var(--muted); text-align: right; margin-top: .75rem; }
  .listen-credits p { text-align: left; padding: .5rem 0; }
  .listen-credits summary { cursor: pointer; }
  .listen-empty { color: var(--muted); font-size: 1.2rem; padding-block: 1rem; }
  .listen-more { display: block; width: fit-content; margin-top: 2rem; }
  .audio-services { display: grid; grid-template-columns: 1fr 1fr; column-gap: 4rem; }
  .audio-services article { display: flex; align-items: start; gap: 1.5rem; padding-block: 2rem; }
  .audio-services article:nth-child(n+3) { border-top: 1px solid var(--rule); }
  .audio-services :global(svg) { flex-shrink: 0; }
  .audio-services h3 { font-size: 2rem; line-height: 1.2; }
  .audio-services p, .audio-start p { color: var(--muted); font-size: 1.2rem; line-height: 1.6; margin-top: .75rem; max-width: 35ch; }
  .audio-start .site-button { margin-top: 1.5rem; }
  @media(max-width: 650px) { .audio-services { grid-template-columns: 1fr; gap: 1rem; }.audio-services article + article { border-top: 1px solid var(--rule); }.audio-services article { gap: 1rem; }.audio-services h3 { font-size: 1.75rem; }.audio-listen { grid-template-columns: 1fr; gap: 1.5rem; } }
  @media(max-width: 400px) { .site-section-heading { flex-wrap: wrap; row-gap: .5rem; } }
</style>
