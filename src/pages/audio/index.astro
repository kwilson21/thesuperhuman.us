---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AudioHero from '~/components/audio/AudioHero.astro';
import ServiceSection from '~/components/audio/ServiceSection.astro';
import BookingForm from '~/components/audio/BookingForm.astro';
import AudioFooter from '~/components/audio/AudioFooter.astro';
import notebook from '~/assets/site/notebook-v1.webp';
import ServiceIcon from '~/components/audio/ServiceIcon.astro';
import { audioServices } from '~/data/audio';
import { mainSitePath, audioPath } from '~/lib/host-routing';
import { groupTracksByService, type AudioTrack } from '~/lib/audio-tracks';

const entries = await getCollection('audio-tracks');
const tracks: AudioTrack[] = entries.map((e) => ({
  slug: e.id,
  ...(e.data as Omit<AudioTrack, 'slug'>),
}));
const groups = groupTracksByService(tracks);
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const mainHref = (path: string) => mainSitePath(host, path);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kazon Wilson',
  jobTitle: 'Audio Engineer',
  url: 'https://thesuperhuman.us/audio/',
  worksFor: { '@type': 'Organization', name: 'The Superhuman Group LLC' },
};
---
<BaseLayout
  title="Audio engineering · Kazon Wilson"
  description="Mixing, mastering, production, and recording. Fixed-price, async delivery."
  jsonLd={jsonLd}
>
  <div class="site-shell primary-page audio-page">
    <AudioHero />
    {tracks.length > 0 && <section class="audio-section" aria-labelledby="selected-audio-title"><div class="site-section-heading"><h2 id="selected-audio-title">Selected audio</h2></div>{groups.filter(group => group.tracks.length > 0).map(group => <ServiceSection service={group.service} tracks={group.tracks} />)}</section>}
    <section class="audio-section" aria-labelledby="audio-services-title">
      <div class="site-section-heading"><h2 id="audio-services-title">What I work on</h2><a class="site-link" href={audioPath(host, '/services')}>See audio services <span aria-hidden="true">→</span></a></div>
      <div class="audio-services">{groups.map(({service}) => <article><ServiceIcon service={service} /><div><h3>{audioServices[service].label}</h3><p>{audioServices[service].description}</p></div></article>)}</div>
    </section>
    <section class="audio-section audio-working" aria-labelledby="audio-working-title">
      <div><h2 id="audio-working-title">Working together</h2><p>Projects are scoped individually, with written communication and clear deliverables.</p><a class="site-link" href="#book">Discuss an audio project <span aria-hidden="true">→</span></a><a class="audio-detail-link" href={audioPath(host, '/about')}>Approach and project details</a></div>
      <img class="audio-art" src={notebook.src} alt="" width={notebook.width} height={notebook.height} loading="lazy" />
    </section>
    <details id="book" class="audio-booking context-disclosure"><summary>Discuss an audio project <span aria-hidden="true">+</span></summary><div class="audio-booking-content"><h2>Tell me about the project.</h2><p>Share the scope, timing, and how you’d like to send your files.</p><BookingForm /></div></details>
    <section class="audio-section audio-beyond"><h2>Beyond audio</h2><p>Software, writing, and the other things I’m exploring.</p><div class="site-links"><a class="site-link" href={mainHref('/work')}>Explore my work <span aria-hidden="true">→</span></a><a class="site-link" href={mainHref('/about')}>More about me <span aria-hidden="true">→</span></a></div></section>
  </div>

  <script>
    import '~/scripts/audio-player-coordinator';
  </script>

  <AudioFooter slot="footer" />
</BaseLayout>

<script>
  const booking = document.getElementById('book') as HTMLDetailsElement;
  function revealBooking() { if (location.hash === '#book') { booking.open = true; booking.scrollIntoView(); } }
  revealBooking();
  window.addEventListener('hashchange', revealBooking);
  document.querySelectorAll('a[href="#book"]').forEach(link => link.addEventListener('click', () => { booking.open = true; }));
</script>
<style>
  .audio-page :global(.audio-art) { mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); mask-composite: intersect; }
  .audio-section { border-top: 1px solid var(--rule); padding-block: 2.5rem; }
  .audio-section h2 { font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.15; }
  .audio-services { display: grid; grid-template-columns: 1fr 1fr; column-gap: 4rem; }
  .audio-services article { display: flex; align-items: start; gap: 1.5rem; padding-block: 2rem; }
  .audio-services article:nth-child(n+3) { border-top: 1px solid var(--rule); }
  .audio-services :global(svg) { flex-shrink: 0; }
  .audio-services h3 { font-size: 2rem; line-height: 1.2; }
  .audio-services p, .audio-working p, .audio-beyond p { color: var(--muted); font-size: 1.2rem; line-height: 1.6; margin-top: .75rem; max-width: 35ch; }
  .audio-working { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .audio-working img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .audio-working .site-link { margin-top: 1.75rem; }
  .audio-detail-link { display: block; width: fit-content; font-size: .9rem; margin-top: 1rem; }
  .audio-booking { border-top: 1px solid var(--rule); padding-top: 1.25rem; margin-bottom: 2rem; scroll-margin-top: 2rem; }
  .audio-booking-content { margin-top: 2rem; max-width: 48rem; }
  .audio-booking-content h2 { font-size: 2rem; }.audio-booking-content > p { margin-block: .5rem 2rem; color: var(--muted); }
  .audio-beyond .site-links { margin-top: 1.5rem; }
  @media(max-width: 650px) { .audio-services, .audio-working { grid-template-columns: 1fr; gap: 1rem; }.audio-services article + article { border-top: 1px solid var(--rule); }.audio-services article { gap: 1rem; }.audio-services h3 { font-size: 1.75rem; } }
</style>
