---
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AudioHero from '~/components/audio/AudioHero.astro';
import MusicNav from '~/components/audio/MusicNav.astro';
import ServiceSection from '~/components/audio/ServiceSection.astro';
import AudioFooter from '~/components/audio/AudioFooter.astro';
import notebook from '~/assets/site/notebook-v1.webp';
import ServiceIcon from '~/components/audio/ServiceIcon.astro';
import { audioServices } from '~/data/audio';
import { audioPath } from '~/lib/host-routing';
import { groupTracksByService, type AudioTrack } from '~/lib/audio-tracks';

const entries = await getCollection('audio-tracks');
const tracks: AudioTrack[] = entries.map((e) => ({
  slug: e.id,
  ...(e.data as Omit<AudioTrack, 'slug'>),
}));
const groups = groupTracksByService(tracks);
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const audioHref = (path: string) => audioPath(host, path);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kazon Wilson',
  jobTitle: 'Audio Engineer',
  url: 'https://thesuperhuman.us/audio/',
  worksFor: { '@type': 'Organization', name: 'The Superhuman Group LLC' },
};
---
<BaseLayout
  title="Audio engineering · Kazon Wilson"
  description="Mixing, mastering, production, and recording. Fixed-price, async delivery."
  jsonLd={jsonLd}
>
  <div class="site-shell primary-page audio-page">
    <MusicNav />
    <AudioHero />
    <section class="audio-section" aria-labelledby="listen-title">
      <div class="site-section-heading"><h2 id="listen-title">Listen</h2></div>
      <div class="site-links"><a class="site-link" href={audioHref('/releases')}>All releases</a><a class="site-link" href={audioHref('/portfolio')}>Engineering portfolio</a></div>
      {tracks.length > 0 && groups.filter(group => group.tracks.length > 0).map(group => <ServiceSection service={group.service} tracks={group.tracks} />)}
    </section>
    <section class="audio-section" aria-labelledby="audio-services-title">
      <div class="site-section-heading"><h2 id="audio-services-title">What I work on</h2><a class="site-link" href={audioHref('/services')}>Prices and scope <span aria-hidden="true">→</span></a></div>
      <div class="audio-services">{groups.map(({service}) => <article><ServiceIcon service={service} /><div><h3>{audioServices[service].label}</h3><p>{audioServices[service].description}</p></div></article>)}</div>
    </section>
    <section id="book" class="audio-section audio-start" aria-labelledby="audio-start-title">
      <div><h2 id="audio-start-title">Getting started.</h2><p>Most projects start with a written brief and files shared through Drive, Dropbox or WeTransfer. I check every mix on multiple reference systems before it goes out. If a project is outside what I do well, I’ll say so and point you to someone who can.</p><a class="site-button" href={audioHref('/start')}>Start your song</a></div>
      <img class="audio-art" src={notebook.src} alt="" width={notebook.width} height={notebook.height} loading="lazy" />
    </section>
  </div>

  <script>
    import '~/scripts/audio-player-coordinator';
  </script>

  <AudioFooter slot="footer" />
</BaseLayout>

<style>
  .audio-page :global(.audio-art) { mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent), linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent); mask-composite: intersect; }
  .audio-section { border-top: 1px solid var(--rule); padding-block: 2.5rem; scroll-margin-top: 2rem; }
  .audio-section h2 { font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.15; }
  .audio-services { display: grid; grid-template-columns: 1fr 1fr; column-gap: 4rem; }
  .audio-services article { display: flex; align-items: start; gap: 1.5rem; padding-block: 2rem; }
  .audio-services article:nth-child(n+3) { border-top: 1px solid var(--rule); }
  .audio-services :global(svg) { flex-shrink: 0; }
  .audio-services h3 { font-size: 2rem; line-height: 1.2; }
  .audio-services p, .audio-start p { color: var(--muted); font-size: 1.2rem; line-height: 1.6; margin-top: .75rem; max-width: 35ch; }
  .audio-section .site-section-heading a { flex-shrink: 0; white-space: nowrap; }
  .audio-start { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .audio-start .site-button { margin-top: 1.5rem; }
  .audio-start img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  @media(max-width: 650px) { .audio-services, .audio-start { grid-template-columns: 1fr; gap: 1rem; }.audio-services article + article { border-top: 1px solid var(--rule); }.audio-services article { gap: 1rem; }.audio-services h3 { font-size: 1.75rem; } }
</style>
