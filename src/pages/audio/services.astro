---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import MusicNav from '~/components/audio/MusicNav.astro';
import AudioFooter from '~/components/audio/AudioFooter.astro';
import ComparisonPlayer from '~/components/audio/ComparisonPlayer.astro';
import { loadMusicCatalog } from '~/lib/music-content';
import { audioOffers } from '~/lib/audio-intake';
import { audioPath, mainSitePath } from '~/lib/host-routing';
import '~/styles/music.css';
import '~/styles/music-hubs.css';
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const catalog = await loadMusicCatalog();
const example = catalog.examples.find(example => example.service === 'mastering');
const recording = example && catalog.recordings.find(track => track.id === example.recordingId);
const start = audioPath(host, '/start');
const anchors = {'vocal-mix':'two-track-vocals',mastering:'mastering',bundle:'mix-master',custom:'full-mix'};
---
<BaseLayout title="Audio services · Kaz̄on" description="Two-track vocal mixing and mastering. Careful listening, purposeful choices and clear scope before booking.">
<div class="site-shell music-page services-page"><MusicNav />
<section class="services-hero"><header><h1>Your song.<br />My full attention.</h1><p>Careful listening. Purposeful choices.<br />Your vision at the center.</p><a class="site-button" href={start}>Start your song</a></header>
<div class="service-listening"><div class="service-listening-heading"><h2>Hear the difference.</h2><p>{recording ? `${recording.title} · Mastering example` : 'Selected audio work'}</p></div>{example && recording ? <ComparisonPlayer example={example} recording={recording} /> : <p class="service-no-example">Listening examples will appear here when they’re ready to share.</p>}<a class="more-audio" href={audioPath(host, '/portfolio')}>More audio work →</a>{recording && <details class="service-credits"><summary>Credits</summary><p>This comparison demonstrates mastering.</p>{recording.credits.map(credit => <p>{credit.role}: {credit.name}.</p>)}</details>}</div>
</section>
<section class="service-offers"><header><h2>Find the right fit.</h2><p>Introductory prices · USD / song</p></header>
{Object.entries(audioOffers).map(([key,offer]) => <details class:list={['service-offer',{'service-custom':key==='custom'}]} id={anchors[key as keyof typeof anchors]}><summary><h3>{key === 'custom' ? 'Full mixing, production & recording' : offer.name}</h3><p>{key === 'custom' ? 'Scope agreed after review.' : offer.description}</p><span>{offer.price ? `From $${offer.price}` : 'By inquiry'}</span><b aria-hidden="true">+</b></summary><div class="service-scope"><p>{offer.scope}</p>{(key==='vocal-mix'||key==='bundle') && <p>A stereo beat is already mixed. Individual instruments cannot be rebalanced separately. Extensive editing or additional tracks are quoted before work begins.</p>}<details><summary>What to send</summary><p>{offer.files} {offer.preparation}</p></details><a class="site-link" href={`${start}?service=${key}`}>Start with this service →</a></div></details>)}
</section>
<section class="service-before"><h2>Before we start.</h2><div><details><summary>Revisions, delivery & payment <span aria-hidden="true">+</span></summary><p>A revision round is one consolidated set of notes within our agreed direction. Two rounds for standalone mixing or mastering; the bundle includes two mix rounds and one mastering adjustment after mix approval.</p><p>Your first listening version arrives in 3–5 business days after usable files and booking payment. Availability is confirmed first; custom work follows its agreed timeline.</p><p>50% to book after file review and your approval of the offer. Balance before final files. Additional scope is quoted for approval; delivery errors do not consume revisions.</p><p>Your files are for project review and agreed work. Portfolio use requires separate permission. Any remaining booking terms are supplied with your offer before payment.</p></details><div class="service-bottom"><p>We agree on the work and price before you book.</p><a class="site-button" href={start}>Start your song</a></div></div></section>
<p class="other-services">Looking for software services? <a href={mainSitePath(host, '/services')}>Explore software work →</a></p>
</div><AudioFooter slot="footer" />
<script>
import { setupMusicPlayback } from '~/scripts/music-playback'; import { setupComparisonPlayers } from '~/scripts/comparison-player'; setupMusicPlayback(); setupComparisonPlayers();
function openService(){const target = document.getElementById(location.hash.slice(1));if(target instanceof HTMLDetailsElement)target.open=true;}openService();window.addEventListener('hashchange',openService);
</script>
</BaseLayout>
<style>
.services-hero{display:grid;grid-template-columns:1fr 1.1fr;gap:2.5rem;align-items:start;padding:1rem 0 2rem}.services-hero h1{font-size:clamp(2.6rem,4.6vw,4.5rem);letter-spacing:-.04em;line-height:1.06}.services-hero header>p{font-size:1.5rem;line-height:1.4;margin:1.15rem 0 1.5rem;color:var(--muted)}.services-hero .site-button{min-width:210px;justify-content:center}.service-listening-heading{display:flex;gap:1rem;align-items:baseline;justify-content:space-between;margin-bottom:.5rem}.service-listening h2{font-size:2rem;line-height:1.1}.service-listening-heading p{font-size:.85rem;color:var(--muted)}.more-audio{display:block;width:fit-content;margin:.6rem 0 .3rem auto;color:var(--accent);font-size:.9rem}.service-credits{font-size:.85rem;color:var(--muted);text-align:right}.service-credits p{text-align:left;padding:.75rem 0}.service-credits summary{cursor:pointer}.service-offers{border-top:1px solid var(--rule);padding-top:1.25rem}.service-offers>header{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;margin-bottom:1rem}.services-page h2{font-size:2rem}.service-offers>header>p{font-size:.9rem;color:var(--muted)}.service-offer{border-top:1px solid var(--rule);scroll-margin-top:2rem}.service-offer:last-child{border-bottom:1px solid var(--rule)}.service-offer>summary{display:grid;grid-template-columns:1.3fr 1.2fr .65fr 24px;gap:1.5rem;align-items:center;list-style:none;cursor:pointer;padding:1rem .5rem}.service-offer>summary::-webkit-details-marker{display:none}.service-offer h3{font-size:1.4rem;line-height:1.2}.service-offer summary>p{font-size:.95rem;color:var(--muted)}.service-offer summary>span{font-size:1.25rem;white-space:nowrap}.service-offer summary>b{font-size:1.5rem;font-weight:400;color:var(--accent)}.service-offer[open] summary>b{transform:rotate(45deg)}.service-scope{max-width:70ch;margin-left:1rem;padding:.5rem 0 1.5rem;line-height:1.6}.service-scope p+p{margin-top:.75rem}.service-scope>details{margin:.7rem 0}.service-scope summary{cursor:pointer;color:var(--accent)}.service-custom h3,.service-custom summary>span{color:var(--muted);font-size:1.1rem}.service-before{display:grid;grid-template-columns:1fr 2fr;gap:2rem;margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--rule)}.service-before summary{display:flex;justify-content:space-between;padding:.7rem 0;border-block:1px solid var(--rule);cursor:pointer}.service-before summary span{color:var(--accent)}.service-before details p{line-height:1.55;margin:.85rem 0;max-width:65ch}.service-bottom{display:flex;gap:1rem;align-items:center;justify-content:space-between;margin-top:.8rem}.service-bottom>p{font-size:.95rem;color:var(--muted)}.service-bottom .site-button{flex-shrink:0}.other-services{font-size:.85rem;margin-top:1.5rem;color:var(--muted)}.service-no-example{padding:2rem 0;color:var(--muted)}
@media(max-width:800px){.services-hero{gap:1.5rem;grid-template-columns:1fr 1.1fr}.services-hero h1{font-size:3rem}.services-hero header>p{font-size:1.2rem}.service-listening-heading{display:block}.service-listening-heading p{margin-top:.3rem}.service-offer>summary{gap:1rem;grid-template-columns:1.5fr 1fr auto 20px}.service-offer h3{font-size:1.2rem}.service-bottom{align-items:start;flex-direction:column}}
@media(max-width:650px){.services-hero{grid-template-columns:1fr;padding-top:0}.services-hero h1{font-size:2.65rem}.services-hero header>p{font-size:1.2rem;margin:.7rem 0 1rem}.services-hero .site-button{width:100%}.service-listening-heading{display:flex;flex-wrap:wrap;gap:.3rem}.service-listening h2{font-size:1.65rem}.service-offers>header{display:block}.service-offers>header>p{margin-top:.3rem}.service-offer>summary{grid-template-columns:1fr auto 18px;gap:.3rem 1rem}.service-offer h3{font-size:1.1rem}.service-offer summary>p{grid-row:2;grid-column:1;font-size:.85rem}.service-offer summary>span{grid-column:2;grid-row:1/3;font-size:1rem}.service-offer summary>b{grid-column:3;grid-row:1/3}.service-before{grid-template-columns:1fr;gap:.8rem}.service-bottom .site-button{width:100%;justify-content:center}.service-scope{margin-left:0}}
</style>
