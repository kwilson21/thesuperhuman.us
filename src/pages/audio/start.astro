---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import AudioFooter from '~/components/audio/AudioFooter.astro';
import ArtistName from '~/components/ArtistName.astro';
import { audioOffers, directionFields, isAudioIntakeAvailable, type IntakeService } from '~/lib/audio-intake';
import '~/styles/audio-intake.css';
const requestedService = Astro.url.searchParams.get('service') ?? 'vocal-mix';
const selectedService = Object.hasOwn(audioOffers, requestedService) ? requestedService : 'vocal-mix';
const env = Astro.locals.runtime?.env;
const siteKey = env?.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const available = Boolean(siteKey && isAudioIntakeAvailable(env));
---
<BaseLayout title="Start your song · Kaz̄on" description="Choose your service, share your recording and send it to Kaz̄on for review. No payment before file approval.">
<article class="site-shell intake-page">
<ol class="intake-progress" aria-label="Your progress"><li aria-current="step"><span class="step-number">1</span> Service</li><li><span class="step-number">2</span> Song &amp; direction</li><li><span class="step-number">3</span> Review</li></ol>
<form id="song-intake" data-available={available} novalidate>
<noscript><p>Please enable JavaScript to use this form, or email <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>.</p></noscript>
<section data-step="0" aria-labelledby="step-one"><h1 id="step-one" tabindex="-1">What does your song need?</h1><p class="intake-intro">I’ll review your files before you book.</p><div class="intake-columns intake-service-columns">
<fieldset class="offer-list"><legend class="sr-only">Choose a service</legend>{Object.entries(audioOffers).map(([id, offer]) => <label class="intake-offer"><input type="radio" name="service" value={id} checked={id === selectedService} /><span><strong>{offer.name}</strong></span><b>{offer.price ? `From $${offer.price}` : 'By review'}</b></label>)}</fieldset>
<aside class="intake-service-detail"><h2 data-offer-name>{audioOffers['vocal-mix'].name}</h2><p data-offer-description>{audioOffers['vocal-mix'].description}</p><p data-offer-scope>{audioOffers['vocal-mix'].scope}</p><details><summary>What’s included &amp; what to send</summary><p>Clarity, balance and careful listening are always included. Your preferences guide the artistic choices.</p><p>Extra tracks, longer songs and extensive editing are quoted separately. A revision round is one consolidated set of notes within the agreed direction.</p></details><p class="intake-muted">Starting prices in USD. Final scope and price confirmed after listening.</p></aside></div>
</section>
<section data-step="1" aria-labelledby="step-two" hidden><h1 id="step-two" tabindex="-1">Shape your sound.</h1><p class="intake-intro">Give as much direction as you like. I’ll bring the engineering judgment.</p><div class="intake-columns intake-song-columns"><div class="intake-song">
<label class="intake-field" for="song-title"><span data-title-label>Song title (working title)</span><input id="song-title" name="title" maxlength="120" placeholder="Working title" required /></label><p data-form-error="title" hidden></p>
<div class="intake-files"><h2 data-files-heading>Beat + vocal tracks</h2><p data-files-needed>{audioOffers['vocal-mix'].files}</p><div class="intake-link-panel"><label class="intake-field" for="song-link">Drive, Dropbox or WeTransfer link<input id="song-link" name="fileLink" type="url" maxlength="2048" placeholder="https://" aria-describedby="file-help" /></label><p id="file-help" class="intake-muted">Enable viewing and downloading for anyone with the link. Check it in a private browser window. Send a folder or transfer link, not your password.</p><p data-form-error="fileLink" hidden></p></div><details><summary>File preparation help <span aria-hidden="true">→</span></summary><p data-preparation>{audioOffers['vocal-mix'].preparation}</p></details></div>
</div><div class="intake-direction"><fieldset class="direction-list"><legend>How much direction would you like to give?</legend><label><input type="radio" name="direction" value="judgment" checked /><span><strong>Use your judgment</strong><small>Find an approach that suits the song.</small></span></label><label><input type="radio" name="direction" value="preferences" /><span><strong>I have a few preferences</strong></span></label><label><input type="radio" name="direction" value="specific" /><span><strong>I have a specific direction</strong></span></label></fieldset>
<div class="intake-preferences" data-preferences hidden><h2>Creative preferences</h2>{Object.keys(audioOffers).map(service => <div data-service-preferences={service} hidden>{directionFields(service as IntakeService).map(field => <label class="intake-field" for={`pref-${service}-${field.id}`}>{field.label}<select aria-label={field.label} id={`pref-${service}-${field.id}`} name={`pref-${service}-${field.id}`} data-preference={field.id}><option value="decide">You decide</option>{field.options.map(option => <option value={option.value}>{option.label}</option>)}</select></label>)}{service === 'custom' && <p>Describe the creative direction in your project notes below.</p>}</div>)}</div><p data-form-error="preferences" hidden></p>
<label class="intake-field">Anything to preserve or avoid changing? (optional)<textarea name="preserve" maxlength="1200" rows="3" placeholder="Optional. ‘I’m not sure yet’ is welcome."></textarea></label><p data-form-error="preserve" hidden></p>
<details class="intake-references" data-reference-fields><summary data-reference-summary>Add a reference or note (optional)</summary><label class="intake-field">Reference link (optional)<input name="referenceUrl" type="url" maxlength="2048" placeholder="https://" /></label><p data-form-error="referenceUrl" hidden></p><label class="intake-field"><span data-note-label>Notes about your direction (optional)</span><textarea name="referenceNote" maxlength="2000" rows="3" placeholder="A feeling, a reference, a timestamp, or something you’re unsure about."></textarea></label><p data-form-error="referenceNote" hidden></p></details>
</div></div><p class="intake-footnote">You can leave some choices to me and specify others.</p>
</section>
<section data-step="2" aria-labelledby="step-three" hidden><h1 id="step-three" tabindex="-1">Does this sound right?</h1><p class="intake-intro">Check the details, then send your song for review.</p><div class="intake-columns intake-review-columns">
<div class="intake-review"><dl data-review></dl><div class="intake-edit"><button type="button" data-edit="0">Edit service</button><button type="button" data-edit="1">Edit song & direction</button></div></div>
<div class="intake-contact-fields"><div class="intake-pair"><label class="intake-field">Your name<input name="name" autocomplete="name" required maxlength="100" /></label><label class="intake-field">Email<input name="email" autocomplete="email" type="email" required maxlength="120" /></label></div><p data-form-error="name" hidden></p><p data-form-error="email" hidden></p>
<label class="intake-consent"><input type="checkbox" name="permission" required /><span>I have permission to share these files and allow <ArtistName /> to access them for this project review.</span></label><p data-form-error="permission" hidden></p>
{available ? <div class="cf-turnstile" data-sitekey={siteKey}></div> : <p class="intake-unavailable">This preview isn’t connected to email delivery yet. You can try every step; sending is unavailable.</p>}<p data-form-error="turnstileToken" hidden></p></div></div>
</section>
<p data-form-status role="status" tabindex="-1"></p>
<div class="intake-actions"><button type="button" data-back hidden>Back</button><button type="button" class="site-button" data-next>Continue</button><button type="submit" class="site-button" hidden disabled>Send for review</button></div><p class="intake-reassurance">No payment now. No commitment until you approve the offer.</p>
</form>
<section id="intake-success" hidden tabindex="-1" role="status"><h1>Your song is in for review.</h1><p class="intake-intro">You’ll hear from me by email.</p><ol class="intake-next-steps"><li>I’ll listen and check the files.</li><li>You’ll receive an offer or a request for clarification.</li><li>You approve the offer before paying a deposit.</li></ol><p>No payment taken. Nothing booked yet.</p></section>
<p class="intake-contact">Need a hand? <a href="mailto:kazon.wilson@thesuperhuman.us">Email me</a>.</p>
</article><AudioFooter slot="footer" />
{available && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
<script>import '~/scripts/audio-intake';</script>
</BaseLayout>
