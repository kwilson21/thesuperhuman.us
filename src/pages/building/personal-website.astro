---
export const prerender = false;
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectTimeline from '~/components/ProjectTimeline.astro';
import { websiteStory, websiteMilestones } from '~/data/project-stories/personal-website';
import { websitePages } from '~/data/project-stories/website-pages';
import before from '~/assets/projects/website/home-before.png';
import after from '~/assets/projects/website/home-after.png';
---
<ProjectLayout title={websiteStory.title} subtitle={websiteStory.subtitle} description={websiteStory.description} status="An ongoing design project" journalHref="#website-design-history-title">
  <section class="project-section" aria-labelledby="website-change">
    <div class="site-section-heading"><h2 id="website-change">Same palette. A different introduction.</h2></div>
    <div class="website-comparison">
      <figure><a href={before.src} aria-label="Open the original homepage capture"><img src={before.src} width={before.width} height={before.height} alt="Original homepage: a contract availability line, engineering introduction and portrait." /></a><figcaption><strong>Before</strong><p>The original homepage, captured during the September 9 audit.</p></figcaption></figure>
      <figure><a href={after.src} aria-label="Open the redesigned homepage capture"><img src={after.src} width={after.width} height={after.height} alt="Redesigned homepage: shared navigation, a short personal introduction and a quiet studio illustration." /></a><figcaption><strong>Taking shape</strong><p>The local redesign, September 10. Studio artwork is illustrative.</p></figcaption></figure>
    </div>
    <nav class="site-links journey-links" aria-label="Explore the redesign"><a class="site-link" href="#website-design-history-title">Follow the design journey <span aria-hidden="true">↓</span></a><a class="site-link" href="#website-page-comparisons">Compare the pages <span aria-hidden="true">↓</span></a></nav>
  </section>
  <p class="history-note">The intention behind each step, alongside the studies and revisions that followed. These are historical design options: generated wording, equipment and interfaces are part of the studies, not finished copy or product evidence. Open any image to inspect the full page.</p>
  <ProjectTimeline id="website-design-history" title="How the design took shape" entries={websiteMilestones} selectedId="website-start-with-the-reader" />
  <section class="project-section page-comparisons" id="website-page-comparisons" aria-labelledby="page-comparisons-title">
    <div class="site-section-heading"><h2 id="page-comparisons-title">What changed, page by page.</h2></div>
    <p class="comparison-intro">Actual pages: the public site before launch and the local redesign, captured September 10. Choose a page, then open either capture to see it in full.</p>
    {websitePages.map(page => <details class="page-comparison" name="website-pages"><summary><span>{page.name}</span><span class="comparison-change">{page.change}</span><span aria-hidden="true">+</span></summary><div class="page-comparison-body"><p>{page.description}</p><div class="website-comparison">{[{label:'Before',image:page.before},{label:'Local redesign',image:page.after}].map(({label,image}) => <figure><a href={image.src}><img src={image.src} width={image.width} height={image.height} alt={`${page.name}, ${label.toLowerCase()}. Full-page capture.`} loading="lazy" /><span class="capture-open">Open full {label === 'Before' ? 'before' : 'redesign'} capture <span aria-hidden="true">↗</span></span></a><figcaption><strong>{label}</strong></figcaption></figure>)}</div>{page.extra && <p class="new-page-link">A new destination: <a class="site-link" href={page.extra.src}>See the Writing index <span aria-hidden="true">↗</span></a></p>}</div></details>)}
  </section>
  <section class="project-section"><div class="site-section-heading"><h2>Still taking shape.</h2></div><p>The site is being reviewed before launch. The next part of the story comes from using it, seeing what people understand, and deciding what needs another pass.</p><a class="site-link website-writing-link" href="/writing#website-redesign">Follow the writing topic <span aria-hidden="true">→</span></a></section>
</ProjectLayout>
<style>
  .website-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 2rem; }
  figure { margin: 0; min-width: 0; } figure a { display: block; border: 1px solid var(--rule); padding: 0; } figure img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 1rem; font-size: .95rem; line-height: 1.6; } figcaption strong { font-weight: 500; } figcaption p, .history-note, .comparison-intro { color: var(--muted); }
  .history-note { margin-top: 3rem; max-width: 70ch; font-size: .9rem; line-height: 1.6; }.journey-links { margin-top: 2rem; }
  .website-writing-link { margin-top: 1.5rem; }.page-comparisons { scroll-margin-top: 2rem; }.comparison-intro { max-width: 65ch; line-height: 1.6; margin-bottom: 2rem; }
  .page-comparison { border-top: 1px solid var(--rule); } .page-comparison:last-child { border-bottom: 1px solid var(--rule); }.page-comparison > summary { display: grid; grid-template-columns: 7rem 1fr auto; gap: 1rem; align-items: baseline; padding-block: 1.4rem; cursor: pointer; list-style: none; font-size: 1.6rem; }.page-comparison > summary::-webkit-details-marker { display: none; }.comparison-change { font-size: 1.1rem; color: var(--muted); }.page-comparison-body { padding-bottom: 2rem; }.page-comparison-body > p { max-width: 65ch; font-size: 1.15rem; line-height: 1.6; }.page-comparison img { aspect-ratio: 4 / 3; object-fit: cover; object-position: top; }.capture-open { display: flex; justify-content: space-between; border-top: 1px solid var(--rule); padding: .8rem 1rem; font: .75rem/1.5 Inter,sans-serif; }.new-page-link { margin-top: 2rem; }
  @media (max-width: 700px) { .website-comparison { grid-template-columns: 1fr; gap: 2rem; }.page-comparison > summary { grid-template-columns: 1fr auto; gap: .4rem; }.comparison-change { grid-column: 1; grid-row: 2; }.page-comparison > summary > span:last-child { grid-column: 2; grid-row: 1 / 3; } }
</style>
