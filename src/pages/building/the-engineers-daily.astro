---
export const prerender = false;
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import notebook from '~/assets/site/notebook-v1.webp';
import preview from '~/assets/projects/daily-preview.webp';
import ProjectUpdates from '~/components/ProjectUpdates.astro';
import { websiteFeed } from '~/lib/publication/website';
import story from '~/data/project-stories/the-engineers-daily.json';
const feed = await websiteFeed(Astro.locals.runtime.env, story.projectId);
const asset = (file: string) => `/building/${story.projectId}/${file}`;
const latest = story.stages.at(-1)!.artifacts[0];
// This optimized copy belongs only to this captured lesson, not future milestones.
const latestSrc = latest.file === 'lesson-prototype.png' ? preview.src : asset(latest.file);
const entries = story.stages.map(stage => ({ id:stage.id, day:stage.day, title:stage.title, summary:stage.summary, detail:stage.decision, artifacts:stage.artifacts.map(image => ({ ...image, src:asset(image.file) })) }));
Astro.response.headers.set('Cache-Control', 'no-store');
---
<ProjectLayout title={story.title} subtitle={story.subtitle} description="Engineering practice alongside Scripture, prayer and reflection. For people who already code." status={story.status} journalHref="#the-engineers-daily-updates-title" ogImage={asset(story.cover)}>
  <figure class="project-current">
    <a href={asset(latest.file)} aria-label="Open the current lesson prototype screenshot at full size"><img src={latestSrc} alt={latest.alt} width={latest.width} height={latest.height} fetchpriority="high" /></a>
    <figcaption>{latest.caption}</figcaption>
  </figure>
  <section class="project-section" aria-labelledby="daily-idea">
    <div class="site-section-heading"><h2 id="daily-idea">Behind the idea</h2></div>
    <div class="project-pair">
      <div><h3>A practice I want to return to.</h3><p>I’m designing the daily ritual I want to use myself. One meaningful change, with space for reflection.</p><h3>Let the work shape the story.</h3><p>Over a series, your changes grow a real application and matter to the unfolding life of a fantasy harbor.</p></div>
      <figure><img src={notebook.src} alt="An open notebook with a sketched path through a landscape." width={notebook.width} height={notebook.height} loading="lazy" /><figcaption class="project-caption">Illustration</figcaption></figure>
    </div>
  </section>
  <section class="project-section" aria-labelledby="daily-state">
    <div class="site-section-heading"><h2 id="daily-state">Where it stands</h2></div>
    <div class="project-state">
      <div><p class="page-kicker">Today</p><p>{story.current}</p></div>
      <div><p class="page-kicker">Still to build</p><p>Code execution and saved progress.</p></div>
      <div><p class="page-kicker">Next</p><p>{story.next}</p></div>
    </div>
  </section>
  <span id="design-history-title" aria-hidden="true"></span>
  <p class="project-note">I direct the product and choose the direction, with AI assistance for exploration and implementation. Concepts are visual studies, not working features. Dates record the supported day, not time spent.</p>
  <ProjectUpdates feed={feed} projectId={story.projectId} milestones={entries} />
</ProjectLayout>
