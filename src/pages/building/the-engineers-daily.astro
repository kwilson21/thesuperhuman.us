---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import ProjectTimeline from '~/components/ProjectTimeline.astro';
import ProjectUpdates from '~/components/ProjectUpdates.astro';
import StoryFlow from '~/components/StoryFlow.astro';
import { websiteFeed } from '~/lib/publication/website';
import story from '~/data/project-stories/the-engineers-daily.json';
import '~/styles/project-journal.css';
const feed = await websiteFeed(Astro.locals.runtime.env, story.projectId);
const asset = (file: string) => `/building/${story.projectId}/${file}`;
const latest = story.stages.at(-1)!.artifacts[0];
const entries = story.stages.map(stage => ({ id:stage.id, day:stage.day, title:stage.title, summary:stage.summary, detail:stage.decision, artifacts:stage.artifacts.map(image => ({ ...image, src:asset(image.file) })) }));
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout title={`${story.title} · Project journal · Kazon Wilson`} description={story.subtitle} ogImage={asset(story.cover)}>
  <div class="project-shell">
    <nav class="project-nav" aria-label="Project navigation"><a href="/">Kazon Wilson</a><a href="/building">All projects</a></nav>
    <header class="project-intro"><p class="eyebrow">Project journal · Design & development</p><h1>{story.title}</h1><p class="lead">{story.subtitle}</p><p>A real application, built one lesson at a time. Your engineering changes shape a fantasy harbor, alongside Scripture, prayer and reflection.</p><p class="project-note">For people who already code. I’m building the daily practice I want to use myself.</p></header>
    <figure class="project-current"><a href={asset(latest.file)} aria-label="Open the current lesson prototype screenshot"><img src={asset(latest.file)} alt={latest.alt} width={latest.width} height={latest.height} fetchpriority="high" /></a><figcaption><strong>Where it is now · September 9, 2026.</strong> {latest.caption}</figcaption></figure>
    <StoryFlow title="A little work. A reason to return." description="The goal is a connected series: each day grows the same application and gives the work a place in the story." steps={[
      { label:'Meet a need', visual:'◯ → ?', caption:'Arrive in the harbor. Find the problem today’s lesson asks you to solve.' },
      { label:'Change the application', visual:'{ + }', caption:'Practice a real engineering principle through a small coding task.' },
      { label:'Reflect, then return', visual:'✓ → ◯', caption:'Pause for reflection. Come back to grow the same application.' }
    ]} />
    <p class="project-next"><strong>Next:</strong> {story.next}</p>
    <ProjectTimeline id="design-history" title="From the first sketch to a lesson" entries={entries} />
    <p class="project-note">I direct the product and choose the direction, with AI assistance for exploration and implementation. Concepts are visual studies, not working features. Dates record the supported day, not time spent.</p>
    <ProjectUpdates feed={feed} projectId={story.projectId} title="Development milestones" />
  </div><Footer slot="footer" />
</BaseLayout>
