---
export const prerender = false;
import ProjectLayout from '~/layouts/ProjectLayout.astro';
import ProjectUpdates from '~/components/ProjectUpdates.astro';
import { websiteFeed } from '~/lib/publication/website';
import { websiteStory, websiteMilestones } from '~/data/project-stories/personal-website';
const feed = await websiteFeed(Astro.locals.runtime.env, 'personal-website');
Astro.response.headers.set('Cache-Control', 'no-store');
---
<ProjectLayout
  title={websiteStory.title}
  subtitle="Earlier updates to the site, newest first."
  description="Updates that have moved off the main project page, newest first."
  status={websiteStory.status}
  journalHref="/building/personal-website#personal-website-updates-title"
  pageTitle={`${websiteStory.title} · Archive · Kazon Wilson`}
  crumbHref="/building/personal-website"
>
  <ProjectUpdates feed={feed} projectId="personal-website" title="Archive" milestones={websiteMilestones} view="archive" />
  <p class="journal-crosslink"><a class="site-link" href="/building/personal-website/story">View project story <span aria-hidden="true">→</span></a></p>
</ProjectLayout>
<style>
  .journal-crosslink { margin-top: 1rem; }
</style>
