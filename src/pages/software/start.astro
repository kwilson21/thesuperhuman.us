---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import { mainSitePath } from '~/lib/host-routing';
import { softwareLabels, softwarePaths, timingLabels, budgetLabels, approverLabels } from '~/lib/software-inquiry';
import '~/styles/audio-intake.css';
import '~/styles/software-intake.css';
const env = Astro.locals.runtime?.env;
const siteKey = env?.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const available = Boolean(siteKey && env?.MUSIC_DB && env.TURNSTILE_SECRET_KEY && env.RATE_LIMIT);
const requested = Astro.url.searchParams.get('path');
const selected = requested === 'idea' || requested === 'workflow' ? requested : null;
const questions = {
  workflow: [
    ['today', 'Walk me through it as it works now: who does it, how often, and where it gets stuck.', 'For example: Every Monday our ops lead copies orders from three supplier emails into a spreadsheet. It takes about two hours and mistakes slip through.', 2000],
    ['audience', 'The people who’d use it, and roughly how many.', 'For example: Four people on our operations team, plus the manager who reads the weekly report.', 1000],
    ['firstResult', 'Something small you could try within a few weeks.', 'For example: Orders from all three suppliers land in one list each morning, with anything unusual flagged.', 2000],
  ],
  idea: [
    ['idea', 'In a sentence or two, as you’d explain it to a friend.', 'For example: An app that lets food bank volunteers pick their own shifts, so coordinators stop juggling group texts.', 1000],
    ['audienceToday', 'Real people you could put it in front of, and how they manage without it.', 'For example: About 30 volunteers and two coordinators. Today they sign up over group texts and a shared spreadsheet.', 1000],
    ['firstVersion', 'Pick the single most important action. Everything else can wait.', 'For example: Let a volunteer see open shifts for the next two weeks and claim one.', 1000],
    ['signal', 'What would you see after a few weeks of real use?', 'For example: Most volunteers use it for a month without going back to texts.', 500],
  ],
} as const;
const href = (path: string) => mainSitePath(Astro.request.headers.get('host') ?? Astro.url.host, path);
---
<BaseLayout title="Start a software project · Kazon Wilson" description="Share a short software project brief for Kazon Wilson to review.">
  <article class="site-shell intake-page software-intake">
    <p class="intake-return"><a class="site-link" href={href('/services#software')}>Back to Software <span aria-hidden="true">←</span></a></p>
    <ol class="intake-progress" aria-label="Your progress"><li aria-current="step"><span class="step-number">1</span> Project</li><li><span class="step-number">2</span> Details</li><li><span class="step-number">3</span> Review</li></ol>
    <form id="software-inquiry" data-available={available} novalidate>
      <noscript><p>Please enable JavaScript to use this form, or email <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>.</p></noscript>
      <section data-step="0" aria-labelledby="software-step-one">
        <h1 id="software-step-one" tabindex="-1">What are you working on?</h1>
        <p class="intake-intro">Start with the problem or the idea.</p>
        <p class="intake-muted software-step-help">A few sentences per question is plenty. Specific examples help most.</p>
        <div class="intake-columns intake-service-columns">
          <fieldset class="offer-list"><legend class="sr-only">Choose a starting point</legend>
            {Object.entries(softwarePaths).map(([key, value]) => <label class="intake-offer"><input type="radio" name="path" value={key} checked={selected === key} /><span><strong>{value}</strong><small>{key === 'workflow' ? 'A focused tool, automation or integration for a task your team repeats.' : 'A first version people can try to help you decide what to build next.'}</small></span></label>)}
            <p data-form-error="path" hidden></p>
          </fieldset>
          <div>
            <p class="intake-muted" data-choose-path hidden={selected !== null}>Choose a starting point to see its questions.</p>
            {Object.entries(questions).map(([path, items]) => <div data-questions={path} hidden={selected !== path}>
              {path === 'idea' && <p class="software-idea-note">I build a first version people can try, not the whole product. These questions help us find the part worth testing first.</p>}
              {items.map(([key, hint, example, max]) => <div><div class="intake-field">
                <label for={`software-${key}`}>{softwareLabels[key]}</label>
                <p id={`software-${key}-help`} class="intake-muted software-question-help">{hint}</p>
                <textarea id={`software-${key}`} name={key} aria-describedby={`software-${key}-help`} placeholder={example} maxlength={max} rows="4" required={key !== 'signal'} disabled={selected !== path}></textarea>
                </div>
                <p data-form-error={key} hidden></p>
              </div>)}
            </div>)}
            <p class="intake-footnote">Plain language is fine. We’ll work out the technical details together. Please leave out passwords, access details and real customer data.</p>
          </div>
        </div>
      </section>
      <section data-step="1" aria-labelledby="software-step-two" hidden>
        <h1 id="software-step-two" tabindex="-1">A few practical details.</h1><p class="intake-intro">Tell me how to reach you and where the decision stands.</p>
        <div class="intake-columns intake-review-columns"><div class="intake-contact-fields">
          <div class="intake-pair"><label class="intake-field" for="software-name">Your name<input id="software-name" name="name" autocomplete="name" maxlength="100" required /></label><label class="intake-field" for="software-email">Email<input id="software-email" name="email" type="email" autocomplete="email" maxlength="120" required /></label></div><p data-form-error="name" hidden></p><p data-form-error="email" hidden></p>
          <label class="intake-field" for="software-company">{softwareLabels.company}<input id="software-company" name="company" autocomplete="organization" maxlength="120" /></label><p data-form-error="company" hidden></p>
          <label class="intake-field" for="software-timing">Timing<select id="software-timing" name="timing" required><option value="">Choose one</option>{Object.entries(timingLabels).map(([key, value]) => <option value={key}>{value}</option>)}</select></label><p data-form-error="timing" hidden></p>
          <label class="intake-field" for="software-timing-reason">{softwareLabels.timingReason}<input id="software-timing-reason" name="timingReason" maxlength="500" /></label><p data-form-error="timingReason" hidden></p>
        </div><div>
          <label class="intake-field" for="software-budget">Budget status<select id="software-budget" name="budgetStatus" aria-describedby="software-budget-help" required><option value="">Choose one</option>{Object.entries(budgetLabels).map(([key, value]) => <option value={key}>{value}</option>)}</select></label><p id="software-budget-help" class="intake-muted">Choose the closest status. A fixed price is agreed later, in writing.</p><p data-form-error="budgetStatus" hidden></p>
          <label class="intake-field" for="software-budget-note">{softwareLabels.budgetNote}<input id="software-budget-note" name="budgetNote" aria-describedby="software-budget-note-help" maxlength="200" /></label><p id="software-budget-note-help" class="intake-muted">Private. A figure or range is fine.</p><p data-form-error="budgetNote" hidden></p>
          <label class="intake-field" for="software-approver">{softwareLabels.approver}<select id="software-approver" name="approver" required><option value="">Choose one</option>{Object.entries(approverLabels).map(([key, value]) => <option value={key}>{value}</option>)}</select></label><p data-form-error="approver" hidden></p>
          <div data-approver-role hidden><label class="intake-field" for="software-approver-role">{softwareLabels.approverRole}<input id="software-approver-role" name="approverRole" maxlength="120" /></label><p data-form-error="approverRole" hidden></p></div>
        </div></div>
      </section>
      <section data-step="2" aria-labelledby="software-step-three" hidden><h1 id="software-step-three" tabindex="-1">Here’s your project brief.</h1><p class="intake-intro">Check every answer before sending.</p>
        <div class="intake-columns intake-review-columns"><div class="intake-review"><dl data-review></dl><div class="intake-edit"><button type="button" data-edit="0">Edit project</button><button type="button" data-edit="1">Edit details</button></div></div>
          <div class="intake-service-detail"><h2>What happens next?</h2><p>I’ll read your brief and reply by email with a question, a proposed first milestone, or a note if it isn’t a fit. Sending it doesn’t book work or commit you to anything. No payment now.</p>
            {available ? <div class="cf-turnstile" data-sitekey={siteKey}></div> : <p class="intake-unavailable">This preview isn’t connected to delivery yet. You can try every step; sending is unavailable.</p>}<p data-form-error="turnstileToken" hidden></p>
          </div></div>
      </section>
      <p data-form-status role="status" tabindex="-1"></p>
      <div class="intake-actions"><button type="button" data-back hidden>Back</button><button type="button" class="site-button" data-next>Continue</button><button type="submit" class="site-button" hidden disabled>Send project brief</button></div>
      <p class="intake-reassurance" data-send-reassurance hidden>No booking or payment at this stage.</p>
    </form>
    <section id="software-success" hidden tabindex="-1" role="status">
      <p class="intake-muted">Software brief · sent</p><h1>Your brief is in.</h1><p class="intake-intro" data-receipt-thanks></p>
      <ol class="max-w-content">
        <li>I reply with a fixed-price first milestone, or a question or two.</li>
        <li>If it looks right, you sign the agreement online. It takes about two minutes.</li>
        <li>Work starts, and you follow it on your own private project page.</li>
      </ol>
      <div class="intake-service-detail max-w-content"><p data-copy-status></p><p data-copy-note>It has everything you wrote, so you don't need to save this page.</p></div>
    </section>
    <p class="intake-contact">Not sure it fits? <a href={href('/#contact')}>Get in touch</a>. Hiring for a role? <a href={href('/about#resumes')}>Request my resume</a>.</p>
  </article>
  <Footer compact slot="footer" />
  {available && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
  <script>import '~/scripts/software-inquiry';</script>
</BaseLayout>
