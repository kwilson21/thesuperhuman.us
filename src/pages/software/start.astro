---
export const prerender = false;
import BaseLayout from '~/layouts/BaseLayout.astro';
import Footer from '~/components/Footer.astro';
import { mainSitePath } from '~/lib/host-routing';
import { softwarePaths } from '~/lib/software-inquiry';
import '~/styles/audio-intake.css';
import '~/styles/software-intake.css';
const env = Astro.locals.runtime?.env;
const siteKey = env?.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const available = Boolean(siteKey && env?.MUSIC_DB && env.TURNSTILE_SECRET_KEY && env.RATE_LIMIT);
const requested = Astro.url.searchParams.get('path');
const selected = requested === 'idea' || requested === 'workflow' ? requested : null;
const href = (path: string) => mainSitePath(Astro.request.headers.get('host') ?? Astro.url.host, path);
---
<BaseLayout title="Start a software project · Kazon Wilson" description="Share a short software project brief for Kazon Wilson to review.">
  <article class="site-shell intake-page software-intake">
    <p class="intake-return"><a class="site-link" href={href('/services#software')}>Back to Software <span aria-hidden="true">←</span></a></p>
    <p class="intake-muted">Software brief</p>
    <ol data-intake-progress class="intake-progress brief-dots" aria-label="Your progress">{Array.from({ length: 7 }, (_, i) => <li aria-current={i === 0 ? 'step' : undefined}><span class="step-number"><span class="sr-only">Question {i + 1} of 7</span></span></li>)}</ol>
    <form id="software-inquiry" data-available={available} data-suggestion-sitekey={siteKey} novalidate>
      <noscript><p>Please enable JavaScript to use this form, or email <a href="mailto:kazon.wilson@thesuperhuman.us">kazon.wilson@thesuperhuman.us</a>.</p></noscript>
      <section data-step="0">
        <h1 tabindex="-1">What are you working on?</h1>
        <fieldset class="offer-list"><legend class="sr-only">Choose a starting point</legend>
          {Object.keys(softwarePaths).map(key => <label class="intake-offer"><input type="radio" name="path" value={key} checked={selected === key} /><span><strong>{key === 'workflow' ? 'A workflow that should be easier' : 'An idea to bring to life'}</strong></span></label>)}
        </fieldset><p data-form-error="path" hidden></p>
      </section>
      {[1, 2].map(index => <section data-step={index} hidden>
        <h1 tabindex="-1" data-question-title></h1>
        <p class="intake-intro" data-question-hint></p>
        <p class="intake-footnote">Plain language is fine. We’ll work out the technical details together. Please leave out passwords, access details and real customer data.</p>
        <div class="intake-field brief-answer">
          <label class="sr-only" for={`brief-answer-${index}`} data-answer-label></label>
          <div class="brief-ghost" aria-hidden="true"><span data-ghost-prefix></span><span data-ghost-text></span></div>
          <textarea id={`brief-answer-${index}`} rows="6" data-answer aria-describedby={`brief-help-${index}`} required={index === 1}></textarea>
        </div>
        <div id={`brief-help-${index}`}>
          <p class="intake-muted" data-accept-hint hidden></p>
          <button type="button" class="sr-only" data-accept hidden></button>
          <p class="intake-muted"><span data-suggestions-disclosure>Suggestions come from Cloudflare's AI, which sees only what you type in the answer boxes. <a href={href('/privacy#software-briefs')}>Privacy</a> · </span><span data-suggestions-off hidden>Suggestions are off. </span><button type="button" data-suggestions-toggle>Turn off</button></p>
        </div>
        <p data-form-error={index === 1 ? 'today' : 'firstResult'} hidden></p>
        <button type="button" data-skip hidden={index !== 2}>Skip</button>
      </section>)}
      <section data-step="3" hidden>
        <h1 tabindex="-1">When do you need it?</h1>
        <fieldset class="offer-list"><legend class="sr-only">Timing</legend>
          {[['flexible', 'Flexible'], ['date', 'By a date'], ['asap', 'As soon as possible']].map(([key, label]) => <label class="intake-offer"><input type="radio" name="timing" value={key} checked={key === 'flexible'} /><span>{label}</span></label>)}
        </fieldset>
        <label class="intake-field" data-date-field hidden>Needed by<input type="date" name="timingDate" /></label>
        <p data-form-error="timingDate" hidden></p>
      </section>
      <section data-step="4" hidden>
        <h1 tabindex="-1">Is there a budget you'd like to share?</h1>
        <p class="intake-intro">Only if it helps. I'll quote a fixed price either way.</p>
        <label class="intake-field">Amount (optional)<input name="budgetNote" type="number" min="0" step="0.01" inputmode="decimal" /></label>
        <p data-form-error="budgetNote" hidden></p><button type="button" data-skip>Skip</button>
      </section>
      <section data-step="5" hidden>
        <h1 tabindex="-1">Who should I reply to?</h1>
        <label class="intake-field">Name<input name="name" autocomplete="name" maxlength="100" required /></label><p data-form-error="name" hidden></p>
        <label class="intake-field">Email<input name="email" type="email" autocomplete="email" maxlength="120" required /></label><p data-form-error="email" hidden></p>
        <label class="intake-field">Company, if you have one<input name="company" autocomplete="organization" maxlength="120" /></label><p data-form-error="company" hidden></p>
      </section>
      <section data-step="6" hidden>
        <h1 tabindex="-1">Ready to send?</h1>
        <div class="intake-review"><dl data-review></dl></div>
        {available ? <div class="cf-turnstile" data-sitekey={siteKey}></div> : <p class="intake-unavailable">This preview isn't connected to delivery yet. You can try every step; sending is unavailable.</p>}
        <p data-form-error="turnstileToken" hidden></p>
      </section>
      <p data-form-status role="status" tabindex="-1"></p>
      <div class="intake-actions"><button type="button" data-back hidden>Back</button><button type="button" class="site-button" data-next>Next</button><button type="submit" class="site-button" hidden disabled>Send brief</button></div>
      <p class="intake-reassurance" data-send-reassurance hidden>No booking or payment at this stage.</p>
    </form>
    <section id="software-success" hidden tabindex="-1" role="status">
      <p class="intake-muted">Software brief · sent</p><h1>Your brief is in.</h1><p class="intake-intro" data-receipt-thanks></p>
      <div class="intake-link-panel max-w-content" data-copy-card>
        <span data-copy-icon class="block text-accent" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" ><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg></span>
        <p data-copy-status></p><p class="intake-muted" data-copy-note>It has everything you wrote, so you don't need to save this page.</p>
      </div>
      <ol class="intake-next-steps max-w-content">
        <li>I reply with a fixed-price first milestone, or a question or two.</li>
        <li>If it looks right, you sign the agreement online. It takes about two minutes.</li>
        <li>Work starts, and you follow it on your own private project page.</li>
      </ol>
    </section>
    <p class="intake-contact">Not sure it fits? <a href={href('/#contact')}>Get in touch</a>. Hiring for a role? <a href={href('/about#resumes')}>Request my resume</a>.</p>
  </article>
  <Footer compact slot="footer" />
  {available && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>}
  <script>import '~/scripts/software-inquiry';</script>
</BaseLayout>
