# Worker responses get these four headers from src/lib/security-headers.ts; a test fails if the lists differ.
/*
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Link-preview posters and videos carry a content hash in their names (scripts/og-video/render.mjs).
/og/*
  Cache-Control: public, max-age=31536000, immutable

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow
