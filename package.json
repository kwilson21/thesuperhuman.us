{
  "name": "thesuperhuman-us",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "prebuild": "pnpm run assets:check && pnpm run copy:check && pnpm run design:check && pnpm run publicist:gate",
    "assets:check": "node scripts/check-asset-qa.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "design:check": "node scripts/check-design.mjs",
    "publicist:gate": "node scripts/publicist/gate.mjs",
    "publicist:sync": "node scripts/publicist/sync.mjs",
    "preview": "wrangler dev --local",
    "check": "astro check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:quint": "node scripts/verify-quint.mjs",
    "verify:quint:mutants": "node scripts/verify-quint.mjs mutants",
    "verify:quint:exhaustive": "node scripts/verify-quint.mjs exhaustive",
    "verify:dafny": "lsc check --backend=dafny",
    "golden:diff": "node scripts/golden-diff.mjs diff",
    "golden:show": "node scripts/golden-diff.mjs show",
    "screenshots:preview": "node scripts/screenshots/preview.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "audio:upload": "node scripts/upload-audio.mjs",
    "music:prepare": "node scripts/prepare-music.mjs",
    "music:preview:setup": "node scripts/music-preview.mjs",
    "music:upload": "node scripts/upload-music.mjs",
    "music:report": "node scripts/music-report.mjs",
    "owner:retention:preview": "node scripts/owner-retention.mjs",
    "owner:retention:apply": "node scripts/owner-retention.mjs --apply .private/owner-retention-review.json",
    "studio:retention:preview": "node scripts/studio-retention.mjs",
    "studio:retention:apply": "node scripts/studio-retention.mjs --apply .private/studio-retention-review.json",
    "owner:health": "node scripts/owner-health.mjs",
    "owner:stripe:reconcile": "node scripts/stripe-reconciliation.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^12.5.0",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@xstate/effect": "1.0.0-alpha.12",
    "astro": "^5.1.0",
    "effect": "4.1.4",
    "jose": "^6.2.17",
    "pdf-lib": "^1.17.1",
    "resend": "^4.0.1",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "xstate": "6.0.0-beta.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/compiler": "2.13.1",
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@informalsystems/quint": "0.33.1",
    "@oxlint/plugins": "1.93.0",
    "esbuild": "0.28.2",
    "lemmascript": "0.6.6",
    "oxlint": "1.93.0",
    "parse5": "7.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "vitest": "^5.1.0",
    "wrangler": "4.146.0"
  }
}
